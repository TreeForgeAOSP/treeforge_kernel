        " ".join(
            str(value)
            for value in command
        )
    )

    print()
    print("BUILD STARTED: YES")
    print()

    result = None

    try:
        result = subprocess.run(
            [
                str(value)
                for value in command
            ],
            cwd=ROOT,
            env=env,
            text=True,
        )

    finally:
        #
        # Profile source is build-temporary state.
        #
        # Always restore it after the actual Bazel process
        # exits, regardless of success, failure, exception,
        # or user interruption.
        #
        print()
        print("Restoring selected build profile")
