#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_RELEASE = "android-15.0.0_r0.94"
DEFAULT_CACHE_ROOT = (
    Path.home()
    / ".cache"
    / "treeforge"
    / "providers"
    / "kernel"
)


class ProviderError(RuntimeError):
    pass


def run(
    args: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        args,
        cwd=cwd,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )

    if check and result.returncode != 0:
        raise ProviderError(
            f"command failed ({result.returncode}): "
            f"{' '.join(args)}\n{result.stdout}"
        )

    return result


def load_manifest(release: str) -> tuple[Path, dict]:
    path = (
        ROOT
        / "manifests"
        / "kernel"
        / release
        / "google-providers.json"
    )

    if not path.is_file():
        raise ProviderError(
            f"kernel provider manifest does not exist: {path}"
        )

    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ProviderError(
            f"invalid provider manifest {path}: {exc}"
        ) from exc

    if data.get("schema") != 1:
        raise ProviderError(
            f"unsupported provider manifest schema: "
            f"{data.get('schema')!r}"
        )

    if data.get("platform_release") != release:
        raise ProviderError(
            "provider manifest release identity mismatch"
        )

    providers = data.get("providers")

    if not isinstance(providers, dict) or not providers:
        raise ProviderError(
            "provider manifest contains no providers"
        )

    return path, data


def cache_path(
    *,
    cache_root: Path,
    release: str,
    provider_name: str,
) -> Path:
    return (
        cache_root.expanduser().resolve()
        / release
        / provider_name
    )


def git_head(path: Path) -> str | None:
    if not (path / ".git").exists():
        return None

    result = run(
        ["git", "-C", str(path), "rev-parse", "HEAD"],
        check=False,
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def git_status(path: Path) -> str | None:
    result = run(
        ["git", "-C", str(path), "status", "--porcelain"],
        check=False,
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def provider_state(
    *,
    cache_root: Path,
    release: str,
    name: str,
    provider: dict,
) -> tuple[str, str]:
    destination = cache_path(
        cache_root=cache_root,
        release=release,
        provider_name=name,
    )

    expected = provider["revision"]

    if not destination.exists():
        return "MISSING", str(destination)

    head = git_head(destination)

    if head is None:
        return "INVALID", "not a Git checkout"

    if head != expected:
        return (
            "WRONG_REVISION",
            f"expected={expected} actual={head}",
        )

    status = git_status(destination)

    if status is None:
        return "INVALID", "unable to inspect Git status"

    if status:
        return "DIRTY", status.replace("\n", "; ")

    return "READY", head


def select_names(
    providers: dict,
    requested: list[str],
) -> list[str]:
    if not requested or requested == ["all"]:
        return list(providers)

    unknown = [
        name
        for name in requested
        if name not in providers
    ]

    if unknown:
        raise ProviderError(
            "unknown kernel provider(s): "
            + ", ".join(unknown)
        )

    return requested


def print_status(
    *,
    manifest: Path,
    release: str,
    cache_root: Path,
    providers: dict,
) -> int:
    print("TreeForge Kernel Providers")
    print()
    print(f"Manifest: {manifest}")
    print(f"Release:  {release}")
    print(f"Cache:    {cache_root.expanduser().resolve()}")
    print()

    ready = 0

    for name, provider in providers.items():
        state, detail = provider_state(
            cache_root=cache_root,
            release=release,
            name=name,
            provider=provider,
        )

        if state == "READY":
            ready += 1

        print(
            f"{name:24s} "
            f"{state:14s} "
            f"{detail}"
        )

    print()
    print(f"Ready: {ready}/{len(providers)}")

    return 0


def reject_lfs_configuration(path: Path) -> None:
    attrs = path / ".gitattributes"

    if not attrs.is_file():
        return

    text = attrs.read_text(
        encoding="utf-8",
        errors="replace",
    )

    if "filter=lfs" in text:
        raise ProviderError(
            f"provider unexpectedly declares Git LFS: {path}"
        )


def fetch_one(
    *,
    cache_root: Path,
    release: str,
    name: str,
    provider: dict,
) -> None:
    destination = cache_path(
        cache_root=cache_root,
        release=release,
        provider_name=name,
    )

    state, detail = provider_state(
        cache_root=cache_root,
        release=release,
        name=name,
        provider=provider,
    )

    if state == "READY":
        print(f"{name}: cached ✓")
        return

    if destination.exists():
        raise ProviderError(
            f"{name}: cache exists but is not usable "
            f"({state}: {detail}); refusing to overwrite "
            f"{destination}"
        )

    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary = destination.parent / (
        f".{destination.name}.partial-{os.getpid()}"
    )

    if temporary.exists():
        shutil.rmtree(temporary)

    url = provider["url"]
    revision = provider["revision"]

    env = os.environ.copy()

    # TreeForge kernel providers must never require Git LFS.
    # This also prevents an installed git-lfs from smudging objects
    # implicitly if an upstream repository changes unexpectedly.
    env["GIT_LFS_SKIP_SMUDGE"] = "1"

    print(f"{name}: fetching")
    print(f"  source:   {url}")
    print(f"  revision: {revision}")

    try:
        temporary.mkdir(parents=True)

        run(
            ["git", "init", "-q"],
            cwd=temporary,
            env=env,
        )

        run(
            [
                "git",
                "remote",
                "add",
                "origin",
                url,
            ],
            cwd=temporary,
            env=env,
        )

        run(
            [
                "git",
                "-c",
                "protocol.version=2",
                "fetch",
                "--depth=1",
                "--no-tags",
                "origin",
                revision,
            ],
            cwd=temporary,
            env=env,
        )

        run(
            [
                "git",
                "checkout",
                "--detach",
                "-q",
                "FETCH_HEAD",
            ],
            cwd=temporary,
            env=env,
        )

        actual = git_head(temporary)

        if actual != revision:
            raise ProviderError(
                f"{name}: fetched revision mismatch: "
                f"expected={revision} actual={actual}"
            )

        reject_lfs_configuration(temporary)

        dirty = git_status(temporary)

        if dirty:
            raise ProviderError(
                f"{name}: newly fetched provider is dirty: "
                f"{dirty}"
            )

        temporary.rename(destination)

    except Exception:
        if temporary.exists():
            shutil.rmtree(temporary)
        raise

    print(f"{name}: cached ✓")
    print(f"  path: {destination}")


def verify_one(
    *,
    cache_root: Path,
    release: str,
    name: str,
    provider: dict,
) -> bool:
    state, detail = provider_state(
        cache_root=cache_root,
        release=release,
        name=name,
        provider=provider,
    )

    if state != "READY":
        print(
            f"{name:24s} "
            f"FAIL "
            f"{state}: {detail}"
        )
        return False

    destination = cache_path(
        cache_root=cache_root,
        release=release,
        provider_name=name,
    )

    reject_lfs_configuration(destination)

    print(
        f"{name:24s} "
        f"PASS "
        f"{provider['revision']}"
    )

    return True


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Resolve pinned Google kernel build providers "
            "for TreeForge."
        )
    )

    parser.add_argument(
        "--release",
        default=DEFAULT_RELEASE,
        help=(
            "kernel provider release "
            f"(default: {DEFAULT_RELEASE})"
        ),
    )

    parser.add_argument(
        "--cache-root",
        type=Path,
        default=DEFAULT_CACHE_ROOT,
        help=(
            "provider cache root "
            f"(default: {DEFAULT_CACHE_ROOT})"
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser(
        "status",
        help="show cached provider state",
    )

    fetch = subparsers.add_parser(
        "fetch",
        help="fetch missing provider(s) from Google",
    )

    fetch.add_argument(
        "providers",
        nargs="*",
        default=["all"],
        help="provider name(s), or all",
    )

    verify = subparsers.add_parser(
        "verify",
        help="verify cached provider(s)",
    )

    verify.add_argument(
        "providers",
        nargs="*",
        default=["all"],
        help="provider name(s), or all",
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    try:
        manifest, data = load_manifest(args.release)
        providers = data["providers"]

        if args.command == "status":
            return print_status(
                manifest=manifest,
                release=args.release,
                cache_root=args.cache_root,
                providers=providers,
            )

        names = select_names(
            providers,
            args.providers,
        )

        if args.command == "fetch":
            for name in names:
                fetch_one(
                    cache_root=args.cache_root,
                    release=args.release,
                    name=name,
                    provider=providers[name],
                )

            return 0

        if args.command == "verify":
            okay = True

            for name in names:
                okay &= verify_one(
                    cache_root=args.cache_root,
                    release=args.release,
                    name=name,
                    provider=providers[name],
                )

            return 0 if okay else 1

        raise ProviderError(
            f"unsupported command: {args.command}"
        )

    except ProviderError as exc:
        print(
            f"kernel-provider-cache: {exc}",
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
