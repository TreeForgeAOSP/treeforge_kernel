def new_build_generation() -> tuple[Path, Path]:
    stamp = time.strftime(
        "%Y%m%d-%H%M%S%z",
        time.localtime(),
    )

    generation = (
        ROOT
        / "out"
        / "source"
        / stamp
    )

    raw = generation / "raw"

    if generation.exists():
        raise KernelCtlError(
            f"build generation already exists: {generation}"
        )

    raw.mkdir(
        parents=True,
        exist_ok=False,
    )

    return generation, raw


def write_build_metadata(
    *,
    generation: Path,
    raw: Path,
    command,
    environment: dict,
    contract: dict,
):
    metadata = generation / "metadata"
    metadata.mkdir(parents=True, exist_ok=True)

    provider_heads = {}

    manifest = provider_manifest()

    for name, provider in manifest["providers"].items():
        workspace = ROOT / provider["workspace_path"]

        provider_heads[name] = {
            "workspace_path": provider["workspace_path"],
            "revision": git_head(workspace),
        }

    data = {
        "schema": 1,
        "device": DEVICE,
        "kernel_provider_release": KERNEL_PROVIDER_RELEASE,
        "workspace": str(ROOT),
        "generation": str(generation),
        "raw": str(raw),
        "command": [
            str(value)
            for value in command
        ],
        "java_home": environment.get("JAVA_HOME"),
        "provider_heads": provider_heads,
        "treeforge_tools_contract": str(
            TREEFORGE_TOOLS_CONTRACT
        ),
        "treeforge_tools": {
            name: record.get("path")
            for name, record in contract["tools"].items()
        },
    }

    target = metadata / "build.json"

    target.write_text(
        json.dumps(
            data,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    return target


def verify_raw_build(raw: Path):
    required = (
        "boot.img",
        "dtbo.img",
        "vendor_kernel_boot.img",
        "system_dlkm.img",
        "vendor_dlkm.img",
    )

    missing = []

    for name in required:
        path = raw / name

        if not path.is_file():
            missing.append(name)

    if missing:
        raise KernelCtlError(
            "kernel build completed but required raw artifacts "
            "are missing: "
            + ", ".join(missing)
        )

    print()
    print("Primary raw artifacts")
    print("---------------------")

    for name in required:
        path = raw / name

        print(
            f"{name:24s} "
            f"{path.stat().st_size:12d} bytes  "
            f"{path}"
        )


def execute_kernel_build() -> int:
    print("TreeForge Kernel Build")
    print("======================")
    print()
    print(f"Workspace:        {ROOT}")
    print(f"Provider release: {KERNEL_PROVIDER_RELEASE}")

    env, environment_plan = prepare_kernel_build_providers()
    contract = load_treeforge_tools_contract()

    generation, raw = new_build_generation()

    command = kernel_bazel_command(raw)

    metadata = write_build_metadata(
        generation=generation,
        raw=raw,
        command=command,
        environment=env,
        contract=contract,
    )

    print()
    print("Build generation")
    print("----------------")
    print(f"Generation: {generation}")
    print(f"Raw dist:   {raw}")
    print(f"Metadata:   {metadata}")

    print()
    print("Build command")
    print("-------------")
    print(
        " ".join(
            str(value)
            for value in command
        )
    )

    print()
    print("BUILD STARTED: YES")
    print()

    result = subprocess.run(
        [
            str(value)
            for value in command
        ],
        cwd=ROOT,
        env=env,
        text=True,
    )

    if result.returncode != 0:
        raise KernelCtlError(
            f"kernel build failed with exit code "
            f"{result.returncode}; generation preserved at "
            f"{generation}"
        )

    verify_raw_build(raw)

    print()
    print("Kernel build complete")
    print("---------------------")
    print(f"Generation: {generation}")
    print(f"Raw dist:   {raw}")
    print("DEVICE MODIFIED: NO")
    print("ADB INVOKED: NO")
    print("FASTBOOT INVOKED: NO")

    return 0


def build_command(argv) -> int:
    parser = argparse.ArgumentParser(
        prog="kernelctl build",
        description=(
            "TreeForge tangorpro kernel build with "
            "verified provider resolution"
        ),
    )

    parser.add_argument(
        "--plan-only",
        action="store_true",
        help=(
            "resolve and validate providers without "
            "starting the kernel build"
        ),
    )

    args = parser.parse_args(argv)

    if args.plan_only:
        kernel_build_plan()
        return 0

    return execute_kernel_build()


def detect_transport():
    adb = subprocess.run(
        ["adb", "get-state"],
        text=True,
        capture_output=True,
    )

    if adb.returncode == 0 and "device" in adb.stdout:
        return "adb"

    fb = subprocess.run(
        ["fastboot", "devices"],
        text=True,
        capture_output=True,
    )

    if fb.stdout.strip():
        userspace = subprocess.run(
            ["fastboot", "getvar", "is-userspace"],
            text=True,
            capture_output=True,
        )

        text = userspace.stdout + userspace.stderr

        if "yes" in text:
            return "fastbootd"

        return "bootloader"

    return "none"


def ensure_bootloader():
    transport = detect_transport()

    if transport == "adb":
        run(["adb", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "fastbootd":
        run(["fastboot", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "bootloader":
        pass

    else:
        raise KernelCtlError("no ADB/Fastboot device detected")

    product = output(["fastboot", "getvar", "product"])

    if DEVICE not in product:
        raise KernelCtlError(
            f"refusing to flash non-{DEVICE} device"
        )

    unlocked = output(["fastboot", "getvar", "unlocked"])

    if "yes" not in unlocked.lower():
        raise KernelCtlError("device bootloader is not unlocked")


def ensure_fastbootd():
    ensure_bootloader()

    run(["fastboot", "reboot", "fastboot"])
    time.sleep(5)

    state = output(["fastboot", "getvar", "is-userspace"])

    if "yes" not in state.lower():
        raise KernelCtlError("failed to enter fastbootd")


def flash(stage: Path, slot: str, active: str, reboot: bool):
    if slot not in ("a", "b", "both"):
        raise KernelCtlError("flash slot must be a, b, or both")

    slots = ("a", "b") if slot == "both" else (slot,)

    if active not in ("keep", "a", "b"):
        raise KernelCtlError("active slot must be keep, a, or b")

    print()
    print("FLASH PLAN")
    print("----------")
    print(f"Target slot:       {slot.upper() if slot != 'both' else 'A + B'}")
    print(f"Active after:      {active}")
    print(f"Reboot Android:    {'YES' if reboot else 'NO'}")
    print()
    print("Physical:")
    for target_slot in slots:
        print(f"  boot_{target_slot}")
        print(f"  init_boot_{target_slot}")
        print(f"  dtbo_{target_slot}")
        print(f"  vendor_boot_{target_slot}")
        print(f"  vendor_kernel_boot_{target_slot}")
        print(f"  vbmeta_{target_slot}")
        print(f"  vbmeta_system_{target_slot}")
        print(f"  vbmeta_vendor_{target_slot}")

    print()
    print("Logical:")
    for target_slot in slots:
        print(f"  vendor_dlkm_{target_slot}")
        print(f"  system_dlkm_{target_slot}")
    print()

    while True:
        answer = input("Proceed with flash? [y/N]: ").strip().lower()

        if answer in ("", "n", "no"):
            print("Flash cancelled.")
            return

        if answer in ("y", "yes"):
            break

        print("Please answer yes or no.")

    ensure_bootloader()

    physical = (
        ("boot", "boot.img"),
        ("init_boot", "init_boot.img"),
        ("dtbo", "dtbo.img"),
        ("vendor_boot", "vendor_boot.img"),
        ("vendor_kernel_boot", "vendor_kernel_boot.img"),
        ("vbmeta_system", "vbmeta_system.img"),
        ("vbmeta_vendor", "vbmeta_vendor.img"),
        ("vbmeta", "vbmeta.img"),
    )

    for target_slot in slots:
        for partition, filename in physical:
            run([
                "fastboot",
                "flash",
                f"{partition}_{target_slot}",
                stage / filename,
            ])

    ensure_fastbootd()

    for target_slot in slots:
        run([
            "fastboot",
            "flash",
            f"vendor_dlkm_{target_slot}",
            stage / "vendor_dlkm.img",
        ])

        run([
            "fastboot",
            "flash",
            f"system_dlkm_{target_slot}",
            stage / "system_dlkm.img",
        ])

    # Always return to bootloader before final slot/reboot choice.
    run(["fastboot", "reboot", "bootloader"])
    time.sleep(4)

    if active in ("a", "b"):
        run(["fastboot", f"--set-active={active}"])

    current = output(["fastboot", "getvar", "current-slot"])
    print(current.strip())

    if reboot:
        run(["fastboot", "reboot"])
    else:
        print("Device left in bootloader fastboot.")


def choose(prompt, choices):
    print()
    print(prompt)

    for index, (label, value) in enumerate(choices, 1):
        print(f"  {index}) {label}")

    while True:
        answer = input("> ").strip()

        try:
            index = int(answer)
        except ValueError:
            continue

        if 1 <= index <= len(choices):
            return choices[index - 1][1]


def interactive():
    provider = choose(
        "Signing provider:",
        [
            ("AOSP test keys", "aosp"),
            ("TreeForge development keys", "treeforge"),
        ],
    )

    stage = package(provider)

    do_flash = choose(
        "Flash this package?",
        [
            ("No - package only", False),
            ("Yes", True),
        ],
    )

    if not do_flash:
        return

    slot = choose(
        "Flash target slot:",
        [
            ("Slot A", "a"),
            ("Slot B", "b"),
            ("Both slots A + B", "both"),
        ],
    )

    active = choose(
        "Active slot after flashing:",
        [
            ("Keep current active slot", "keep"),
            ("Set slot A active", "a"),
            ("Set slot B active", "b"),
        ],
    )

    reboot = choose(
        "Reboot Android after flashing?",
        [
            ("No - leave in bootloader", False),
            ("Yes", True),
        ],
    )

    flash(stage, slot, active, reboot)


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "build":
        try:
            return build_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(f"\nERROR: {error}", file=sys.stderr)
            return 1

    parser = argparse.ArgumentParser(
        prog="kernelctl",
        description=(
            "TreeForge tangorpro kernel packaging/signing/flashing CLI"
        ),
    )

    parser.add_argument(
        "--signing",
        choices=("aosp", "treeforge"),
        help="AVB signing provider",
    )

    parser.add_argument(
        "--package-only",
        action="store_true",
        help="package/sign but do not flash",
    )

    parser.add_argument(
        "--slot",
        choices=("a", "b", "both"),
        help="slot to flash",
    )

    parser.add_argument(
        "--active",
        choices=("keep", "a", "b"),
        default="keep",
        help="active slot after flashing",
    )

    parser.add_argument(
        "--reboot",
        action="store_true",
        help="reboot Android after flashing",
    )

    args = parser.parse_args()

    try:
        if not args.signing:
            interactive()
            return 0

        stage = package(args.signing)

        if args.package_only:
            return 0

        if not args.slot:
            raise KernelCtlError(
                "--slot a|b|both is required unless --package-only is used"
            )

        flash(stage, args.slot, args.active, args.reboot)
        return 0

    except KeyboardInterrupt:
        print("\nCancelled.")
        return 130

    except KernelCtlError as error:
        print(f"\nERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
