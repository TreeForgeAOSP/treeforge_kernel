def latest_source_generation() -> tuple[Path, Path]:
    source_root = ROOT / "out" / "source"

    if not source_root.is_dir():
        raise KernelCtlError(
            f"source build output root missing: {source_root}"
        )

    candidates = []

    for generation in source_root.iterdir():
        raw = generation / "raw"

        if (
            generation.is_dir()
            and raw.is_dir()
            and (raw / "boot.img").is_file()
        ):
            candidates.append(generation)

    if not candidates:
        raise KernelCtlError(
            "no completed source generation with raw/boot.img found"
        )

    generation = max(
        candidates,
        key=lambda path: path.stat().st_mtime,
    )

    return generation, generation / "raw"


def package_source_generation(
    *,
    generation: Path,
    raw: Path,
    signing: str,
) -> Path:
    if signing == "none":
        raise KernelCtlError(
            "a final verified-boot package requires "
            "aosp or treeforge signing"
        )

    keys = provider_keys(signing)
    avbtool = avbtool_path()

    raw_names = (
        "boot.img",
        "dtbo.img",
        "vendor_kernel_boot.img",
        "system_dlkm.img",
        "vendor_dlkm.img",
    )

    for name in raw_names:
        need_file(raw / name)

    reference_names = (
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "system.img",
        "system_ext.img",
        "product.img",
        "pvmfw.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    )

    for name in reference_names:
        need_file(AOSP_PRODUCT / name)

    stage = generation / "package"
    stage.mkdir(
        parents=True,
        exist_ok=True,
    )

    raw_before = {
        name: file_sha256(raw / name)
        for name in raw_names
    }

    print()
    print("Full verified-boot package")
    print("--------------------------")
    print(f"Raw:              {raw}")
    print(f"Package:          {stage}")
    print(f"Signing provider: {signing}")

    # ---------------------------------------------------------
    # boot — RSA2048 chain partition
    # ---------------------------------------------------------

    stock_boot = AOSP_PRODUCT / "boot.img"
    stock_boot_info = avb_info(stock_boot)

    boot = stage / "boot.img"
    copy_clean(
        raw / "boot.img",
        boot,
    )

    run([
        avbtool,
        "erase_footer",
        "--image",
        boot,
    ])

    add_hash_footer(
        boot,
        partition_name="boot",
        partition_size=stock_boot.stat().st_size,
        key=keys["boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_boot_info,
            "Rollback Index",
        ),
        salt=field(
            stock_boot_info,
            "Salt",
        ),
        props=properties(stock_boot_info),
    )

    # ---------------------------------------------------------
    # init_boot — preserved AOSP payload, RSA2048 resign
    # ---------------------------------------------------------

    stock_init_boot = AOSP_PRODUCT / "init_boot.img"
    stock_init_info = avb_info(stock_init_boot)

    init_boot = stage / "init_boot.img"
    copy_clean(
        stock_init_boot,
        init_boot,
    )

    run([
        avbtool,
        "erase_footer",
        "--image",
        init_boot,
    ])

    add_hash_footer(
        init_boot,
        partition_name="init_boot",
        partition_size=stock_init_boot.stat().st_size,
        key=keys["init_boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_init_info,
            "Rollback Index",
        ),
        salt=field(
            stock_init_info,
            "Salt",
        ),
        props=properties(stock_init_info),
    )

    # ---------------------------------------------------------
    # dtbo — unsigned hash footer, authenticated by root vbmeta
    # ---------------------------------------------------------

    stock_dtbo = AOSP_PRODUCT / "dtbo.img"
    stock_dtbo_info = avb_info(stock_dtbo)

    dtbo = stage / "dtbo.img"
    copy_clean(
        raw / "dtbo.img",
        dtbo,
    )

    probe = run(
        [
            avbtool,
            "info_image",
            "--image",
            dtbo,
        ],
        capture=True,
        check=False,
    )

    if probe.returncode == 0:
        run([
            avbtool,
            "erase_footer",
            "--image",
            dtbo,
        ])

    add_hash_footer(
        dtbo,
        partition_name="dtbo",
        partition_size=stock_dtbo.stat().st_size,
        salt=field(
            stock_dtbo_info,
            "Salt",
        ),
        props=properties(stock_dtbo_info),
    )

    # ---------------------------------------------------------
    # vendor_boot — unchanged AOSP payload
    # ---------------------------------------------------------

    vendor_boot = stage / "vendor_boot.img"

    copy_clean(
        AOSP_PRODUCT / "vendor_boot.img",
        vendor_boot,
    )

    # ---------------------------------------------------------
    # vendor_kernel_boot — unsigned hash footer,
    # authenticated by root vbmeta
    # ---------------------------------------------------------

    stock_vkb = (
        AOSP_PRODUCT
        / "vendor_kernel_boot.img"
    )

    stock_vkb_info = avb_info(stock_vkb)

    vendor_kernel_boot = (
        stage
        / "vendor_kernel_boot.img"
    )

    copy_clean(
        raw / "vendor_kernel_boot.img",
        vendor_kernel_boot,
    )

    probe = run(
        [
            avbtool,
            "info_image",
            "--image",
            vendor_kernel_boot,
        ],
        capture=True,
        check=False,
    )

    if probe.returncode == 0:
        run([
            avbtool,
            "erase_footer",
            "--image",
            vendor_kernel_boot,
        ])

    add_hash_footer(
        vendor_kernel_boot,
        partition_name="vendor_kernel_boot",
        partition_size=stock_vkb.stat().st_size,
        salt=field(
            stock_vkb_info,
            "Salt",
        ),
        props=properties(stock_vkb_info),
    )

    # ---------------------------------------------------------
    # DLKM — Kleaf already produced their AVB hashtrees.
    # Their descriptors are authenticated by vbmeta nodes.
    # ---------------------------------------------------------

    vendor_dlkm = stage / "vendor_dlkm.img"
    system_dlkm = stage / "system_dlkm.img"

    copy_clean(
        raw / "vendor_dlkm.img",
        vendor_dlkm,
    )

    copy_clean(
        raw / "system_dlkm.img",
        system_dlkm,
    )

    for name, image in (
        ("vendor_dlkm", vendor_dlkm),
        ("system_dlkm", system_dlkm),
    ):
        info = avb_info(image)

        if "Hashtree descriptor:" not in info:
            raise KernelCtlError(
                f"{name}: expected AVB hashtree missing"
            )

    # ---------------------------------------------------------
    # vbmeta_system — RSA2048
    # ---------------------------------------------------------

    stock_vbmeta_system = (
        AOSP_PRODUCT
        / "vbmeta_system.img"
    )

    stock_vbs_info = avb_info(
        stock_vbmeta_system
    )

    vbmeta_system = (
        stage
        / "vbmeta_system.img"
    )

    command = [
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta_system,
        "--key",
        keys["vbmeta_system"],
        "--algorithm",
        "SHA256_RSA2048",
        "--rollback_index",
        str(
            integer_field(
                stock_vbs_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(
            stock_vbmeta_system.stat().st_size
        ),

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system.img",

        "--include_descriptors_from_image",
        system_dlkm,

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system_ext.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "product.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "pvmfw.img",
    ]

    append_props(
        command,
        properties(
            stock_vbs_info,
            "com.android.build.system_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # vbmeta_vendor — RSA2048, preserve AOSP vendor descriptor
    # ---------------------------------------------------------

    stock_vbmeta_vendor = (
        AOSP_PRODUCT
        / "vbmeta_vendor.img"
    )

    stock_vbv_info = avb_info(
        stock_vbmeta_vendor
    )

    vbmeta_vendor = (
        stage
        / "vbmeta_vendor.img"
    )

    run([
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta_vendor,
        "--key",
        keys["vbmeta_vendor"],
        "--algorithm",
        "SHA256_RSA2048",
        "--rollback_index",
        str(
            integer_field(
                stock_vbv_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(
            stock_vbmeta_vendor.stat().st_size
        ),
        "--include_descriptors_from_image",
        stock_vbmeta_vendor,
    ])

    # ---------------------------------------------------------
    # Root vbmeta — RSA4096
    # ---------------------------------------------------------

    pubdir = stage / ".pubkeys"

    if pubdir.exists():
        shutil.rmtree(pubdir)

    pubdir.mkdir()

    pubs = {}

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
    ):
        pub = pubdir / f"{name}.avbpubkey"

        run([
            avbtool,
            "extract_public_key",
            "--key",
            keys[name],
            "--output",
            pub,
        ])

        pubs[name] = pub

    stock_vbmeta = (
        AOSP_PRODUCT
        / "vbmeta.img"
    )

    stock_vbmeta_info = avb_info(
        stock_vbmeta
    )

    vbmeta = stage / "vbmeta.img"

    command = [
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta,
        "--key",
        keys["vbmeta"],
        "--algorithm",
        "SHA256_RSA4096",
        "--rollback_index",
        str(
            integer_field(
                stock_vbmeta_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(stock_vbmeta.stat().st_size),

        "--chain_partition",
        f"boot:2:{pubs['boot']}",

        "--chain_partition",
        f"init_boot:4:{pubs['init_boot']}",

        "--chain_partition",
        (
            "vbmeta_system:1:"
            f"{pubs['vbmeta_system']}"
        ),

        "--chain_partition",
        (
            "vbmeta_vendor:3:"
            f"{pubs['vbmeta_vendor']}"
        ),

        "--include_descriptors_from_image",
        dtbo,

        "--include_descriptors_from_image",
        vendor_boot,

        "--include_descriptors_from_image",
        vendor_kernel_boot,

        "--include_descriptors_from_image",
        vendor_dlkm,
    ]

    append_props(
        command,
        properties(
            stock_vbmeta_info,
            "com.android.build.vendor_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # Signed-node verification
    # ---------------------------------------------------------

    expected_hashes = {
        "boot": public_key_sha1(
            keys["boot"]
        ),
        "init_boot": public_key_sha1(
            keys["init_boot"]
        ),
        "vbmeta": public_key_sha1(
            keys["vbmeta"]
        ),
        "vbmeta_system": public_key_sha1(
            keys["vbmeta_system"]
        ),
        "vbmeta_vendor": public_key_sha1(
            keys["vbmeta_vendor"]
        ),
    }

    verify_images = {
        "boot": boot,
        "init_boot": init_boot,
        "vbmeta": vbmeta,
        "vbmeta_system": vbmeta_system,
        "vbmeta_vendor": vbmeta_vendor,
    }

    print()
    print("Signing verification")
    print("--------------------")

    signing_results = {}

    for name, image in verify_images.items():
        info = avb_info(image)
        actual = field(
            info,
            "Public key (sha1)",
        )

        expected = expected_hashes[name]

        if actual != expected:
            raise KernelCtlError(
                f"{name}: signing key mismatch: "
                f"expected {expected}, got {actual}"
            )

        algorithm = field(
            info,
            "Algorithm",
        )

        expected_algorithm = (
            "SHA256_RSA4096"
            if name == "vbmeta"
            else "SHA256_RSA2048"
        )

        if algorithm != expected_algorithm:
            raise KernelCtlError(
                f"{name}: algorithm mismatch: "
                f"expected {expected_algorithm}, "
                f"got {algorithm}"
            )

        signing_results[name] = {
            "algorithm": algorithm,
            "public_key_sha1": actual,
        }

        print(
            f"PASS  {name:<15} "
            f"{algorithm:<16} {actual}"
        )

    # Verify boot and init_boot cryptographically.
    for name, image in (
        ("boot", boot),
        ("init_boot", init_boot),
    ):
        run([
            avbtool,
            "verify_image",
            "--image",
            image,
            "--key",
            keys[name],
        ])

    # ---------------------------------------------------------
    # AVB graph sanity
    # ---------------------------------------------------------

    root_info = avb_info(vbmeta)
    system_info = avb_info(vbmeta_system)
    vendor_info = avb_info(vbmeta_vendor)

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
        "dtbo",
        "vendor_boot",
        "vendor_kernel_boot",
        "vendor_dlkm",
    ):
        if name not in root_info:
            raise KernelCtlError(
                f"root vbmeta missing expected target: {name}"
            )

    for name in (
        "system",
        "system_dlkm",
        "system_ext",
        "product",
        "pvmfw",
    ):
        if name not in system_info:
            raise KernelCtlError(
                f"vbmeta_system missing target: {name}"
            )

    if "vendor" not in vendor_info:
        raise KernelCtlError(
            "vbmeta_vendor missing vendor descriptor"
        )

    # ---------------------------------------------------------
    # Final package completeness
    # ---------------------------------------------------------

    expected = (
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    )

    for name in expected:
        need_file(stage / name)

    # ---------------------------------------------------------
    # Raw-build immutability
    # ---------------------------------------------------------

    raw_after = {
        name: file_sha256(raw / name)
        for name in raw_names
    }

    changed = [
        name
        for name in raw_names
        if raw_before[name]
        != raw_after[name]
    ]

    if changed:
        raise KernelCtlError(
            "raw output changed during packaging: "
            + ", ".join(changed)
        )

    # ---------------------------------------------------------
    # Metadata
    # ---------------------------------------------------------

    artifacts = {}

    for name in expected:
        image = stage / name

        artifacts[name] = {
            "path": str(image),
            "size": image.stat().st_size,
            "sha256": file_sha256(image),
        }

    metadata = {
        "schema": 3,
        "stage": "verified-boot-package",
        "device": DEVICE,
        "kernel_release": KERNEL_PROVIDER_RELEASE,
        "signing_provider": signing,
        "signing_nodes": signing_results,
        "artifacts": artifacts,
        "raw_kernel_family_preserved": True,
        "reference_product": str(AOSP_PRODUCT),
        "reference_release": "android-15-r36",
    }

    metadata_dir = generation / "metadata"
    metadata_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    metadata_path = (
        metadata_dir
        / "package.json"
    )

    metadata_path.write_text(
        json.dumps(
            metadata,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    print()
    print("Final verified-boot package")
    print("---------------------------")

    for name in expected:
        image = stage / name

        print(
            f"{name:<24} "
            f"{image.stat().st_size:>10} bytes  "
            f"{file_sha256(image)}"
        )

    print()
    print(
        "Signed nodes: "
        "boot init_boot vbmeta "
        "vbmeta_system vbmeta_vendor"
    )
    print(
        "Descriptor-authenticated nodes: "
        "dtbo vendor_boot vendor_kernel_boot "
        "vendor_dlkm system_dlkm"
    )
    print(f"Metadata: {metadata_path}")
    print("RAW KERNEL FAMILY MODIFIED: NO")

    return boot


