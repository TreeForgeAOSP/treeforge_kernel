def _framebuffer_provider_sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for block in iter(
            lambda: stream.read(1024 * 1024),
            b"",
        ):
            digest.update(block)

    return digest.hexdigest()


def _framebuffer_github_token() -> str | None:
    for name in (
        "GH_TOKEN",
        "GITHUB_TOKEN",
    ):
        value = os.environ.get(name, "").strip()

        if value:
            return value

    gh = shutil.which("gh")

    if gh is None:
        return None

    completed = subprocess.run(
        [gh, "auth", "token"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    if completed.returncode != 0:
        return None

    value = completed.stdout.strip()
    return value or None


def _framebuffer_github_request(
    url: str,
    *,
    token: str,
    accept: str,
) -> urllib.request.Request:
    return urllib.request.Request(
        url,
        headers={
            "Accept": accept,
            "Authorization": f"Bearer {token}",
            "User-Agent": "TreeForge-Kernel/1",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )


def _framebuffer_release_asset_api_url(
    token: str,
) -> str:
    encoded_tag = urllib.parse.quote(
        FRAMEBUFFER_PROVIDER_VERSION,
        safe="",
    )
    release_url = (
        "https://api.github.com/repos/"
        + FRAMEBUFFER_PROVIDER_REPOSITORY
        + "/releases/tags/"
        + encoded_tag
    )

    try:
        with urllib.request.urlopen(
            _framebuffer_github_request(
                release_url,
                token=token,
                accept="application/vnd.github+json",
            ),
            timeout=60,
        ) as response:
            release = json.load(response)
    except (
        OSError,
        urllib.error.URLError,
        json.JSONDecodeError,
    ) as error:
        raise KernelCtlError(
            "unable to resolve released TreeForge "
            "framebuffer provider"
        ) from error

    for asset in release.get("assets", []):
        if asset.get("name") != FRAMEBUFFER_PROVIDER_RELEASE_ASSET:
            continue

        url = asset.get("url")

        if isinstance(url, str) and url:
            return url

    raise KernelCtlError(
        "released TreeForge framebuffer provider asset "
        "is missing: "
        + FRAMEBUFFER_PROVIDER_RELEASE_ASSET
    )


def _download_framebuffer_provider_archive(
    destination: Path,
    token: str,
) -> None:
    asset_url = _framebuffer_release_asset_api_url(
        token
    )

    try:
        with urllib.request.urlopen(
            _framebuffer_github_request(
                asset_url,
                token=token,
                accept="application/octet-stream",
            ),
            timeout=120,
        ) as response:
            with destination.open("wb") as output:
                shutil.copyfileobj(
                    response,
                    output,
                    length=1024 * 1024,
                )
    except (
        OSError,
        urllib.error.URLError,
    ) as error:
        raise KernelCtlError(
            "unable to download released TreeForge "
            "framebuffer provider"
        ) from error

    actual = _framebuffer_provider_sha256(
        destination
    )

    if actual != FRAMEBUFFER_PROVIDER_RELEASE_SHA256:
        raise KernelCtlError(
            "released framebuffer provider archive "
            "identity changed:\n"
            f"  expected={FRAMEBUFFER_PROVIDER_RELEASE_SHA256}\n"
            f"  actual={actual}"
        )


def _safe_extract_framebuffer_provider(
    archive: Path,
    destination: Path,
) -> Path:
    prefix = Path(FRAMEBUFFER_PROVIDER_NAME)

    try:
        with tarfile.open(
            archive,
            mode="r:xz",
        ) as bundle:
            members = bundle.getmembers()

            if not members:
                raise KernelCtlError(
                    "released framebuffer provider archive "
                    "is empty"
                )

            for member in members:
                member_path = Path(member.name)

                if (
                    member_path.is_absolute()
                    or ".." in member_path.parts
                    or not member_path.parts
                    or member_path.parts[0] != prefix.name
                ):
                    raise KernelCtlError(
                        "released framebuffer provider archive "
                        "has unsafe member: "
                        + member.name
                    )

                if member.issym() or member.islnk():
                    raise KernelCtlError(
                        "released framebuffer provider archive "
                        "has link member: "
                        + member.name
                    )

            bundle.extractall(
                destination,
                filter="data",
            )
    except (
        OSError,
        tarfile.TarError,
    ) as error:
        raise KernelCtlError(
            "unable to extract released TreeForge "
            "framebuffer provider"
        ) from error

    root = destination / prefix

    if not root.is_dir():
        raise KernelCtlError(
            "released framebuffer provider archive root "
            "is missing"
        )

    return root


def _verify_framebuffer_manifest_identity(
    root: Path,
) -> None:
    manifest = root / "provider.json"
    need_file(manifest)

    actual = _framebuffer_provider_sha256(
        manifest
    )

    if actual != FRAMEBUFFER_PROVIDER_MANIFEST_SHA256:
        raise KernelCtlError(
            "framebuffer provider manifest identity changed:\n"
            f"  expected={FRAMEBUFFER_PROVIDER_MANIFEST_SHA256}\n"
            f"  actual={actual}"
        )


def _materialize_framebuffer_provider() -> Path:
    if FRAMEBUFFER_PROVIDER_CACHE.is_dir():
        try:
            _verify_framebuffer_manifest_identity(
                FRAMEBUFFER_PROVIDER_CACHE
            )
            return FRAMEBUFFER_PROVIDER_CACHE
        except KernelCtlError:
            shutil.rmtree(
                FRAMEBUFFER_PROVIDER_CACHE
            )

    token = _framebuffer_github_token()

    if token is None:
        raise KernelCtlError(
            "TreeForge framebuffer provider is private. "
            "Authenticate with `gh auth login`, or set "
            "GH_TOKEN / GITHUB_TOKEN."
        )

    FRAMEBUFFER_PROVIDER_CACHE_ROOT.mkdir(
        parents=True,
        exist_ok=True,
    )

    with tempfile.TemporaryDirectory(
        prefix=(
            "."
            + FRAMEBUFFER_PROVIDER_VERSION
            + ".partial-"
        ),
        dir=FRAMEBUFFER_PROVIDER_CACHE_ROOT,
    ) as raw:
        temporary = Path(raw)
        archive = (
            temporary
            / FRAMEBUFFER_PROVIDER_RELEASE_ASSET
        )

        _download_framebuffer_provider_archive(
            archive,
            token,
        )

        extracted = _safe_extract_framebuffer_provider(
            archive,
            temporary / "extract",
        )
        _verify_framebuffer_manifest_identity(
            extracted
        )

        replacement = (
            FRAMEBUFFER_PROVIDER_CACHE_ROOT
            / (
                "."
                + FRAMEBUFFER_PROVIDER_VERSION
                + f".new-{os.getpid()}"
            )
        )

        if replacement.exists():
            shutil.rmtree(replacement)

        shutil.copytree(
            extracted,
            replacement,
        )
        _verify_framebuffer_manifest_identity(
            replacement
        )

        if FRAMEBUFFER_PROVIDER_CACHE.exists():
            shutil.rmtree(
                FRAMEBUFFER_PROVIDER_CACHE
            )

        replacement.replace(
            FRAMEBUFFER_PROVIDER_CACHE
        )

    _verify_framebuffer_manifest_identity(
        FRAMEBUFFER_PROVIDER_CACHE
    )
    return FRAMEBUFFER_PROVIDER_CACHE


def framebuffer_provider_root() -> Path:
    explicit = os.environ.get(
        FRAMEBUFFER_PROVIDER_ENV
    )

    if explicit:
        root = Path(explicit).expanduser().resolve()
        _verify_framebuffer_manifest_identity(root)
    else:
        root = _materialize_framebuffer_provider()

    manifest = root / "provider.json"

    try:
        data = json.loads(
            manifest.read_text(
                encoding="utf-8"
            )
        )
    except Exception as error:
        raise KernelCtlError(
            "invalid TreeForge framebuffer "
            f"provider manifest: {manifest}: {error}"
        ) from error

    if data.get("schema_version") != 1:
        raise KernelCtlError(
            "unsupported framebuffer provider schema"
        )

    if data.get("provider") != FRAMEBUFFER_PROVIDER_NAME:
        raise KernelCtlError(
            "framebuffer provider identity changed"
        )

    if data.get("version") != FRAMEBUFFER_PROVIDER_VERSION:
        raise KernelCtlError(
            "framebuffer provider version mismatch:\n"
            f"  expected={FRAMEBUFFER_PROVIDER_VERSION}\n"
            f"  actual={data.get('version')}"
        )

    if data.get("abi") != FRAMEBUFFER_PROVIDER_ABI:
        raise KernelCtlError(
            "framebuffer provider ABI mismatch:\n"
            f"  expected={FRAMEBUFFER_PROVIDER_ABI}\n"
            f"  actual={data.get('abi')}"
        )

    return root


def framebuffer_provider_patch_contract(
    provider_root: Path,
    patch_value: str,
) -> dict:
    manifest = json.loads(
        (provider_root / "provider.json")
        .read_text(encoding="utf-8")
    )

    kernel = manifest.get("kernel")

    if not isinstance(kernel, dict):
        raise KernelCtlError(
            "framebuffer provider kernel contract missing"
        )

    for record in kernel.values():
        if (
            isinstance(record, dict)
            and record.get("patch") == patch_value
        ):
            return record

    raise KernelCtlError(
        "framebuffer provider does not declare patch: "
        + patch_value
    )


def validate_profile_patch_records(
    profile_data: dict,
) -> list[dict]:
    patches = profile_data.get(
        "patches",
        [],
    )

    if not isinstance(
        patches,
        list,
    ):
        raise KernelCtlError(
            "kernel profile patches must be a list"
        )

    validated = []

    for record in patches:
        if not isinstance(
            record,
            dict,
        ):
            raise KernelCtlError(
                "kernel profile patch record "
                "must be an object"
            )

        repository = record.get(
            "repository"
        )

        base_revision = record.get(
            "base_revision"
        )

        patch_value = record.get(
            "patch"
        )

        expected_sha256 = record.get(
            "sha256"
        )

        if not all(
            isinstance(value, str)
            and value
            for value in (
                repository,
                base_revision,
                patch_value,
                expected_sha256,
            )
        ):
            raise KernelCtlError(
                "incomplete kernel profile "
                "patch record"
            )

        provider_name = record.get(
            "provider"
        )

        if provider_name is None:
            patch = (
                ROOT
                / patch_value
            )
        elif provider_name == FRAMEBUFFER_PROVIDER_NAME:
            provider_root = framebuffer_provider_root()
            provider_record = (
                framebuffer_provider_patch_contract(
                    provider_root,
                    patch_value,
                )
            )

            for field in (
                "sha256",
                "base_revision",
            ):
                if (
                    provider_record.get(field)
                    != record.get(field)
                ):
                    raise KernelCtlError(
                        "framebuffer provider patch contract "
                        f"mismatch for {patch_value}: {field}"
                    )

            patch = (
                provider_root
                / patch_value
            )
        else:
            raise KernelCtlError(
                "unsupported kernel patch provider: "
                + str(provider_name)
            )

        need_file(patch)

        actual_sha256 = file_sha256(
            patch
        )

        if actual_sha256 != expected_sha256:
            raise KernelCtlError(
                "kernel profile patch SHA256 "
                "mismatch:\n"
                f"  patch={patch}\n"
                f"  expected={expected_sha256}\n"
                f"  actual={actual_sha256}"
            )

        repository_root = (
            ROOT
            / repository
        )

        validated.append(
            {
                **record,
                "_patch_path":
                    patch,
                "_repository_root":
                    repository_root,
            }
        )

    return validated


def all_managed_profile_patches() -> list[dict]:
    profile_root = (
        ROOT
        / "profiles"
    )

    records = []
    seen = set()

    if not profile_root.is_dir():
        return records

    for path in sorted(
        profile_root.glob(
            "*/profile.json"
        )
    ):
        try:
            data = json.loads(
                path.read_text(
                    encoding="utf-8"
                )
            )
        except Exception as error:
            raise KernelCtlError(
                f"invalid profile JSON: "
                f"{path}: {error}"
            ) from error

        profile = data.get(
            "id"
        )

        if (
            not isinstance(profile, str)
            or not profile
        ):
            raise KernelCtlError(
                f"profile id missing: {path}"
            )

        canonical = load_build_profile(
            profile
        )

        for record in (
            validate_profile_patch_records(
                canonical
            )
        ):
            key = (
                record["repository"],
                record["patch"],
                record["sha256"],
            )

            if key in seen:
                continue

            seen.add(key)
            records.append(
                record
            )

    return records


def git_capture(
    repository: Path,
    *arguments: str,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        [
            "git",
            "-C",
            str(repository),
            *arguments,
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def repository_head(
    repository: Path,
) -> str | None:
    if not repository.is_dir():
        return None

    result = git_capture(
        repository,
        "rev-parse",
        "HEAD",
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def patch_state(
    record: dict,
) -> str:
    repository = record[
        "_repository_root"
    ]

    patch = record[
        "_patch_path"
    ]

    if not repository.is_dir():
        return "repository-missing"

    head = git_capture(
        repository,
        "rev-parse",
        "HEAD",
    )

    if head.returncode != 0:
        raise KernelCtlError(
            "unable to inspect managed kernel "
            "repository revision:\n"
            + head.stdout
        )

    actual_revision = (
        head.stdout.strip()
    )

    expected_revision = record[
        "base_revision"
    ]

    # A managed patch belongs only to the source baseline
    # declared by its profile.  Profiles may intentionally
    # use different frozen kernel baselines, so a patch from
    # another baseline must not be tested for applicability
    # against the active source tree.
    if actual_revision != expected_revision:
        return "base-revision-mismatch"

    forward = git_capture(
        repository,
        "apply",
        "--check",
        str(patch),
    )

    reverse = git_capture(
        repository,
        "apply",
        "--reverse",
        "--check",
        str(patch),
    )

    forward_ok = (
        forward.returncode == 0
    )

    reverse_ok = (
        reverse.returncode == 0
    )

    if forward_ok and not reverse_ok:
        return "pristine"

    if reverse_ok and not forward_ok:
        return "applied"

    if forward_ok and reverse_ok:
        raise KernelCtlError(
            "ambiguous kernel profile patch state: "
            f"{patch}"
        )

    return "diverged"


def normalize_selected_profile_patches(
    profile_data: dict,
) -> None:
    patches = (
        validate_profile_patch_records(
            profile_data
        )
    )

    profile = profile_data["id"]

    print()
    print("Normalizing selected kernel profile")
    print("-----------------------------------")
    print(f"Profile: {profile}")

    #
    # A profile is applied in declaration order, so return it
    # to its pinned source state in the exact reverse order.
    #
    for record in reversed(patches):
        repository = record[
            "_repository_root"
        ]

        patch = record[
            "_patch_path"
        ]

        state = patch_state(
            record
        )

        try:
            relative_patch = patch.relative_to(ROOT)
        except ValueError:
            relative_patch = patch

        print(
            f"[{profile}] "
            f"{record['repository']}: "
            f"{relative_patch}: {state}"
        )

        if state == "pristine":
            continue

        if state != "applied":
            raise KernelCtlError(
                "selected kernel profile cannot be "
                "normalized safely:\n"
                f"  profile={profile}\n"
                f"  repository={repository}\n"
                f"  patch={patch}\n"
                f"  state={state}"
            )

        result = git_capture(
            repository,
            "apply",
            "--reverse",
            str(patch),
        )

        if result.returncode != 0:
            raise KernelCtlError(
                "unable to reverse selected kernel "
                "profile patch:\n"
                + result.stdout
            )

        if patch_state(record) != "pristine":
            raise KernelCtlError(
                "selected kernel profile patch did "
                "not return to pristine state:\n"
                f"  profile={profile}\n"
                f"  patch={patch}"
            )




# TREEFORGE_KERNEL_COMPONENT_METADATA_V1

TREEFORGE_KERNEL_COMPONENT_KEYS = (
    "release",
    "linux_base",
    "panthor",
    "panthor_backport",
    "drm_backport",
)

TREEFORGE_KERNEL_METADATA_TEMPLATE = (
    ROOT
    / "profiles"
    / "treeforge-bootstrap"
    / "treeforge_metadata.c.in"
)

TREEFORGE_KERNEL_METADATA_SOURCE = (
    ROOT
    / "aosp"
    / "drivers"
    / "misc"
    / "treeforge_metadata.c"
)

TREEFORGE_KERNEL_METADATA_MARKER = (
    "TREEFORGE_GENERATED_KERNEL_METADATA_V1"
)


def treeforge_kernel_components(
    profile_data: dict,
) -> dict[str, str]:
    values = profile_data.get(
        "treeforge_components"
    )

    if not isinstance(values, dict):
        raise KernelCtlError(
            "treeforge-bootstrap profile has no "
            "treeforge_components map"
        )

    if set(values) != set(
        TREEFORGE_KERNEL_COMPONENT_KEYS
    ):
        raise KernelCtlError(
            "treeforge_components keys changed: "
            + repr(sorted(values))
        )

    result = {}

    for key in TREEFORGE_KERNEL_COMPONENT_KEYS:
        value = values.get(key)

        if (
            not isinstance(value, str)
            or not value
            or len(value) > 64
            or not re.fullmatch(
                r"[A-Za-z0-9][A-Za-z0-9._+-]*",
                value,
            )
        ):
            raise KernelCtlError(
                "invalid TreeForge kernel component "
                f"{key}: {value!r}"
            )

        result[key] = value

    return result


def cleanup_treeforge_kernel_metadata() -> None:
    path = TREEFORGE_KERNEL_METADATA_SOURCE

    if not path.exists():
        return

    text = path.read_text(
        encoding="utf-8"
    )

    if (
        TREEFORGE_KERNEL_METADATA_MARKER
        not in text
    ):
        raise KernelCtlError(
            "refusing to delete unmanaged kernel source: "
            + str(path)
        )

    path.unlink()

    print(
        "aosp: treeforge_metadata.c: "
        "GENERATED CLEANUP"
    )


def realize_treeforge_kernel_metadata(
    profile_data: dict,
) -> dict[str, str]:
    components = treeforge_kernel_components(
        profile_data
    )

    need_file(
        TREEFORGE_KERNEL_METADATA_TEMPLATE
    )

    template = (
        TREEFORGE_KERNEL_METADATA_TEMPLATE
        .read_text(
            encoding="utf-8"
        )
    )

    replacements = {
        "@TREEFORGE_RELEASE@":
            components["release"],
        "@TREEFORGE_LINUX_BASE@":
            components["linux_base"],
        "@TREEFORGE_PANTHOR@":
            components["panthor"],
        "@TREEFORGE_PANTHOR_BACKPORT@":
            components["panthor_backport"],
        "@TREEFORGE_DRM_BACKPORT@":
            components["drm_backport"],
    }

    output = template

    for token, value in replacements.items():
        if output.count(token) != 1:
            raise KernelCtlError(
                "TreeForge kernel metadata template "
                f"token count invalid: {token}"
            )

        output = output.replace(
            token,
            value,
        )

    if "@TREEFORGE_" in output:
        raise KernelCtlError(
            "TreeForge kernel metadata template "
            "contains unresolved placeholders"
        )

    path = TREEFORGE_KERNEL_METADATA_SOURCE

    if path.exists():
        existing = path.read_text(
            encoding="utf-8"
        )

        if (
            TREEFORGE_KERNEL_METADATA_MARKER
            not in existing
        ):
            raise KernelCtlError(
                "refusing to overwrite unmanaged "
                "kernel source: "
                + str(path)
            )

    path.write_text(
        output,
        encoding="utf-8",
    )

    print()
    print("TreeForge kernel components")
    print("---------------------------")

    for key in TREEFORGE_KERNEL_COMPONENT_KEYS:
        print(
            f"{key:18} "
            f"{components[key]}"
        )

    print(
        "Generated source:   "
        + str(path.relative_to(ROOT))
    )

    return components


def normalize_managed_profile_patches() -> None:
    cleanup_treeforge_kernel_metadata()

    print()
    print("Normalizing profile-managed source")
    print("----------------------------------")

    for record in (
        all_managed_profile_patches()
    ):
        repository = record[
            "_repository_root"
        ]

        patch = record[
            "_patch_path"
        ]

        state = patch_state(
            record
        )

        print(
            f"{record['repository']}: "
            f"{patch.name}: {state}"
        )

        if state == "pristine":
            continue

        if state == "applied":
            result = git_capture(
                repository,
                "apply",
                "--reverse",
                str(patch),
            )

            if result.returncode != 0:
                raise KernelCtlError(
                    "unable to reverse managed "
                    "kernel patch:\n"
                    + result.stdout
                )

            if patch_state(record) != "pristine":
                raise KernelCtlError(
                    "kernel patch did not return "
                    "to pristine state"
                )

            continue

        if state == "repository-missing":
            continue

        if state == "base-revision-mismatch":
            continue

        raise KernelCtlError(
            "profile-managed kernel source "
            "contains an unexpected divergence:\n"
            f"  repository={repository}\n"
            f"  patch={patch}"
        )


def source_workspace_state(
    source_lock: dict,
) -> tuple[
    list[str],
    list[str],
]:
    missing = []
    mismatched = []

    for path_value, record in sorted(
        source_lock[
            "projects"
        ].items()
    ):
        expected = record.get(
            "revision"
        )

        if not isinstance(
            expected,
            str,
        ):
            raise KernelCtlError(
                "source-lock project revision "
                f"is missing: {path_value}"
            )

        repository = (
            ROOT
            / path_value
        )

        head = repository_head(
            repository
        )

        if head is None:
            missing.append(
                path_value
            )
            continue

        if head != expected:
            mismatched.append(
                f"{path_value}: "
                f"{head} != {expected}"
            )

    return (
        missing,
        mismatched,
    )


def initialize_source_workspace() -> None:
    need_command(
        "repo"
    )

    if not (
        ROOT
        / ".repo"
    ).is_dir():
        print()
        print("Initializing pinned Google source workspace")
        print("-----------------------------------------")

        run([
            "repo",
            "init",
            "-u",
            SETUP_MANIFEST_URL,
            "-b",
            SETUP_MANIFEST_BRANCH,
            "-m",
            SETUP_MANIFEST_NAME,
            "--depth=1",
        ])

    print()
    print("Syncing pinned Google source workspace")
    print("-------------------------------------")

    run([
        "repo",
        "sync",
        "-j4",
    ])


def realize_profile_source_workspace(
    source_lock: dict,
) -> None:
    # The repo setup manifest owns the complete generic Android r0.94
    # workspace. Individual TreeForge profiles may intentionally pin a
    # subset of projects to different exact commits. A generic repo sync
    # cannot realize those profile-specific locks, so switch each locked
    # repository explicitly.
    #
    # Never discard unrelated source work. Managed TreeForge patches are
    # normalized before this function is called; any remaining dirty state
    # is therefore an error.

    missing, _ = source_workspace_state(source_lock)

    if missing:
        initialize_source_workspace()

    print()
    print("Realizing selected profile source lock")
    print("--------------------------------------")

    changed = 0
    fetched = 0

    for path_value, record in sorted(
        source_lock["projects"].items()
    ):
        expected = record.get("revision")

        if not isinstance(expected, str):
            raise KernelCtlError(
                "source-lock project revision is missing: "
                f"{path_value}"
            )

        repository = ROOT / path_value
        head = repository_head(repository)

        if head is None:
            raise KernelCtlError(
                "profile source repository is missing after setup: "
                f"{path_value}"
            )

        if head == expected:
            continue

        dirty = git_capture(
            repository,
            "status",
            "--porcelain",
        )

        if dirty.returncode != 0:
            raise KernelCtlError(
                "unable to inspect profile source repository: "
                f"{repository}"
            )

        if dirty.stdout.strip():
            raise KernelCtlError(
                "refusing to switch profile source revision because "
                "the repository contains unmanaged modifications:\\n"
                f"  repository={path_value}\\n"
                f"{dirty.stdout.strip()}"
            )

        has_commit = git_capture(
            repository,
            "cat-file",
            "-e",
            f"{expected}^{{commit}}",
        )

        if has_commit.returncode != 0:
            print(f"{path_value}: FETCH {expected}")

            fetch = subprocess.run(
                [
                    "git",
                    "-C",
                    str(repository),
                    "fetch",
                    "--depth=1",
                    "origin",
                    expected,
                ],
                text=True,
                check=False,
            )

            if fetch.returncode != 0:
                raise KernelCtlError(
                    "unable to fetch exact profile source revision:\\n"
                    f"  repository={path_value}\\n"
                    f"  revision={expected}"
                )

            fetched += 1

        checkout = subprocess.run(
            [
                "git",
                "-C",
                str(repository),
                "checkout",
                "--detach",
                expected,
            ],
            text=True,
            capture_output=True,
            check=False,
        )

        if checkout.returncode != 0:
            detail = (
                checkout.stdout
                + checkout.stderr
            ).strip()

            raise KernelCtlError(
                "unable to realize exact profile source revision:\\n"
                f"  repository={path_value}\\n"
                f"  revision={expected}\\n"
                f"{detail}"
            )

        actual = repository_head(repository)

        if actual != expected:
            raise KernelCtlError(
                "profile source checkout identity mismatch:\\n"
                f"  repository={path_value}\\n"
                f"  expected={expected}\\n"
                f"  actual={actual}"
            )

        print(
            f"{path_value}: "
            f"{head[:12]} -> {expected[:12]}"
        )

        changed += 1

    print(f"Profile revisions changed: {changed}")
    print(f"Profile revisions fetched: {fetched}")


def ensure_profile_source_workspace(
    source_lock: dict,
) -> None:
    missing, mismatched = (
        source_workspace_state(
            source_lock
        )
    )

    if (
        not missing
        and not mismatched
    ):
        print()
        print("Pinned Google source workspace")
        print("------------------------------")
        print(
            f"Projects verified: "
            f"{len(source_lock['projects'])}/"
            f"{len(source_lock['projects'])}"
        )
        print("Source sync:       REUSE")
        return

    print()
    print("Pinned source workspace requires sync")
    print("-------------------------------------")

    for path in missing:
        print(
            f"MISSING: {path}"
        )

    for mismatch in mismatched:
        print(
            f"MISMATCH: {mismatch}"
        )

    realize_profile_source_workspace(
        source_lock
    )

    missing, mismatched = (
        source_workspace_state(
            source_lock
        )
    )

    if missing or mismatched:
        detail = "\n".join(
            [
                *(
                    f"missing: {value}"
                    for value in missing
                ),
                *(
                    f"mismatch: {value}"
                    for value in mismatched
                ),
            ]
        )

        raise KernelCtlError(
            "pinned Google source workspace "
            "failed verification after sync:\n"
            + detail
        )

    print(
        f"Projects verified: "
        f"{len(source_lock['projects'])}/"
        f"{len(source_lock['projects'])}"
    )
    print("Source sync:       FRESH")


def verify_source_workspace_clean(
    source_lock: dict,
) -> None:
    # TREEFORGE_METADATA_VERIFY_CLEANUP_V1
    # Generated component metadata is an ephemeral build input.
    # It must not participate in pristine Google-source checks.
    cleanup_treeforge_kernel_metadata()

    dirty = []

    for path_value in sorted(
        source_lock[
            "projects"
        ]
    ):
        repository = (
            ROOT
            / path_value
        )

        result = git_capture(
            repository,
            "status",
            "--porcelain",
        )

        if result.returncode != 0:
            raise KernelCtlError(
                "unable to inspect source repository: "
                f"{repository}"
            )

        if result.stdout.strip():
            dirty.append(
                (
                    path_value,
                    result.stdout.strip(),
                )
            )

    if dirty:
        formatted = "\n".join(
            f"{path}:\n{status}"
            for path, status in dirty
        )

        raise KernelCtlError(
            "Google source workspace contains "
            "unmanaged modifications:\n"
            + formatted
        )


def apply_selected_profile_patches(
    profile_data: dict,
) -> None:
    patches = (
        validate_profile_patch_records(
            profile_data
        )
    )

    print()
    print("Applying selected kernel profile")
    print("--------------------------------")

    if not patches:
        print("Patches: none")
        return

    for record in patches:
        repository = record[
            "_repository_root"
        ]

        patch = record[
            "_patch_path"
        ]

        head = repository_head(
            repository
        )

        if head != record[
            "base_revision"
        ]:
            raise KernelCtlError(
                "kernel patch base revision "
                "does not match:\n"
                f"  repository={repository}\n"
                f"  expected="
                f"{record['base_revision']}\n"
                f"  actual={head}"
            )

        state = patch_state(
            record
        )

        if state == "applied":
            print(
                f"{record['repository']}: "
                f"{patch.name}: REUSE"
            )
            continue

        if state != "pristine":
            raise KernelCtlError(
                "kernel profile patch cannot "
                "be applied safely:\n"
                f"  repository={repository}\n"
                f"  patch={patch}\n"
                f"  state={state}"
            )

        result = git_capture(
            repository,
            "apply",
            str(patch),
        )

        if result.returncode != 0:
            raise KernelCtlError(
                "kernel profile patch apply "
                "failed:\n"
                + result.stdout
            )

        if patch_state(
            record
        ) != "applied":
            raise KernelCtlError(
                "kernel profile patch did not "
                "reach applied state"
            )

        print(
            f"{record['repository']}: "
            f"{patch.name}: APPLY"
        )


def prepare_build_profile_source(
    profile: str,
) -> dict:
    profile_data = load_build_profile(
        profile
    )

    source_lock = (
        load_profile_source_lock(
            profile_data
        )
    )

    #
    # First return every TreeForge-managed patch to its pristine
    # pinned Google base. Unexpected user/source modifications
    # are never discarded.
    #
    normalize_managed_profile_patches()

    ensure_profile_source_workspace(
        source_lock
    )

    #
    # At this point every source repository must be pristine.
    # This prevents profile switching from silently swallowing
    # unrelated kernel development work.
    #
    verify_source_workspace_clean(
        source_lock
    )

    apply_selected_profile_patches(
        profile_data
    )

    if profile == "treeforge-bootstrap":
        realize_treeforge_kernel_metadata(
            profile_data
        )

    return profile_data


