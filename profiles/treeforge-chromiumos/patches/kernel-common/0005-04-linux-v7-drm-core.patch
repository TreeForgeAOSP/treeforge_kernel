+/*
+ * Google 6.1 KMI adapter for Linux-7 GPUVA immediate-mode locking.
+ *
+ * Linux 7 embeds the mutex in drm_gem_object. Google's frozen GKI
+ * drm_gem_object cannot grow, so drivers register equivalent
+ * driver-owned mutex storage out-of-line.
+ */
+int drm_gem_gpuva_set_lock(struct drm_gem_object *obj,
+			   struct mutex *lock);
+struct mutex *drm_gem_gpuva_get_lock(struct drm_gem_object *obj);
+
