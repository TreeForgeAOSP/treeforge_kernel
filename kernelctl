    )

    need_file(source)

    #
    # TreeForge managed Android kernel toolchain.
    #
    toolchain = Path(
        "/home/skelitonlord/.cache/treeforge/providers/kernel/"
        "android-15.0.0_r0.94/clang/"
        "clang-r487747c/bin"
    )

    clang = toolchain / "clang"
    objcopy = toolchain / "llvm-objcopy"
    objdump = toolchain / "llvm-objdump"

    need_file(clang)
    need_file(objcopy)
    need_file(objdump)

    work = (
        stage
        / ".stage0-ufs-hci-build"
    )

    if work.exists():
        shutil.rmtree(work)

    work.mkdir(
        parents=True,
        exist_ok=False,
    )

    obj = work / "ufs_hci_gate.o"
    binary = work / "ufs_hci_gate.bin"
    disassembly = work / "ufs_hci_gate.disasm.txt"
    relocations = work / "ufs_hci_gate.reloc.txt"

    run([
        clang,
        "--target=aarch64-linux-gnu",
        "-c",
        source,
        "-o",
        obj,
    ])

    reloc = run(
        [
            objdump,
            "-r",
            obj,
        ],
        capture=True,
    )

    relocations.write_text(
        reloc.stdout,
        encoding="utf-8",
    )

    if "R_AARCH64" in reloc.stdout:
        raise KernelCtlError(
            "Stage-0 UFS HCI gate contains relocations"
        )

    run([
        objcopy,
        "-O",
        "binary",
        "--only-section=.text",
        obj,
        binary,
    ])

    disasm = run(
        [
            objdump,
            "-d",
            obj,
        ],
        capture=True,
    )

    disassembly.write_text(
        disasm.stdout,
        encoding="utf-8",
    )

    payload = binary.read_bytes()

    if not payload:
        raise KernelCtlError(
            "Stage-0 UFS HCI gate binary is empty"
        )

    if len(payload) % 4:
        raise KernelCtlError(
            "Stage-0 UFS HCI gate is not instruction aligned"
        )

    if len(payload) > 512:
        raise KernelCtlError(
            "Stage-0 UFS HCI gate exceeds reserved "
            "512-byte executable tail"
