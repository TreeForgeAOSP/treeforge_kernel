#!/usr/bin/env python3

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PROJECT_ROOT = ROOT.parents[2]
PROJECT_PROVIDER_ROOT = (
    PROJECT_ROOT
    / ".providers"
)

LOCK_PATH = ROOT / "host-tools.lock.json"

DEFAULT_CACHE_ROOT = (
    PROJECT_PROVIDER_ROOT
)

DEFAULT_ARCHIVE_CACHE = (
    PROJECT_PROVIDER_ROOT
    / ".archives"
)

DEFAULT_CONTRACT = (
    PROJECT_PROVIDER_ROOT
    / ".state"
    / "treeforge-tools.json"
)

TOOL_MAP = {
    "mkbootimg": (
        "android-image-tools",
        "mkbootimg",
    ),
    "unpack_bootimg": (
        "android-image-tools",
        "unpack_bootimg",
    ),
    "avbtool": (
        "avbtool",
        "avbtool",
    ),
    "adb": (
        "treeforge-adb",
        "adb",
    ),
    "fastboot": (
        "treeforge-fastboot",
        "fastboot",
    ),
}

HASH_FAMILIES = (
    "executables",
    "runtime_files",
    "legal_files",
    "provenance_files",
)

PAYLOAD_FAMILIES = {
    "executables",
    "runtime_files",
}


class ToolError(RuntimeError):
    pass


def sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(
            lambda: stream.read(1024 * 1024),
            b"",
        ):
            digest.update(chunk)

    return digest.hexdigest()


def load_json(path: Path) -> dict:
    if not path.is_file():
        raise ToolError(
            f"required JSON file missing: {path}"
        )

    try:
        data = json.loads(
            path.read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as error:
        raise ToolError(
            f"unable to read JSON {path}: {error}"
        ) from error

    if not isinstance(data, dict):
        raise ToolError(
            f"JSON root must be an object: {path}"
        )

    return data


def load_lock() -> dict:
    data = load_json(LOCK_PATH)

    if data.get("schema") != 1:
        raise ToolError(
            "unsupported host-tool lock schema: "
            f"{data.get('schema')!r}"
        )

    if (
        data.get("family")
        != "treeforge-kernel-host-tools-release-lock"
    ):
        raise ToolError(
            "unexpected host-tool lock family"
        )

    providers = data.get("providers")

    if not isinstance(providers, dict):
        raise ToolError(
            "host-tool lock contains no providers"
        )

    required = {
        provider
        for provider, _ in TOOL_MAP.values()
    }

    missing = sorted(
        required.difference(providers)
    )

    if missing:
        raise ToolError(
            "host-tool lock missing providers: "
            + ", ".join(missing)
        )

    return data


def provider_lock(
    lock: dict,
    provider: str,
) -> dict:
    record = lock["providers"].get(provider)

    if not isinstance(record, dict):
        raise ToolError(
            f"{provider}: lock record missing"
        )

    for field in (
        "release",
        "release_tag",
        "archive",
        "archive_sha256",
    ):
        value = record.get(field)

        if not isinstance(value, str) or not value:
            raise ToolError(
                f"{provider}: lock field missing: "
                f"{field}"
            )

    digest = record["archive_sha256"]

    if (
        len(digest) != 64
        or any(
            char not in "0123456789abcdef"
            for char in digest
        )
    ):
        raise ToolError(
            f"{provider}: invalid archive SHA-256"
        )

    return record


def provider_manifest(
    provider: str,
    lock_record: dict,
) -> tuple[Path, dict]:
    release = lock_record["release"]

    path = (
        ROOT
        / "providers"
        / provider
        / release
        / "manifest.json"
    )

    data = load_json(path)

    if data.get("schema") != 2:
        raise ToolError(
            f"{provider}: expected schema 2, got "
            f"{data.get('schema')!r}"
        )

    if data.get("name") != provider:
        raise ToolError(
            f"{provider}: manifest identity mismatch"
        )

    if data.get("release") != release:
        raise ToolError(
            f"{provider}: manifest release mismatch"
        )

    if data.get("platform") != "linux":
        raise ToolError(
            f"{provider}: expected linux provider"
        )

    if data.get("architecture") != "x86_64":
        raise ToolError(
            f"{provider}: expected x86_64 provider"
        )

    return path, data


def executable_record(
    manifest: dict,
    executable: str,
) -> dict:
    records = manifest.get("executables")

    if not isinstance(records, list):
        raise ToolError(
            "provider manifest has no executable list"
        )

    matches = [
        record
        for record in records
        if isinstance(record, dict)
        and record.get("name") == executable
    ]

    if len(matches) != 1:
        raise ToolError(
            f"expected exactly one executable record "
            f"for {executable}; found {len(matches)}"
        )

    record = matches[0]

    if not record.get("path"):
        raise ToolError(
            f"{executable}: manifest path missing"
        )

    if not record.get("sha256"):
        raise ToolError(
            f"{executable}: manifest SHA-256 missing"
        )

    return record


def provider_cache_root(
    *,
    cache_root: Path,
    provider: str,
    lock_record: dict,
) -> Path:
    return (
        cache_root.expanduser()
        / provider
        / lock_record["release"]
    )


def provider_payload_root(root: Path) -> Path:
    payload = root / "payload"

    if payload.is_dir():
        return payload

    return root


def provider_record_path(
    *,
    root: Path,
    family: str,
    relative: str,
) -> Path:
    if family in PAYLOAD_FAMILIES:
        payload_path = (
            root
            / "payload"
            / relative
        )

        legacy_path = root / relative

        if (
            payload_path.exists()
            or not legacy_path.exists()
        ):
            return payload_path

        return legacy_path

    return root / relative


def iter_hash_records(manifest: dict):
    for family in HASH_FAMILIES:
        records = manifest.get(family, [])

        if not isinstance(records, list):
            raise ToolError(
                f"manifest field is not a list: "
                f"{family}"
            )

        for record in records:
            if not isinstance(record, dict):
                raise ToolError(
                    f"invalid record in {family}"
                )

            relative = record.get("path")
            expected = record.get("sha256")

            if not relative or not expected:
                raise ToolError(
                    f"incomplete hash record in "
                    f"{family}"
                )

            yield (
                family,
                relative,
                expected,
            )


def verify_provider(
    *,
    provider: str,
    root: Path,
    manifest: dict,
) -> None:
    if not root.is_dir():
        raise ToolError(
            f"{provider}: provider root missing: "
            f"{root}"
        )

    checked = 0

    for family, relative, expected in (
        iter_hash_records(manifest)
    ):
        path = provider_record_path(
            root=root,
            family=family,
            relative=relative,
        )

        if not path.is_file():
            raise ToolError(
                f"{provider}: missing {family} file: "
                f"{relative}"
            )

        actual = sha256(path)

        if actual != expected:
            raise ToolError(
                f"{provider}: hash mismatch: "
                f"{relative}\n"
                f"expected={expected}\n"
                f"actual={actual}"
            )

        checked += 1

    if checked == 0:
        raise ToolError(
            f"{provider}: manifest contains no "
            "verifiable records"
        )


def provider_state(
    *,
    provider: str,
    cache_root: Path,
    lock_record: dict,
    manifest: dict,
) -> tuple[str, Path]:
    root = provider_cache_root(
        cache_root=cache_root,
        provider=provider,
        lock_record=lock_record,
    )

    if not root.exists():
        return "MISSING", root

    if not root.is_dir():
        return "INVALID_CACHE", root

    try:
        verify_provider(
            provider=provider,
            root=root,
            manifest=manifest,
        )
    except ToolError:
        return "INVALID_CACHE", root

    return "CACHED", root


def verify_archive(
    *,
    provider: str,
    archive: Path,
    expected: str,
) -> None:
    if not archive.is_file():
        raise ToolError(
            f"{provider}: archive missing: "
            f"{archive}"
        )

    actual = sha256(archive)

    if actual != expected:
        raise ToolError(
            f"{provider}: archive SHA-256 mismatch\n"
            f"archive={archive}\n"
            f"expected={expected}\n"
            f"actual={actual}"
        )


def resolve_release_repository(
    *,
    args: argparse.Namespace,
    lock: dict,
) -> str | None:
    if args.release_repository:
        return args.release_repository

    environment = os.environ.get(
        "TREEFORGE_RELEASE_REPOSITORY"
    )

    if environment:
        return environment

    configured = lock.get(
        "release_repository"
    )

    if isinstance(configured, str) and configured:
        return configured

    return None


def resolve_asset_dir(
    args: argparse.Namespace,
) -> Path | None:
    if args.asset_dir is not None:
        return args.asset_dir.expanduser().resolve()

    environment = os.environ.get(
        "TREEFORGE_PROVIDER_ASSET_DIR"
    )

    if environment:
        return (
            Path(environment)
            .expanduser()
            .resolve()
        )

    return None


def release_asset_url(
    *,
    repository: str,
    tag: str,
    archive: str,
) -> str:
    repository = repository.strip().strip("/")

    if (
        not repository
        or repository.count("/") != 1
    ):
        raise ToolError(
            "release repository must have "
            "OWNER/REPO form"
        )

    encoded_tag = urllib.parse.quote(
        tag,
        safe="",
    )

    encoded_archive = urllib.parse.quote(
        archive,
        safe="",
    )

    return (
        f"https://github.com/{repository}"
        f"/releases/download/{encoded_tag}"
        f"/{encoded_archive}"
    )


def download_archive(
    *,
    provider: str,
    url: str,
    destination: Path,
    expected: str,
) -> Path:
    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    if destination.exists():
        verify_archive(
            provider=provider,
            archive=destination,
            expected=expected,
        )

        print(
            f"{provider}: archive cached ✓"
        )
        print(
            f"  archive: {destination}"
        )

        return destination

    temporary = destination.parent / (
        f".{destination.name}.partial-"
        f"{os.getpid()}"
    )

    if temporary.exists():
        temporary.unlink()

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": (
                "TreeForge-Kernel-Provider/1"
            )
        },
    )

    print(
        f"{provider}: downloading exact release asset"
    )
    print(f"  url: {url}")

    try:
        with urllib.request.urlopen(
            request,
            timeout=120,
        ) as response:
            with temporary.open("wb") as stream:
                shutil.copyfileobj(
                    response,
                    stream,
                )

        verify_archive(
            provider=provider,
            archive=temporary,
            expected=expected,
        )

        temporary.rename(destination)

    except (
        OSError,
        urllib.error.URLError,
        urllib.error.HTTPError,
        ToolError,
    ) as error:
        if temporary.exists():
            temporary.unlink()

        raise ToolError(
            f"{provider}: release asset "
            f"download failed: {error}"
        ) from error

    return destination


def acquire_archive(
    *,
    args: argparse.Namespace,
    lock: dict,
    provider: str,
    lock_record: dict,
) -> Path:
    archive_name = lock_record["archive"]
    expected = lock_record[
        "archive_sha256"
    ]

    asset_dir = resolve_asset_dir(args)

    if asset_dir is not None:
        archive = (
            asset_dir
            / archive_name
        )

        verify_archive(
            provider=provider,
            archive=archive,
            expected=expected,
        )

        print(
            f"{provider}: using locked local asset"
        )
        print(
            f"  archive: {archive}"
        )

        return archive

    archive_cache = (
        args.archive_cache
        .expanduser()
        .resolve()
    )

    cached_archive = (
        archive_cache
        / archive_name
    )

    if cached_archive.exists():
        verify_archive(
            provider=provider,
            archive=cached_archive,
            expected=expected,
        )

        print(
            f"{provider}: using cached archive"
        )
        print(
            f"  archive: {cached_archive}"
        )

        return cached_archive

    repository = resolve_release_repository(
        args=args,
        lock=lock,
    )

    if repository is None:
        raise ToolError(
            f"{provider}: provider cache is empty "
            "and no acquisition source is configured.\n"
            "Use --asset-dir DIR or "
            "TREEFORGE_PROVIDER_ASSET_DIR for "
            "local release assets, or configure "
            "--release-repository OWNER/REPO / "
            "TREEFORGE_RELEASE_REPOSITORY after "
            "the locked releases are published."
        )

    url = release_asset_url(
        repository=repository,
        tag=lock_record["release_tag"],
        archive=archive_name,
    )

    return download_archive(
        provider=provider,
        url=url,
        destination=cached_archive,
        expected=expected,
    )


def extracted_package_root(
    extraction: Path,
) -> Path:
    if (extraction / "payload").is_dir():
        return extraction

    children = list(
        extraction.iterdir()
    )

    directories = [
        child
        for child in children
        if child.is_dir()
    ]

    files = [
        child
        for child in children
        if child.is_file()
    ]

    if (
        not files
        and len(directories) == 1
        and (
            directories[0]
            / "payload"
        ).is_dir()
    ):
        return directories[0]

    raise ToolError(
        "unable to identify provider package "
        "root after archive extraction"
    )


def install_provider(
    *,
    args: argparse.Namespace,
    lock: dict,
    provider: str,
    lock_record: dict,
    manifest: dict,
) -> Path:
    destination = provider_cache_root(
        cache_root=args.cache_root,
        provider=provider,
        lock_record=lock_record,
    )

    if destination.exists():
        verify_provider(
            provider=provider,
            root=destination,
            manifest=manifest,
        )

        return destination

    archive = acquire_archive(
        args=args,
        lock=lock,
        provider=provider,
        lock_record=lock_record,
    )

    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temporary_cache = (
        destination.parent
        / (
            f".{destination.name}.partial-"
            f"{os.getpid()}"
        )
    )

    if temporary_cache.exists():
        shutil.rmtree(temporary_cache)

    try:
        with tempfile.TemporaryDirectory(
            prefix=(
                f"treeforge-{provider}-"
            )
        ) as temporary_directory:
            extraction = Path(
                temporary_directory
            )

            with tarfile.open(
                archive,
                mode="r:xz",
            ) as package:
                package.extractall(
                    extraction,
                    filter="data",
                )

            source = extracted_package_root(
                extraction
            )

            verify_provider(
                provider=provider,
                root=source,
                manifest=manifest,
            )

            shutil.copytree(
                source,
                temporary_cache,
                symlinks=True,
            )

        verify_provider(
            provider=provider,
            root=temporary_cache,
            manifest=manifest,
        )

        temporary_cache.rename(
            destination
        )

    except Exception:
        if temporary_cache.exists():
            shutil.rmtree(
                temporary_cache
            )

        raise

    print(
        f"{provider}: provider cache populated ✓"
    )
    print(
        f"  path: {destination}"
    )

    return destination


def resolve_all(
    *,
    args: argparse.Namespace,
    prepare: bool,
) -> dict:
    lock = load_lock()

    loaded: dict[
        str,
        tuple[Path, dict, dict, Path]
    ] = {}

    provider_roots = {}
    library_dirs = []
    resolved_tools = {}

    for tool, (
        provider,
        executable,
    ) in TOOL_MAP.items():

        if provider not in loaded:
            lock_record = provider_lock(
                lock,
                provider,
            )

            manifest_path, manifest = (
                provider_manifest(
                    provider,
                    lock_record,
                )
            )

            if prepare:
                root = install_provider(
                    args=args,
                    lock=lock,
                    provider=provider,
                    lock_record=lock_record,
                    manifest=manifest,
                )
            else:
                state, root = provider_state(
                    provider=provider,
                    cache_root=args.cache_root,
                    lock_record=lock_record,
                    manifest=manifest,
                )

                if state != "CACHED":
                    raise ToolError(
                        f"{provider}: {state}: "
                        f"{root}"
                    )

                verify_provider(
                    provider=provider,
                    root=root,
                    manifest=manifest,
                )

            loaded[provider] = (
                manifest_path,
                manifest,
                lock_record,
                root,
            )

            provider_roots[
                provider
            ] = str(root)

            lib64 = (
                provider_payload_root(root)
                / "lib64"
            )

            if lib64.is_dir():
                library_dirs.append(
                    str(lib64)
                )

        (
            manifest_path,
            manifest,
            lock_record,
            root,
        ) = loaded[provider]

        record = executable_record(
            manifest,
            executable,
        )

        path = provider_record_path(
            root=root,
            family="executables",
            relative=record["path"],
        )

        actual = sha256(path)
        expected = record["sha256"]

        if actual != expected:
            raise ToolError(
                f"{tool}: executable "
                "SHA-256 mismatch"
            )

        if not os.access(path, os.X_OK):
            raise ToolError(
                f"{tool}: executable bit "
                f"missing: {path}"
            )

        resolved_tools[tool] = {
            "provider": provider,
            "release": (
                lock_record["release"]
            ),
            "release_tag": (
                lock_record["release_tag"]
            ),
            "archive": (
                lock_record["archive"]
            ),
            "archive_sha256": (
                lock_record[
                    "archive_sha256"
                ]
            ),
            "manifest": str(
                manifest_path
            ),
            "path": str(path),
            "sha256": actual,
        }

    return {
        "schema": 1,
        "family": (
            "treeforge-kernel-host-tools"
        ),
        "release_lock": str(
            LOCK_PATH
        ),
        "source_repository": lock.get(
            "source_repository"
        ),
        "source_commit": lock.get(
            "source_commit"
        ),
        "provider_roots": (
            provider_roots
        ),
        "runtime": {
            "library_dirs": sorted(
                set(library_dirs)
            )
        },
        "tools": resolved_tools,
    }


def command_status(
    args: argparse.Namespace,
) -> int:
    lock = load_lock()

    print("TreeForge Kernel Host Tools")
    print()
    print(
        f"Cache: "
        f"{args.cache_root.expanduser().resolve()}"
    )
    print()

    providers_seen = set()

    for tool, (
        provider,
        executable,
    ) in TOOL_MAP.items():

        lock_record = provider_lock(
            lock,
            provider,
        )

        _, manifest = provider_manifest(
            provider,
            lock_record,
        )

        state, root = provider_state(
            provider=provider,
            cache_root=args.cache_root,
            lock_record=lock_record,
            manifest=manifest,
        )

        if provider not in providers_seen:
            print(
                f"{provider:24s} "
                f"{state:14s} "
                f"{root}"
            )

            providers_seen.add(provider)

        if state == "CACHED":
            record = executable_record(
                manifest,
                executable,
            )

            path = provider_record_path(
                root=root,
                family="executables",
                relative=record["path"],
            )

            okay = (
                path.is_file()
                and sha256(path)
                == record["sha256"]
            )

            print(
                f"  {tool:20s} "
                f"{'READY' if okay else 'FAIL':6s} "
                f"{path}"
            )

    return 0


def command_prepare(
    args: argparse.Namespace,
) -> int:
    result = resolve_all(
        args=args,
        prepare=True,
    )

    contract = (
        args.contract
        .expanduser()
        .resolve()
    )

    contract.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    contract.write_text(
        json.dumps(
            result,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    print()
    print("TreeForge Kernel Host Tools")
    print()

    for name, record in (
        result["tools"].items()
    ):
        print(
            f"{name:20s} READY "
            f"{record['path']}"
        )

    print()
    print(
        f"Resolved contract: "
        f"{contract}"
    )

    return 0


def command_verify(
    args: argparse.Namespace,
) -> int:
    result = resolve_all(
        args=args,
        prepare=False,
    )

    print(
        "TreeForge Kernel Host Tool "
        "Verification"
    )
    print()

    for name, record in (
        result["tools"].items()
    ):
        print(
            f"{name:20s} PASS  "
            f"{record['sha256']}"
        )

    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Resolve pinned TreeForge kernel "
            "host-tool providers."
        )
    )

    parser.add_argument(
        "--cache-root",
        type=Path,
        default=DEFAULT_CACHE_ROOT,
        help=(
            "materialized host-provider cache "
            f"(default: {DEFAULT_CACHE_ROOT})"
        ),
    )

    parser.add_argument(
        "--archive-cache",
        type=Path,
        default=DEFAULT_ARCHIVE_CACHE,
        help=(
            "downloaded provider archive cache "
            f"(default: {DEFAULT_ARCHIVE_CACHE})"
        ),
    )

    parser.add_argument(
        "--contract",
        type=Path,
        default=DEFAULT_CONTRACT,
        help=(
            "resolved kernel host-tool "
            f"contract (default: "
            f"{DEFAULT_CONTRACT})"
        ),
    )

    parser.add_argument(
        "--asset-dir",
        type=Path,
        help=(
            "directory containing locked "
            "provider release archives"
        ),
    )

    parser.add_argument(
        "--release-repository",
        help=(
            "GitHub release repository in "
            "OWNER/REPO form"
        ),
    )

    parser.add_argument(
        "command",
        choices=(
            "status",
            "prepare",
            "verify",
        ),
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    try:
        if args.command == "status":
            return command_status(args)

        if args.command == "prepare":
            return command_prepare(args)

        if args.command == "verify":
            return command_verify(args)

        raise ToolError(
            f"unsupported command: "
            f"{args.command}"
        )

    except ToolError as error:
        print(
            f"kernel-treeforge-tools: "
            f"{error}",
            file=sys.stderr,
        )

        return 2


if __name__ == "__main__":
    raise SystemExit(main())
