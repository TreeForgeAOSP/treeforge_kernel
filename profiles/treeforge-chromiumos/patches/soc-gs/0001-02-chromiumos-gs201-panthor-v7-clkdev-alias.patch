+/*
+ * TREEFORGE_GS201_GPU_CLKDEV
+ *
+ * The shared Android GPU DT intentionally stays arm,malit6xx
+ * and has no generic CCF "clocks" property.
+ *
+ * The ChromiumOS profile already exposes the two CAL-backed
+ * GS201 GPU DVFS clocks through CCF. Publish lookup aliases for
+ * the existing platform device so Panthor can consume them with:
+ *
+ *   devm_clk_get(dev, NULL)         -> G3D
+ *   devm_clk_get(dev, "coregroup")  -> G3DL2
+ *
+ * Linux 7.0 Panthor also probes the optional "stacks" clock.
+ * GS201 has no separate stacks DVFS domain in this bridge, so
+ * that optional lookup is intentionally left unresolved.
+ *
+ * No device-tree mutation and no direct Panthor -> CAL coupling.
+ */
+static void
+treeforge_gs201_gpu_clkdev_alias(struct clk *clk, const char *name)
+{
+	const char *con_id;
+	int ret;
+
+	if (IS_ERR_OR_NULL(clk) || !name)
+		return;
+
+	if (!strcmp(name, "CLK_G3D_DVFS"))
+		con_id = NULL;
+	else if (!strcmp(name, "CLK_G3DL2_DVFS"))
+		con_id = "coregroup";
+	else
+		return;
+
+	ret = clk_register_clkdev(
+		clk,
+		con_id,
+		"28000000.mali");
+
+	if (ret) {
+		pr_warn(
+			"TreeForge: GS201 GPU clkdev alias %s failed: %d\n",
+			name,
+			ret);
+		return;
+	}
+
+	pr_info(
+		"TREEFORGE_GS201_GPU_CLKDEV "
+		"%s dev=28000000.mali con=%s\n",
+		name,
+		con_id ? con_id : "<default>");
+}
