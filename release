#!/usr/bin/env bash
# TreeForge repository-local release/publishing workflow (normalized).
# Component-specific ./release prepare continues to use the original lifecycle.
if [[ $# -eq 0 || "${1:-}" == "publish" || "${1:-}" == "verify" || "${1:-}" == "status" || "${1:-}" == "resume" ]]; then
    _tf_release_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    exec python3 "$_tf_release_root/scripts/treeforge_release_workflow.py" "$@"
fi
set -euo pipefail

ROOT="$(
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd
)"

cd "$ROOT"

VERSION_FILE="$ROOT/VERSION"

if [ ! -f "$VERSION_FILE" ]; then
    echo "ERROR: VERSION missing" >&2
    exit 1
fi

VERSION="$(
    tr -d '[:space:]' < "$VERSION_FILE"
)"

if [ -z "$VERSION" ]; then
    echo "ERROR: VERSION is empty" >&2
    exit 1
fi

MODE="${1:-prepare}"
FORCE=0

case "$MODE" in
    prepare)
        shift || true

        if [ "${1:-}" = "--force" ]; then
            FORCE=1
            shift
        fi
        ;;
    publish)
        shift || true

        if [ "${1:-}" = "--force" ]; then
            echo "ERROR: --force is only valid with prepare" >&2
            exit 2
        fi
        ;;
    *)
        echo "Usage: ./release [prepare [--force]|publish]" >&2
        exit 2
        ;;
esac

if [ "$#" -ne 0 ]; then
    echo "Usage: ./release [prepare [--force]|publish]" >&2
    exit 2
fi

find_generation() {
    python3 - "$ROOT" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
source = root / "out" / "source"

if not source.is_dir():
    raise SystemExit(
        "no out/source directory; build treeforge-bootstrap first"
    )

accepted = []

for generation in source.iterdir():
    if not generation.is_dir():
        continue

    package = generation / "package"

    signed_panthor = (
        generation
        / "raw"
        / "panthor-signed"
    )

    required = (
        package / "boot.img",
        package / "vendor_kernel_boot.img",
        package / "vendor_dlkm.img",
        package / "system_dlkm.img",
        signed_panthor / "manifest.json",
        signed_panthor / "gpu-sched.ko",
        signed_panthor / "drm_exec.ko",
        signed_panthor / "drm_gpuvm.ko",
        signed_panthor / "panthor.ko",
    )

    if not all(path.is_file() for path in required):
        continue

    metadata = generation / "metadata" / "build.json"

    if metadata.is_file():
        try:
            data = json.loads(
                metadata.read_text(encoding="utf-8")
            )
        except Exception:
            continue

        if data.get("build_profile") != "treeforge-bootstrap":
            continue

    accepted.append(generation)

if not accepted:
    raise SystemExit(
        "no completed treeforge-bootstrap generation found"
    )

accepted.sort(
    key=lambda path: (
        path.stat().st_mtime_ns,
        path.name,
    )
)

print(accepted[-1])
PY
}

echo "TreeForge Kernel release"
echo "========================"
echo "Version:    $VERSION"

if [ "$MODE" = "prepare" ]; then
    GENERATION="$(find_generation)"

    echo "Generation: $GENERATION"
    echo

    RELEASE_ARGS=(
        release
        --version "$VERSION"
        --generation "$GENERATION"
    )

    if [ "$FORCE" -eq 1 ]; then
        RELEASE_ARGS+=(--force)
    fi

    ./kernelctl "${RELEASE_ARGS[@]}"
else
    echo "Mode:       publish prepared assets"
    echo
fi

ASSETS="$ROOT/out/releases/$VERSION/assets"

if [ ! -d "$ASSETS" ]; then
    echo "ERROR: prepared release assets missing: $ASSETS" >&2
    echo "Run ./release first." >&2
    exit 1
fi

for name in \
    boot.img \
    module-provider.json \
    SHA256SUMS
do
    if [ ! -f "$ASSETS/$name" ]; then
        echo "ERROR: missing release asset: $name" >&2
        exit 1
    fi
done

mapfile -t MODULE_ARCHIVES < <(
    find "$ASSETS" \
        -maxdepth 1 \
        -type f \
        -name 'treeforge-kernel-modules-*.tar.zst' \
        -print
)

if [ "${#MODULE_ARCHIVES[@]}" -ne 1 ]; then
    echo "ERROR: expected exactly one module archive" >&2
    exit 1
fi

mapfile -t PANTHOR_ARCHIVES < <(
    find "$ASSETS" \
        -maxdepth 1 \
        -type f \
        -name 'treeforge-kernel-panthor-*.tar.zst' \
        -print
)

if [ "${#PANTHOR_ARCHIVES[@]}" -ne 1 ]; then
    echo "ERROR: expected exactly one Panthor provider archive" >&2
    exit 1
fi

(
    cd "$ASSETS"
    sha256sum -c SHA256SUMS
)

python3 - \
    "$ASSETS/module-provider.json" \
    "$VERSION" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
version = sys.argv[2]

data = json.loads(
    path.read_text(encoding="utf-8")
)

assert (
    data["schema"]
    == "treeforge.kernel.module-provider.v2"
)

assert data["release"] == version

recon = data["reconstruction"]

assert recon["carrier_source"] == "current-installed"
assert recon["carrier_policy"] == "patch-current"
assert recon["non_module_payload"] == "preserve-exact"
assert recon["module_tree_policy"] == "replace-exact"
assert recon["regenerate_module_metadata"] is True
assert recon["partition_images_distributed"] is False

for carrier in (
    "vendor_kernel_boot",
    "vendor_dlkm",
    "system_dlkm",
):
    policy = recon["carriers"][carrier]

    assert (
        policy["non_module_payload"]
        == "preserve-exact"
    )

    assert (
        policy["module_tree_policy"]
        == "replace-exact"
    )

print("PROVIDER_CONTRACT=PASS")
PY

grep -q \
    'authoritative for the TreeForge release identity' \
    README.md

grep -q \
    'Non-module content is preserved' \
    README.md

grep -q \
    'matching signed four-module Panthor family' \
    README.md

grep -q \
    'Owner AVB does not re-sign kernel modules' \
    README.md

echo "README_CONTRACT=PASS"
echo "CHECKSUMS=PASS"

if [ "$MODE" = "prepare" ]; then
    echo
    echo "RELEASE_PREPARE=PASS"
    echo "ASSETS=$ASSETS"
    exit 0
fi
