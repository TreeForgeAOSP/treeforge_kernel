def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(
            lambda: stream.read(1024 * 1024),
            b"",
        ):
            digest.update(chunk)

    return digest.hexdigest()


def load_build_profile(
    profile: str,
) -> dict:
    path = build_profile_path(
        profile
    )

    need_file(path)

    try:
        data = json.loads(
            path.read_text(
                encoding="utf-8"
            )
        )
    except Exception as error:
        raise KernelCtlError(
            f"invalid kernel profile JSON: "
            f"{path}: {error}"
        ) from error

    if data.get("schema") != 1:
        raise KernelCtlError(
            f"unsupported kernel profile schema: "
            f"{data.get('schema')}"
        )

    if data.get("id") != profile:
        raise KernelCtlError(
            "kernel profile identity mismatch: "
            f"{data.get('id')} != {profile}"
        )

    if (
        data.get("kernel_release")
        != KERNEL_PROVIDER_RELEASE
    ):
        raise KernelCtlError(
            "kernel profile release mismatch: "
            f"{data.get('kernel_release')} != "
            f"{KERNEL_PROVIDER_RELEASE}"
        )

    source_lock_value = data.get(
        "source_lock"
    )

    if not isinstance(
        source_lock_value,
        str,
    ):
        raise KernelCtlError(
            "kernel profile source_lock is missing"
        )

    source_lock = (
        ROOT
        / source_lock_value
    )

    need_file(source_lock)

    data["_profile_path"] = path
    data["_source_lock_path"] = source_lock

    if profile == "treeforge-bootstrap":
        treeforge_kernel_components(
            data
        )

    return data


