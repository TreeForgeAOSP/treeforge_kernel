def flash_command(argv) -> int:
    parser = argparse.ArgumentParser(
        prog="kernelctl flash",
        description=(
            "Flash a verified TreeForge kernel package"
        ),
    )

    parser.add_argument(
        "--generation",
        help=(
            "generation timestamp/path; "
            "default: newest accepted package"
        ),
    )

    parser.add_argument(
        "--slot",
        choices=("a", "b", "both"),
        help=(
            "slot to flash; omit for interactive choice"
        ),
    )

    parser.add_argument(
        "--active",
        choices=("keep", "a", "b"),
        default="keep",
        help=(
            "active slot after flashing; default: keep"
        ),
    )

    parser.add_argument(
        "--reboot",
        action="store_true",
        help=(
            "reboot Android after successful flash; "
            "default: leave in bootloader"
        ),
    )

    parser.add_argument(
        "--plan-only",
        action="store_true",
        help=(
            "validate package and print flash plan "
            "without invoking ADB/Fastboot"
        ),
    )

    args = parser.parse_args(argv)

    generation, package, metadata = (
        resolve_flash_generation(
            args.generation
        )
    )

    print_verified_flash_plan(
        generation,
        package,
        metadata,
        slot=args.slot,
        active=args.active,
        reboot=args.reboot,
    )

    if args.plan_only:
        print()
        print("Execution")
        print("---------")
        print("FLASH STARTED: NO")
        print("ADB INVOKED: NO")
        print("FASTBOOT INVOKED: NO")
        print("DEVICE MODIFIED: NO")
        return 0

    #
    # Only after the complete package has passed integrity
    # validation do we prepare the exact TreeForge ADB/Fastboot
    # providers.
    #
    prepare_flash_host_tools()

    slot = args.slot

    if slot is None:
        slot = choose(
            "Flash target slot:",
            [
                ("Slot A", "a"),
                ("Slot B", "b"),
                ("Both slots A + B", "both"),
            ],
        )

        active = choose(
            "Active slot after flashing:",
            [
                (
                    "Keep current active slot",
                    "keep",
                ),
                ("Set slot A active", "a"),
                ("Set slot B active", "b"),
            ],
        )

        reboot = choose(
            "Reboot Android after flashing?",
            [
                (
                    "No - leave in bootloader",
                    False,
                ),
                ("Yes", True),
            ],
        )
    else:
        active = args.active
        reboot = args.reboot

    #
    # flash() retains the explicit final:
    #
    #   Proceed with flash? [y/N]
    #
    # confirmation before touching the device.
    #
    flash(
        package,
        slot,
        active,
        reboot,
    )

    return 0



def detect_transport():
    adb = subprocess.run(
        ["adb", "get-state"],
        text=True,
        capture_output=True,
    )

    if adb.returncode == 0 and "device" in adb.stdout:
        return "adb"

    fb = subprocess.run(
        ["fastboot", "devices"],
        text=True,
        capture_output=True,
    )

    if fb.stdout.strip():
        userspace = subprocess.run(
            ["fastboot", "getvar", "is-userspace"],
            text=True,
            capture_output=True,
        )

        text = userspace.stdout + userspace.stderr

        if "yes" in text:
            return "fastbootd"

        return "bootloader"

    return "none"


def ensure_bootloader():
    transport = detect_transport()

    if transport == "adb":
        run(["adb", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "fastbootd":
        run(["fastboot", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "bootloader":
        pass

    else:
        raise KernelCtlError("no ADB/Fastboot device detected")

    product = output(["fastboot", "getvar", "product"])

    if DEVICE not in product:
        raise KernelCtlError(
            f"refusing to flash non-{DEVICE} device"
        )

    unlocked = output(["fastboot", "getvar", "unlocked"])

    if "yes" not in unlocked.lower():
        raise KernelCtlError("device bootloader is not unlocked")


def ensure_fastbootd():
    ensure_bootloader()

    run(["fastboot", "reboot", "fastboot"])
    time.sleep(5)

    state = output(["fastboot", "getvar", "is-userspace"])

    if "yes" not in state.lower():
        raise KernelCtlError("failed to enter fastbootd")


def flash(stage: Path, slot: str, active: str, reboot: bool):
    if slot not in ("a", "b", "both"):
        raise KernelCtlError("flash slot must be a, b, or both")

    slots = ("a", "b") if slot == "both" else (slot,)

    if active not in ("keep", "a", "b"):
        raise KernelCtlError("active slot must be keep, a, or b")

    print()
    print("FLASH PLAN")
    print("----------")
    print(f"Target slot:       {slot.upper() if slot != 'both' else 'A + B'}")
    print(f"Active after:      {active}")
    print(f"Reboot Android:    {'YES' if reboot else 'NO'}")
    print()
    print("Physical:")
    for target_slot in slots:
        print(f"  boot_{target_slot}")
        print(f"  init_boot_{target_slot}")
        print(f"  dtbo_{target_slot}")
        print(f"  vendor_boot_{target_slot}")
        print(f"  vendor_kernel_boot_{target_slot}")
        print(f"  vbmeta_{target_slot}")
        print(f"  vbmeta_system_{target_slot}")
        print(f"  vbmeta_vendor_{target_slot}")

    print()
    print("Logical:")
    for target_slot in slots:
        print(f"  vendor_dlkm_{target_slot}")
        print(f"  system_dlkm_{target_slot}")
    print()

    while True:
        answer = input("Proceed with flash? [y/N]: ").strip().lower()

        if answer in ("", "n", "no"):
            print("Flash cancelled.")
            return

        if answer in ("y", "yes"):
            break

        print("Please answer yes or no.")

    ensure_bootloader()

    physical = (
        ("boot", "boot.img"),
        ("init_boot", "init_boot.img"),
        ("dtbo", "dtbo.img"),
        ("vendor_boot", "vendor_boot.img"),
        ("vendor_kernel_boot", "vendor_kernel_boot.img"),
        ("vbmeta_system", "vbmeta_system.img"),
        ("vbmeta_vendor", "vbmeta_vendor.img"),
        ("vbmeta", "vbmeta.img"),
    )

    for target_slot in slots:
        for partition, filename in physical:
            run([
                "fastboot",
                "flash",
                f"{partition}_{target_slot}",
                stage / filename,
            ])

    ensure_fastbootd()

    for target_slot in slots:
        run([
            "fastboot",
            "flash",
            f"vendor_dlkm_{target_slot}",
            stage / "vendor_dlkm.img",
        ])

        run([
            "fastboot",
            "flash",
            f"system_dlkm_{target_slot}",
            stage / "system_dlkm.img",
        ])

    # Always return to bootloader before final slot/reboot choice.
    run(["fastboot", "reboot", "bootloader"])
    time.sleep(4)

    if active in ("a", "b"):
        run(["fastboot", f"--set-active={active}"])

    current = output(["fastboot", "getvar", "current-slot"])
    print(current.strip())

    if reboot:
        run(["fastboot", "reboot"])
    else:
        print("Device left in bootloader fastboot.")


def choose(prompt, choices):
    print()
    print(prompt)

    for index, (label, value) in enumerate(choices, 1):
        print(f"  {index}) {label}")

    while True:
        answer = input("> ").strip()

        try:
            index = int(answer)
        except ValueError:
            continue

        if 1 <= index <= len(choices):
            return choices[index - 1][1]


def interactive():
    provider = choose(
        "Signing provider:",
        [
            ("AOSP test keys", "aosp"),
            ("TreeForge development keys", "treeforge"),
        ],
    )

    stage = package(provider)

    do_flash = choose(
        "Flash this package?",
        [
            ("No - package only", False),
            ("Yes", True),
        ],
    )

    if not do_flash:
        return

    slot = choose(
        "Flash target slot:",
        [
            ("Slot A", "a"),
            ("Slot B", "b"),
            ("Both slots A + B", "both"),
        ],
    )

    active = choose(
        "Active slot after flashing:",
        [
            ("Keep current active slot", "keep"),
            ("Set slot A active", "a"),
