def _stage0_apply_ufs_hci_gate(
    *,
    candidate: bytes,
    manifest: dict,
    payload: bytes,
) -> tuple[bytes, dict]:
    stage0_rva = int(
        manifest["stage0_rva"],
        16,
    )

    raw_source = int(
        manifest["data_raw_size_source"],
        16,
    )

    raw_final = int(
        manifest["data_raw_size_final"],
        16,
    )

    capacity = (
        raw_final
        - raw_source
    )

    if capacity != 512:
        raise KernelCtlError(
            "Stage-0 UFS gate expected exact "
            f"512-byte executable tail, got {capacity}"
        )

    if len(payload) > capacity:
        raise KernelCtlError(
            "Stage-0 UFS gate payload exceeds "
            "reserved executable tail"
        )

    if (
        stage0_rva
        + capacity
        != len(candidate)
    ):
        raise KernelCtlError(
            "Stage-0 UFS gate Image tail geometry mismatch"
        )

    result = bytearray(candidate)

    gate1_sha = hashlib.sha256(
        result
    ).hexdigest()

    #
    # Replace only the already-proven Stage-0 executable tail.
    # PE geometry and the code1 redirect remain unchanged.
    #
    result[
        stage0_rva:
        stage0_rva + capacity
    ] = b"\x00" * capacity

    result[
        stage0_rva:
        stage0_rva + len(payload)
    ] = payload

    updated = dict(manifest)

    updated.update({
        "mode":
            "treeforge-stage0-ufs-hci-gate",
        "gate1_r2_candidate_image_sha256":
            gate1_sha,
        "candidate_image_sha256":
            hashlib.sha256(
                result
            ).hexdigest(),
        "candidate_image_bytes":
            len(result),
        "stage0_bytes":
            len(payload),
        "stage0_reserved_bytes":
            capacity,
    })

    return bytes(result), updated


def realize_stage0_proof_boot(
    *,
    boot: Path,
    generation: Path | None,
    stage: Path,
    ufs_gate: bool = False,
) -> Path:
    if generation is not None:
        _verify_stage0_generation(
            generation
        )

    tools = load_treeforge_tools_contract()

    unpack_bootimg = Path(
        tools["tools"][
            "unpack_bootimg"
        ]["path"]
    )

    need_file(unpack_bootimg)

    lz4 = need_command("lz4")

    work = (
        stage
        / ".stage0-proof-work"
    )

    if work.exists():
        shutil.rmtree(work)

    unpacked = work / "unpacked"
    verify = work / "verify"

    unpacked.mkdir(
        parents=True,
        exist_ok=False,
    )

    print()
    print("TreeForge Stage-0 proof")
    print("-----------------------")
    if generation is not None:
        print(f"Generation: {generation}")
    else:
        print(
            "Source:     Bootstrap v1.0b7 "
            "kernel provider r0.94-5"
        )

    print(f"Boot image: {boot}")
    print("Mode:       packaging-only")
    print("Source:     immutable")

    run([
        unpack_bootimg,
        "--boot_img",
        boot,
        "--out",
        unpacked,
    ])

    packed_kernel = (
        unpacked / "kernel"
    )

    need_file(packed_kernel)

    source_image = (
        work / "Image.source"
    )

    run([
        lz4,
        "-d",
        "-f",
        packed_kernel,
        source_image,
    ])

    source_bytes = (
        source_image.read_bytes()
    )

    candidate_bytes, manifest = (
        _stage0_transform_arm64_image(
            source_bytes
        )
    )

    if ufs_gate:
        (
            gate_payload,
            gate_manifest,
        ) = _stage0_build_ufs_hci_gate(
            stage=stage
        )

        (
            candidate_bytes,
            manifest,
        ) = _stage0_apply_ufs_hci_gate(
            candidate=candidate_bytes,
            manifest=manifest,
            payload=gate_payload,
        )

        manifest.update(
            gate_manifest
        )

    candidate_image = (
        work / "Image.stage0"
    )

    candidate_image.write_bytes(
        candidate_bytes
    )

    packed_candidate = (
        work / "kernel.stage0.lz4"
    )

    run([
        lz4,
        "-l",
        "-f",
        candidate_image,
        packed_candidate,
    ])

    packed_source_bytes = (
        packed_kernel.read_bytes()
    )

    packed_candidate_bytes = (
        packed_candidate.read_bytes()
    )

    boot_bytes = bytearray(
        boot.read_bytes()
    )

    if (
        len(boot_bytes) < 4096
        or boot_bytes[:8] != b"ANDROID!"
    ):
        raise KernelCtlError(
            "Stage-0 source boot image header invalid"
        )

    kernel_size = struct.unpack_from(
        "<I",
        boot_bytes,
        8,
    )[0]

    ramdisk_size = struct.unpack_from(
        "<I",
        boot_bytes,
        12,
    )[0]

    header_size = struct.unpack_from(
        "<I",
        boot_bytes,
        20,
    )[0]

    header_version = struct.unpack_from(
        "<I",
        boot_bytes,
        40,
    )[0]

    if header_version != 4:
        raise KernelCtlError(
            "Stage-0 proof requires Android boot "
            f"header v4, got {header_version}"
        )

    if ramdisk_size != 0:
        raise KernelCtlError(
            "Stage-0 proof requires zero boot ramdisk"
        )

    if header_size != 1584:
        raise KernelCtlError(
            "Stage-0 proof unexpected boot v4 "
            f"header size: {header_size}"
        )

    signature_size = struct.unpack_from(
        "<I",
        boot_bytes,
        1580,
    )[0]

    if signature_size != 0:
        raise KernelCtlError(
            "Stage-0 proof requires zero boot "
            "signature payload"
        )

    kernel_offset = 4096
    kernel_end = (
        kernel_offset
        + kernel_size
    )

    old_payload_end = _stage0_align_up(
        kernel_end,
        4096,
    )

    if kernel_end > len(boot_bytes):
        raise KernelCtlError(
            "Stage-0 source boot kernel exceeds image"
        )

    if (
        bytes(
            boot_bytes[
                kernel_offset:
                kernel_end
            ]
        )
        != packed_source_bytes
    ):
        raise KernelCtlError(
            "Stage-0 unpacked kernel does not match "
            "boot payload"
        )

    trailing = boot_bytes[
        old_payload_end:
    ]

    if any(trailing):
        raise KernelCtlError(
            "Stage-0 refuses unexpected non-zero "
            "payload after boot kernel"
        )

    new_kernel_end = (
        kernel_offset
        + len(packed_candidate_bytes)
    )

    new_payload_end = _stage0_align_up(
        new_kernel_end,
        4096,
    )

    output_size = max(
        len(boot_bytes),
        new_payload_end,
    )

    rebuilt = bytearray(
        boot_bytes[:kernel_offset]
    )

    rebuilt.extend(
        packed_candidate_bytes
    )

    rebuilt.extend(
        b"\x00"
        * (
            output_size
            - len(rebuilt)
        )
    )

    struct.pack_into(
        "<I",
        rebuilt,
        8,
        len(packed_candidate_bytes),
    )

    boot.write_bytes(rebuilt)

    verify.mkdir(
        parents=True,
        exist_ok=False,
    )

    run([
        unpack_bootimg,
        "--boot_img",
        boot,
        "--out",
        verify,
    ])

    verified_kernel = (
        verify / "kernel"
    )

    need_file(verified_kernel)

    if (
        verified_kernel.read_bytes()
        != packed_candidate_bytes
    ):
        raise KernelCtlError(
            "Stage-0 rebuilt boot kernel payload "
            "verification failed"
        )

    verified_image = (
        work / "Image.verify"
    )

    run([
        lz4,
        "-d",
        "-f",
        verified_kernel,
        verified_image,
    ])

    if (
        verified_image.read_bytes()
        != candidate_bytes
    ):
        raise KernelCtlError(
            "Stage-0 rebuilt decompressed Image "
            "verification failed"
        )

    manifest.update({
        "source_boot_kernel_bytes":
            len(packed_source_bytes),
        "candidate_boot_kernel_bytes":
            len(packed_candidate_bytes),
        "boot_header_version":
            header_version,
        "boot_header_size":
            header_size,
        "boot_ramdisk_bytes":
            ramdisk_size,
        "boot_signature_bytes":
            signature_size,
        "boot_candidate_pre_avb_sha256":
            file_sha256(boot),
    })

    manifest_path = (
        stage
        / "stage0-proof.json"
    )

    manifest_path.write_text(
        json.dumps(
            manifest,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    print(
        "Stage-0 source Image:    "
        + manifest[
            "source_image_sha256"
        ]
    )

    print(
        "Stage-0 candidate Image: "
        + manifest[
            "candidate_image_sha256"
        ]
    )

    print(
        "Stage-0 entry RVA:       "
        + manifest[
            "stage0_rva"
        ]
    )

    print(
        "Stage-0 trampoline:      "
        f"{manifest['stage0_bytes']} bytes"
    )

    print(
        "Stage-0 manifest:        "
        f"{manifest_path}"
    )

    print(
        "TREEFORGE_STAGE0_PROOF_IMAGE=PASS"
    )

    return manifest_path



def realize_stage0_provider_proof(
