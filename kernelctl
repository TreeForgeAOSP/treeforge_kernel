    print("TreeForge Stage-0 UFS HCI gate")
    print("--------------------------------")
    print(f"Source:       {source}")
    print(f"Compiler:     {clang}")
    print(f"Payload:      {len(payload)} bytes")
    print(
        "Payload SHA:  "
        + hashlib.sha256(
            payload
        ).hexdigest()
    )
    print("Relocations:  none")
    print("MMIO writes:  none")
    print()
    print(disasm.stdout.rstrip())
    print()

    return payload, {
        "ufs_hci_gate_source":
            str(source),
        "ufs_hci_gate_source_sha256":
            file_sha256(source),
        "ufs_hci_gate_payload_bytes":
            len(payload),
        "ufs_hci_gate_payload_sha256":
            hashlib.sha256(
                payload
            ).hexdigest(),
        "ufs_hci_gate_relocations":
            "none",
        "ufs_hci_gate_mmio_mode":
            "read-only",
        "ufs_hci_base":
            "0x14700000",
        "ufs_hci_hcs":
            "0x14700030",
        "ufs_hci_hce":
            "0x14700034",
        "ufs_hci_required_hce_mask":
            "0x00000001",
        "ufs_hci_required_hcs_mask":
            "0x0000000f",
        "ufs_hci_utrlba":
            "0x14700050",
        "ufs_hci_utrlbau":
            "0x14700054",
        "ufs_hci_utrldbr":
            "0x14700058",
        "ufs_hci_utrlrsr":
