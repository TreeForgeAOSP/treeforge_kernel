+/**
+ * disable_work_sync - disable, cancel and drain a work item
+ * @work: work item to disable
+ *
+ * Disable depth is incremented while PENDING is exclusively owned.
+ * Queue attempts are rejected until a matching enable operation.
+ */
+bool disable_work_sync(struct work_struct *work)
+{
+	return __cancel_work_timer(
+		work,
+		false,
+		true);
+}
+EXPORT_SYMBOL_GPL(disable_work_sync);
+
+/**
+ * enable_work - decrement a work item's disable depth
+ * @work: work item to enable
+ *
+ * Returns true when the disable depth reaches zero.
+ */
+bool enable_work(struct work_struct *work)
+{
+	unsigned long flags;
+	unsigned int depth;
+	int ret;
+
+	do {
+		ret = try_to_grab_pending(
+			work,
+			false,
+			&flags);
+	} while (unlikely(ret == -EAGAIN));
+
+	if (unlikely(ret < 0))
+		return false;
+
+	depth = work_disable_depth(work);
+
+	if (WARN_ON_ONCE(!depth)) {
+		set_work_pool_and_clear_pending(
+			work,
+			get_work_pool_id(work));
+		local_irq_restore(flags);
+		return false;
+	}
+
+	work_set_disable_depth(
+		work,
+		depth - 1);
+
+	set_work_pool_and_clear_pending(
+		work,
+		get_work_pool_id(work));
+
+	local_irq_restore(flags);
+
+	return depth == 1;
+}
+EXPORT_SYMBOL_GPL(enable_work);
+
+/**
+ * disable_delayed_work_sync - disable, cancel and drain delayed work
+ * @dwork: delayed work item to disable
+ */
+bool disable_delayed_work_sync(struct delayed_work *dwork)
+{
+	return __cancel_work_timer(
+		&dwork->work,
+		true,
+		true);
+}
+EXPORT_SYMBOL_GPL(disable_delayed_work_sync);
+
+/**
+ * enable_delayed_work - decrement delayed-work disable depth
+ * @dwork: delayed work item to enable
+ */
+bool enable_delayed_work(struct delayed_work *dwork)
+{
+	return enable_work(
+		&dwork->work);
+}
+EXPORT_SYMBOL_GPL(enable_delayed_work);
