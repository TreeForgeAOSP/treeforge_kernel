    )
    print(
        f"Description: "
        f"{record['description']}"
    )
    print()



def run(args, *, capture=False, check=True):
    print("+", " ".join(str(x) for x in args))

    result = subprocess.run(
        [str(x) for x in args],
        text=True,
        capture_output=capture,
    )

    if check and result.returncode != 0:
        if capture:
            if result.stdout:
                print(result.stdout, end="")
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)

        raise KernelCtlError(
            f"command failed ({result.returncode}): "
            + " ".join(str(x) for x in args)
        )

    return result


def output(args):
    result = run(args, capture=True)

    if result.stderr:
        # avbtool normally uses stdout, fastboot frequently uses stderr.
        return result.stdout + result.stderr

    return result.stdout


def need_file(path: Path):
    if not path.is_file():
        raise KernelCtlError(f"required file missing: {path}")


def need_command(name: str):
    path = shutil.which(name)

    if not path:
        raise KernelCtlError(f"required command not found: {name}")

    return Path(path)


def avbtool_path():
    """
    Resolve avbtool exclusively from the verified TreeForge
    host-tool provider contract.

    Never fall back to an AOSP checkout or distro avbtool.
    """
    need_file(TREEFORGE_TOOLS_CONTRACT)

    data = json.loads(
        TREEFORGE_TOOLS_CONTRACT.read_text(
            encoding="utf-8"
        )
    )

    tools = data.get("tools")

    if not isinstance(tools, dict):
        raise KernelCtlError(
            "TreeForge host-tool contract has no tools map"
        )

    entry = tools.get("avbtool")

    if not isinstance(entry, dict):
        raise KernelCtlError(
            "TreeForge host-tool contract has no avbtool entry"
        )

    value = entry.get("path")

    if not value:
        raise KernelCtlError(
            "TreeForge avbtool provider path is missing"
        )

    path = Path(value).expanduser()

    need_file(path)

    expected_sha256 = entry.get("sha256")

    if expected_sha256:
        digest = hashlib.sha256()

        with path.open("rb") as stream:
            for chunk in iter(
                lambda: stream.read(1024 * 1024),
                b"",
            ):
                digest.update(chunk)

        actual_sha256 = digest.hexdigest()

        if actual_sha256 != expected_sha256:
            raise KernelCtlError(
                "TreeForge avbtool provider SHA256 mismatch:\n"
                f"  expected={expected_sha256}\n"
                f"  actual={actual_sha256}\n"
                f"  path={path}"
            )

    return path



def avb_info(image: Path):
    avbtool = avbtool_path()
    return output([avbtool, "info_image", "--image", image])


def field(info: str, name: str):
    match = re.search(
        rf"^\s*{re.escape(name)}:\s*(.+?)\s*$",
        info,
        re.MULTILINE,
    )

    if not match:
        raise KernelCtlError(f"AVB field not found: {name}")

    return match.group(1)


def integer_field(info: str, name: str):
    value = field(info, name)
    match = re.search(r"\d+", value)

    if not match:
        raise KernelCtlError(f"integer AVB field not found: {name}")

    return int(match.group(0))


def properties(info: str, prefix: str | None = None):
    found = []

    for line in info.splitlines():
        line = line.strip()

        if not line.startswith("Prop: "):
            continue

        body = line[len("Prop: "):]

        if " -> " not in body:
            continue

        key, value = body.split(" -> ", 1)
        value = value.strip()

        if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
            value = value[1:-1]

        if prefix is None or key.startswith(prefix):
            found.append((key, value))

    return found


def append_props(command, props):
    for key, value in props:
        command.extend(["--prop", f"{key}:{value}"])


def public_key_sha1(key: Path):
    avbtool = avbtool_path()
    temp = ROOT / "out/tangorpro/.kernelctl-pubkey.bin"
    temp.parent.mkdir(parents=True, exist_ok=True)

    try:
        run([
            avbtool,
            "extract_public_key",
            "--key", key,
            "--output", temp,
        ])

        return hashlib.sha1(temp.read_bytes()).hexdigest()
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass



def materialize_aosp_keyset(
    workspace: Path = ROOT,
) -> Path:
    key_root = (
        workspace
        / "keys"
        / "aosp"
        / "android-15-r36"
    )

    keyset_path = (
        key_root
        / "KEYSET.json"
    )

    need_file(keyset_path)

    data = json.loads(
        keyset_path.read_text(
            encoding="utf-8"
        )
    )

    source_info = data.get("source")

    if not isinstance(source_info, dict):
        raise KernelCtlError(
            "AOSP keyset source metadata missing"
        )

    source_2048_value = source_info.get(
        "rsa2048"
    )

    source_4096_value = source_info.get(
        "rsa4096"
    )

    if not source_2048_value or not source_4096_value:
        raise KernelCtlError(
            "AOSP keyset source paths missing"
        )

    source_2048 = (
        workspace
        / source_2048_value
    )

    source_4096 = (
        workspace
        / source_4096_value
    )

    need_file(source_2048)
    need_file(source_4096)

    nodes = data.get("signing_nodes")

    if not isinstance(nodes, dict):
        raise KernelCtlError(
            "AOSP signing-node metadata missing"
        )

    child = nodes.get("boot")
    root_node = nodes.get("vbmeta")

    if (
        not isinstance(child, dict)
        or not isinstance(root_node, dict)
    ):
        raise KernelCtlError(
            "canonical AOSP signing identities missing"
        )

    expected_2048 = child.get("sha256")
    expected_4096 = root_node.get("sha256")

    if file_sha256(source_2048) != expected_2048:
        raise KernelCtlError(
            "canonical AOSP RSA2048 source "
            "identity mismatch"
        )

    if file_sha256(source_4096) != expected_4096:
        raise KernelCtlError(
            "canonical AOSP RSA4096 source "
            "identity mismatch"
        )

    destination = (
        key_root
        / "materialized"
    )

    destination.mkdir(
        parents=True,
        exist_ok=True,
    )

    mapping = {
        "testkey_rsa2048.pem": source_2048,
        "testkey_rsa4096.pem": source_4096,
        "boot.pem": source_2048,
        "init_boot.pem": source_2048,
        "vbmeta_system.pem": source_2048,
        "vbmeta_vendor.pem": source_2048,
        "vbmeta.pem": source_4096,
    }

    for name, source in mapping.items():
        target = destination / name

        expected = (
            expected_4096
            if name in (
                "testkey_rsa4096.pem",
                "vbmeta.pem",
            )
            else expected_2048
        )

        if (
            target.is_file()
            and file_sha256(target) == expected
        ):
            target.chmod(0o600)
            continue

        if target.exists() or target.is_symlink():
            target.unlink()

        shutil.copy2(
            source,
            target,
        )

        target.chmod(0o600)

        actual = file_sha256(target)

        if actual != expected:
            raise KernelCtlError(
                f"materialized AOSP key mismatch: {name}"
            )

    print()
    print("AOSP AVB development keys")
    print("-------------------------")
    print(f"Source:       pinned Google kernel source")
    print(f"Materialized: {destination}")
    print("Tracked:      NO")
    print("RSA2048:      PASS")
    print("RSA4096:      PASS")

    return destination


def provider_keys(provider: str):
    if provider == "aosp":
        materialize_aosp_keyset()
        keys = {
            "boot": AOSP_AVB_KEYS / "boot.pem",
            "init_boot": AOSP_AVB_KEYS / "init_boot.pem",
            "vbmeta_system": AOSP_AVB_KEYS / "vbmeta_system.pem",
            "vbmeta_vendor": AOSP_AVB_KEYS / "vbmeta_vendor.pem",
            "vbmeta": AOSP_AVB_KEYS / "vbmeta.pem",
        }

    elif provider == "treeforge":
        keys = {
            "boot": TREEFORGE_KEYS / "boot.pem",
            "init_boot": TREEFORGE_KEYS / "init_boot.pem",
            "vbmeta": TREEFORGE_KEYS / "vbmeta.pem",
            "vbmeta_system": TREEFORGE_KEYS / "vbmeta_system.pem",
            "vbmeta_vendor": TREEFORGE_KEYS / "vbmeta_vendor.pem",
        }

    else:
        raise KernelCtlError(f"unknown signing provider: {provider}")

    for path in keys.values():
        need_file(path)

    return keys


