def annotate_build_metadata_profile(
    metadata: Path,
    profile: str,
) -> None:
    data = load_build_profile(
        profile
    )

    patches = (
        validate_profile_patch_records(
            data
        )
    )

    try:
        payload = json.loads(
            metadata.read_text(
                encoding="utf-8"
            )
        )
    except Exception as error:
        raise KernelCtlError(
            f"unable to annotate build metadata: "
            f"{metadata}: {error}"
        ) from error

    profile_path = data[
        "_profile_path"
    ]

    source_lock = data[
        "_source_lock_path"
    ]

    payload[
        "build_profile"
    ] = profile

    payload[
        "build_profile_recipe"
    ] = str(
        profile_path.relative_to(ROOT)
    )

    payload[
        "build_profile_recipe_sha256"
    ] = file_sha256(
        profile_path
    )

    payload[
        "source_lock"
    ] = str(
        source_lock.relative_to(ROOT)
    )

    payload[
        "source_lock_sha256"
    ] = file_sha256(
        source_lock
    )

    payload[
        "profile_patches"
    ] = [
        {
            "repository":
                record["repository"],
            "base_revision":
                record["base_revision"],
            "patch":
                record["patch"],
            "sha256":
                record["sha256"],
        }
        for record in patches
    ]

    metadata.write_text(
        json.dumps(
            payload,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )


def build_environment_plan(contract: dict) -> dict:
    java_home = (
        ROOT
        / "prebuilts"
        / "jdk"
        / "jdk11"
        / "linux-x86"
    )

    java = java_home / "bin" / "java"

    need_file(java)

    bazel = (
        ROOT
        / "prebuilts"
        / "bazel"
        / "linux-x86_64"
        / "bazel"
    )

    need_file(bazel)

    tangorpro_build = (
        ROOT
        / "private"
        / "devices"
        / "google"
        / "tangorpro"
        / "build_tangorpro.sh"
    )

    need_file(tangorpro_build)

    tool_dirs = []

    for name in (
        "mkbootimg",
        "unpack_bootimg",
        "avbtool",
        "adb",
        "fastboot",
    ):
        parent = str(Path(contract["tools"][name]["path"]).parent)

        if parent not in tool_dirs:
            tool_dirs.append(parent)

    path_prefix = [
        str(java_home / "bin"),
        *tool_dirs,
    ]

    library_dirs = []

    runtime = contract.get("runtime", {})

    for value in runtime.get("library_dirs", []):
        directory = Path(value)

        if not directory.is_dir():
            raise KernelCtlError(
                f"TreeForge runtime library directory missing: "
                f"{directory}"
            )

        library_dirs.append(str(directory))

    return {
        "java_home": java_home,
        "java": java,
        "bazel": bazel,
        "build_script": tangorpro_build,
        "path_prefix": path_prefix,
        "library_dirs": library_dirs,
    }


def kernel_bazel_command(raw_dir: Path):
    bazel = ROOT / "tools" / "bazel"

    need_file(bazel)

    return [
        bazel,
        "run",
        "--kernel_package=@//aosp",
        "--config=stamp",
        "--config=tangorpro",
        "--config=no_download_gki",
        "--config=no_download_gki_fips140",
        "--config=no_internet",
        "//private/devices/google/tangorpro:gs201_tangorpro_dist",
        "--",
        f"--dist_dir={raw_dir}",
    ]


def build_child_environment(contract: dict) -> tuple[dict, dict]:
    plan = build_environment_plan(contract)

    env = os.environ.copy()

    env["JAVA_HOME"] = str(plan["java_home"])

    path_parts = [
        *plan["path_prefix"],
    ]

    existing_path = env.get("PATH", "")

    if existing_path:
        path_parts.append(existing_path)

    env["PATH"] = os.pathsep.join(path_parts)

    library_parts = [
        *plan["library_dirs"],
    ]

    existing_libraries = env.get("LD_LIBRARY_PATH", "")

    if existing_libraries:
        library_parts.append(existing_libraries)

    if library_parts:
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            library_parts
        )

    return env, plan


