    providers = data.get("providers")

    if not isinstance(providers, dict) or not providers:
        raise KernelCtlError(
            "kernel provider manifest contains no providers"
        )

    return data


def git_head(path: Path):
    result = subprocess.run(
        [
            "git",
            "-C",
            str(path),
            "rev-parse",
            "HEAD",
        ],
        text=True,
        capture_output=True,
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def git_dirty(path: Path) -> bool:
    result = subprocess.run(
        [
            "git",
            "-C",
            str(path),
            "status",
            "--porcelain",
        ],
        text=True,
        capture_output=True,
    )

    if result.returncode != 0:
        raise KernelCtlError(
            f"unable to inspect provider checkout: {path}"
        )

    return bool(result.stdout.strip())


def verify_workspace_provider_plan(
    *,
    name: str,
    provider: dict,
) -> tuple[str, Path]:
    target = ROOT / provider["workspace_path"]
    expected = provider["revision"]

    if not target.exists():
        return "MATERIALIZE", target

    if not target.is_dir():
        raise KernelCtlError(
            f"{name}: provider path is not a directory: {target}"
        )

    actual = git_head(target)

    if actual is None:
        raise KernelCtlError(
            f"{name}: existing provider path is not a Git checkout: "
            f"{target}"
        )

    if actual != expected:
        raise KernelCtlError(
            f"{name}: provider revision mismatch: "
            f"expected={expected} actual={actual}"
        )

    if git_dirty(target):
        raise KernelCtlError(
            f"{name}: provider checkout is dirty: {target}"
        )

    return "READY", target


def load_treeforge_tools_contract() -> dict:
    need_file(TREEFORGE_TOOLS_CONTRACT)

    try:
        data = json.loads(
            TREEFORGE_TOOLS_CONTRACT.read_text(
                encoding="utf-8"
            )
        )
    except (OSError, json.JSONDecodeError) as error:
        raise KernelCtlError(
            "unable to read TreeForge host-tool contract: "
            f"{TREEFORGE_TOOLS_CONTRACT}: {error}"
        ) from error

    if data.get("schema") != 1:
        raise KernelCtlError(
            "unsupported TreeForge host-tool contract schema: "
            f"{data.get('schema')}"
        )

    tools = data.get("tools")

    if not isinstance(tools, dict):
        raise KernelCtlError(
            "TreeForge host-tool contract contains no tools"
        )

    required = (
        "mkbootimg",
        "unpack_bootimg",
        "avbtool",
        "adb",
        "fastboot",
    )

    for name in required:
        record = tools.get(name)

        if not isinstance(record, dict):
            raise KernelCtlError(
                f"TreeForge host-tool contract missing: {name}"
            )

        tool_path = Path(record.get("path", ""))

        if not tool_path.is_file():
            raise KernelCtlError(
                f"TreeForge host tool missing: {name}: {tool_path}"
            )

    return data



