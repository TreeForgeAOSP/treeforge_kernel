class KernelCtlError(RuntimeError):
    pass


def run(args, *, capture=False, check=True):
    print("+", " ".join(str(x) for x in args))

    result = subprocess.run(
        [str(x) for x in args],
        text=True,
        capture_output=capture,
    )

    if check and result.returncode != 0:
        if capture:
            if result.stdout:
                print(result.stdout, end="")
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)

        raise KernelCtlError(
            f"command failed ({result.returncode}): "
            + " ".join(str(x) for x in args)
        )

    return result


def output(args):
    result = run(args, capture=True)

    if result.stderr:
        # avbtool normally uses stdout, fastboot frequently uses stderr.
        return result.stdout + result.stderr

    return result.stdout


def need_file(path: Path):
    if not path.is_file():
        raise KernelCtlError(f"required file missing: {path}")


def need_command(name: str):
    path = shutil.which(name)

    if not path:
        raise KernelCtlError(f"required command not found: {name}")

    return Path(path)


def avbtool_path():
    candidate = AOSP / "out/host/linux-x86/bin/avbtool"

    if candidate.is_file():
        return candidate

    candidate = (
        ROOT
        / "prebuilts/kernel-build-tools/linux-x86/bin/avbtool"
    )

    if candidate.is_file():
        return candidate

    raise KernelCtlError("avbtool not found")


def avb_info(image: Path):
    avbtool = avbtool_path()
    return output([avbtool, "info_image", "--image", image])


def field(info: str, name: str):
    match = re.search(
        rf"^{re.escape(name)}:\s*(.+?)\s*$",
        info,
        re.MULTILINE,
    )

    if not match:
        raise KernelCtlError(f"AVB field not found: {name}")

    return match.group(1)


def integer_field(info: str, name: str):
    value = field(info, name)
    match = re.search(r"\d+", value)

    if not match:
        raise KernelCtlError(f"integer AVB field not found: {name}")

    return int(match.group(0))


def properties(info: str, prefix: str | None = None):
    found = []

    for line in info.splitlines():
        line = line.strip()

        if not line.startswith("Prop: "):
            continue

        body = line[len("Prop: "):]

        if " -> " not in body:
            continue

        key, value = body.split(" -> ", 1)
        value = value.strip()

        if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
            value = value[1:-1]

        if prefix is None or key.startswith(prefix):
            found.append((key, value))

    return found


def append_props(command, props):
    for key, value in props:
        command.extend(["--prop", f"{key}:{value}"])


def public_key_sha1(key: Path):
    avbtool = avbtool_path()
    temp = ROOT / "out/tangorpro/.kernelctl-pubkey.bin"
    temp.parent.mkdir(parents=True, exist_ok=True)

    try:
        run([
            avbtool,
            "extract_public_key",
            "--key", key,
            "--output", temp,
        ])

        return hashlib.sha1(temp.read_bytes()).hexdigest()
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def provider_keys(provider: str):
    if provider == "aosp":
        rsa2048 = AOSP_AVB_KEYS / "testkey_rsa2048.pem"

        keys = {
            "boot": rsa2048,
            "init_boot": rsa2048,
            "vbmeta_system": rsa2048,
            "vbmeta_vendor": rsa2048,
            "vbmeta": AOSP_AVB_KEYS / "testkey_rsa4096.pem",
        }

    elif provider == "treeforge":
        keys = {
            "boot": TREEFORGE_KEYS / "boot.pem",
            "init_boot": TREEFORGE_KEYS / "init_boot.pem",
            "vbmeta": TREEFORGE_KEYS / "vbmeta.pem",
            "vbmeta_system": TREEFORGE_KEYS / "vbmeta_system.pem",
            "vbmeta_vendor": TREEFORGE_KEYS / "vbmeta_vendor.pem",
        }

    else:
        raise KernelCtlError(f"unknown signing provider: {provider}")

    for path in keys.values():
        need_file(path)

    return keys


def preflight():
    need_command("adb")
    need_command("fastboot")

    need_file(avbtool_path())

    for name in (
        "boot.img",
        "dtbo.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
    ):
        need_file(DIST / name)

    for name in (
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
        "system.img",
        "system_ext.img",
        "product.img",
        "pvmfw.img",
    ):
        need_file(AOSP_PRODUCT / name)


def copy_clean(source: Path, target: Path):
    if target.exists():
        target.unlink()

    shutil.copy2(source, target)


def add_hash_footer(
    image: Path,
    *,
    partition_name: str,
    partition_size: int,
    key: Path | None = None,
    algorithm: str | None = None,
    rollback_index: int | None = None,
    props=(),
):
    command = [
        avbtool_path(),
        "add_hash_footer",
        "--image", image,
        "--partition_name", partition_name,
        "--partition_size", str(partition_size),
    ]

    if key is not None:
        command.extend(["--key", key])

    if algorithm is not None:
        command.extend(["--algorithm", algorithm])

    if rollback_index is not None:
        command.extend(["--rollback_index", str(rollback_index)])

    append_props(command, props)

    run(command)


def package(provider: str):
    preflight()
    keys = provider_keys(provider)

    stage = ROOT / f"out/tangorpro/deploy/{provider}"
    stage.mkdir(parents=True, exist_ok=True)

    print()
    print(f"Signing provider: {provider}")
    print(f"Output:           {stage}")
    print()

    # ---------------------------------------------------------
    # boot
    # ---------------------------------------------------------
    stock_boot = AOSP_PRODUCT / "boot.img"
    stock_boot_info = avb_info(stock_boot)

    boot = stage / "boot.img"
    copy_clean(DIST / "boot.img", boot)

    # Standalone kernel build already adds an unsigned footer.
    run([
        avbtool_path(),
        "erase_footer",
        "--image", boot,
    ])

    add_hash_footer(
        boot,
        partition_name="boot",
        partition_size=stock_boot.stat().st_size,
        key=keys["boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_boot_info,
            "Rollback Index",
        ),
        props=properties(stock_boot_info),
    )

    # ---------------------------------------------------------
    # init_boot: preserve AOSP payload, change selected signer.
    # ---------------------------------------------------------
    stock_init_boot = AOSP_PRODUCT / "init_boot.img"
    stock_init_info = avb_info(stock_init_boot)

    init_boot = stage / "init_boot.img"
    copy_clean(stock_init_boot, init_boot)

    run([
        avbtool_path(),
        "erase_footer",
        "--image", init_boot,
    ])

    add_hash_footer(
        init_boot,
        partition_name="init_boot",
        partition_size=stock_init_boot.stat().st_size,
        key=keys["init_boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_init_info,
            "Rollback Index",
        ),
        props=properties(stock_init_info),
    )

    # ---------------------------------------------------------
    # dtbo
    # ---------------------------------------------------------
    stock_dtbo = AOSP_PRODUCT / "dtbo.img"
    stock_dtbo_info = avb_info(stock_dtbo)

    dtbo = stage / "dtbo.img"
    copy_clean(DIST / "dtbo.img", dtbo)

    add_hash_footer(
        dtbo,
        partition_name="dtbo",
        partition_size=stock_dtbo.stat().st_size,
        props=properties(stock_dtbo_info),
    )

    # ---------------------------------------------------------
    # vendor_boot is unchanged AOSP payload, but carry it in the
    # deployment set because root vbmeta authenticates it.
    # ---------------------------------------------------------
    vendor_boot = stage / "vendor_boot.img"
    copy_clean(AOSP_PRODUCT / "vendor_boot.img", vendor_boot)

    # ---------------------------------------------------------
    # vendor_kernel_boot
    # ---------------------------------------------------------
    stock_vkb = AOSP_PRODUCT / "vendor_kernel_boot.img"
    stock_vkb_info = avb_info(stock_vkb)

    vendor_kernel_boot = stage / "vendor_kernel_boot.img"
    copy_clean(
        DIST / "vendor_kernel_boot.img",
        vendor_kernel_boot,
    )

    add_hash_footer(
        vendor_kernel_boot,
        partition_name="vendor_kernel_boot",
        partition_size=stock_vkb.stat().st_size,
        props=properties(stock_vkb_info),
    )

    # ---------------------------------------------------------
    # DLKM images are already produced with valid hashtrees.
    # ---------------------------------------------------------
    vendor_dlkm = stage / "vendor_dlkm.img"
    system_dlkm = stage / "system_dlkm.img"

    copy_clean(DIST / "vendor_dlkm.img", vendor_dlkm)
    copy_clean(DIST / "system_dlkm.img", system_dlkm)

    # ---------------------------------------------------------
    # vbmeta_system
    # ---------------------------------------------------------
    stock_vbmeta_system = AOSP_PRODUCT / "vbmeta_system.img"
    stock_vbs_info = avb_info(stock_vbmeta_system)

    vbmeta_system = stage / "vbmeta_system.img"

    command = [
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta_system,
        "--key", keys["vbmeta_system"],
        "--algorithm", "SHA256_RSA2048",
        "--rollback_index",
        str(integer_field(stock_vbs_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta_system.stat().st_size),

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system.img",

        "--include_descriptors_from_image",
        system_dlkm,

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system_ext.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "product.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "pvmfw.img",
    ]

    append_props(
        command,
        properties(
            stock_vbs_info,
            "com.android.build.system_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # vbmeta_vendor: preserve all AOSP descriptors but sign the
    # node with the chosen provider's vbmeta_vendor key.
    # ---------------------------------------------------------
    stock_vbmeta_vendor = AOSP_PRODUCT / "vbmeta_vendor.img"
    stock_vbv_info = avb_info(stock_vbmeta_vendor)

    vbmeta_vendor = stage / "vbmeta_vendor.img"

    run([
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta_vendor,
        "--key", keys["vbmeta_vendor"],
        "--algorithm", "SHA256_RSA2048",
        "--rollback_index",
        str(integer_field(stock_vbv_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta_vendor.stat().st_size),
        "--include_descriptors_from_image",
        stock_vbmeta_vendor,
    ])

    # ---------------------------------------------------------
    # root vbmeta
    # ---------------------------------------------------------
    pubdir = stage / ".pubkeys"
    pubdir.mkdir(exist_ok=True)

    pubs = {}

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
    ):
        pub = pubdir / f"{name}.avbpubkey"

        run([
            avbtool_path(),
            "extract_public_key",
            "--key", keys[name],
            "--output", pub,
        ])

        pubs[name] = pub

    stock_vbmeta = AOSP_PRODUCT / "vbmeta.img"
    stock_vbmeta_info = avb_info(stock_vbmeta)

    vbmeta = stage / "vbmeta.img"

    command = [
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta,
        "--key", keys["vbmeta"],
        "--algorithm", "SHA256_RSA4096",
        "--rollback_index",
        str(integer_field(stock_vbmeta_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta.stat().st_size),

        "--chain_partition",
        f"boot:2:{pubs['boot']}",

        "--chain_partition",
        f"init_boot:4:{pubs['init_boot']}",

        "--chain_partition",
        f"vbmeta_system:1:{pubs['vbmeta_system']}",

        "--chain_partition",
        f"vbmeta_vendor:3:{pubs['vbmeta_vendor']}",

        "--include_descriptors_from_image",
        dtbo,

        "--include_descriptors_from_image",
        vendor_boot,

        "--include_descriptors_from_image",
        vendor_kernel_boot,

        "--include_descriptors_from_image",
        vendor_dlkm,
    ]

    append_props(
        command,
        properties(
            stock_vbmeta_info,
            "com.android.build.vendor_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # Verification
    # ---------------------------------------------------------
    expected_hashes = {
        "boot": public_key_sha1(keys["boot"]),
        "init_boot": public_key_sha1(keys["init_boot"]),
        "vbmeta": public_key_sha1(keys["vbmeta"]),
        "vbmeta_system": public_key_sha1(keys["vbmeta_system"]),
        "vbmeta_vendor": public_key_sha1(keys["vbmeta_vendor"]),
    }

    verify_images = {
        "boot": boot,
        "init_boot": init_boot,
        "vbmeta": vbmeta,
        "vbmeta_system": vbmeta_system,
        "vbmeta_vendor": vbmeta_vendor,
    }

    print()
    print("Signing verification")
    print("--------------------")

    for name, image in verify_images.items():
        info = avb_info(image)
        actual = field(info, "Public key (sha1)")
        expected = expected_hashes[name]

        if actual != expected:
            raise KernelCtlError(
                f"{name}: signing key mismatch: "
                f"expected {expected}, got {actual}"
            )

        print(f"PASS  {name:<15} {actual}")

    expected = [
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    ]

    for name in expected:
        need_file(stage / name)

    print()
    print("Package complete:")
    print(stage)

    return stage


def provider_script(name: str) -> Path:
    path = KERNEL_PROVIDER_ROOT / "scripts" / name

    if not path.is_file():
        raise KernelCtlError(
            f"TreeForge provider script missing: {path}"
        )

    return path


def provider_manifest() -> dict:
    path = (
        KERNEL_PROVIDER_ROOT
        / "manifests"
        / "kernel"
        / KERNEL_PROVIDER_RELEASE
        / "google-providers.json"
    )

    need_file(path)

    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise KernelCtlError(
            f"unable to read kernel provider manifest: {path}: {error}"
        ) from error

    if data.get("schema") != 1:
        raise KernelCtlError(
            f"unsupported kernel provider schema: {data.get('schema')}"
        )

    if data.get("platform_release") != KERNEL_PROVIDER_RELEASE:
        raise KernelCtlError(
            "kernel provider release identity mismatch"
        )

    providers = data.get("providers")

    if not isinstance(providers, dict) or not providers:
        raise KernelCtlError(
            "kernel provider manifest contains no providers"
        )

    return data


def git_head(path: Path):
    result = subprocess.run(
        [
            "git",
            "-C",
            str(path),
            "rev-parse",
            "HEAD",
        ],
        text=True,
        capture_output=True,
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def git_dirty(path: Path) -> bool:
    result = subprocess.run(
        [
            "git",
            "-C",
            str(path),
            "status",
            "--porcelain",
        ],
        text=True,
        capture_output=True,
    )

    if result.returncode != 0:
        raise KernelCtlError(
            f"unable to inspect provider checkout: {path}"
        )

    return bool(result.stdout.strip())


def verify_workspace_provider_plan(
    *,
    name: str,
    provider: dict,
) -> tuple[str, Path]:
    target = ROOT / provider["workspace_path"]
    expected = provider["revision"]

    if not target.exists():
        return "MATERIALIZE", target

    if not target.is_dir():
        raise KernelCtlError(
            f"{name}: provider path is not a directory: {target}"
        )

    actual = git_head(target)

    if actual is None:
        raise KernelCtlError(
            f"{name}: existing provider path is not a Git checkout: "
            f"{target}"
        )

    if actual != expected:
        raise KernelCtlError(
            f"{name}: provider revision mismatch: "
            f"expected={expected} actual={actual}"
        )

    if git_dirty(target):
        raise KernelCtlError(
            f"{name}: provider checkout is dirty: {target}"
        )

    return "READY", target


def load_treeforge_tools_contract() -> dict:
    need_file(TREEFORGE_TOOLS_CONTRACT)

    try:
        data = json.loads(
            TREEFORGE_TOOLS_CONTRACT.read_text(
                encoding="utf-8"
            )
        )
    except (OSError, json.JSONDecodeError) as error:
        raise KernelCtlError(
            "unable to read TreeForge host-tool contract: "
            f"{TREEFORGE_TOOLS_CONTRACT}: {error}"
        ) from error

    if data.get("schema") != 1:
        raise KernelCtlError(
            "unsupported TreeForge host-tool contract schema: "
            f"{data.get('schema')}"
        )

    tools = data.get("tools")

    if not isinstance(tools, dict):
        raise KernelCtlError(
            "TreeForge host-tool contract contains no tools"
        )

    required = (
        "mkbootimg",
        "unpack_bootimg",
        "avbtool",
        "adb",
        "fastboot",
    )

    for name in required:
        record = tools.get(name)

        if not isinstance(record, dict):
            raise KernelCtlError(
                f"TreeForge host-tool contract missing: {name}"
            )

        tool_path = Path(record.get("path", ""))

        if not tool_path.is_file():
            raise KernelCtlError(
                f"TreeForge host tool missing: {name}: {tool_path}"
            )

    return data


def build_environment_plan(contract: dict) -> dict:
    java_home = (
        ROOT
        / "prebuilts"
        / "jdk"
        / "jdk11"
        / "linux-x86"
    )

    java = java_home / "bin" / "java"

    need_file(java)

    bazel = (
        ROOT
        / "prebuilts"
        / "bazel"
        / "linux-x86_64"
        / "bazel"
    )

    need_file(bazel)

    tangorpro_build = (
        ROOT
        / "private"
        / "devices"
        / "google"
        / "tangorpro"
        / "build_tangorpro.sh"
    )

    need_file(tangorpro_build)

    tool_dirs = []

    for name in (
        "mkbootimg",
        "unpack_bootimg",
        "avbtool",
        "adb",
        "fastboot",
    ):
        parent = str(Path(contract["tools"][name]["path"]).parent)

        if parent not in tool_dirs:
            tool_dirs.append(parent)

    path_prefix = [
        str(java_home / "bin"),
        *tool_dirs,
    ]

    library_dirs = []

    runtime = contract.get("runtime", {})

    for value in runtime.get("library_dirs", []):
        directory = Path(value)

        if not directory.is_dir():
            raise KernelCtlError(
                f"TreeForge runtime library directory missing: "
                f"{directory}"
            )

        library_dirs.append(str(directory))

    return {
        "java_home": java_home,
        "java": java,
        "bazel": bazel,
        "build_script": tangorpro_build,
        "path_prefix": path_prefix,
        "library_dirs": library_dirs,
    }


def kernel_bazel_command(raw_dir: Path):
    bazel = ROOT / "tools" / "bazel"

    need_file(bazel)

    return [
        bazel,
        "run",
        "--kernel_package=@//aosp",
        "--config=stamp",
        "--config=tangorpro",
        "--config=no_download_gki",
        "--config=no_download_gki_fips140",
        "--config=no_internet",
        "//private/devices/google/tangorpro:gs201_tangorpro_dist",
        "--",
        f"--dist_dir={raw_dir}",
    ]


def build_child_environment(contract: dict) -> tuple[dict, dict]:
    plan = build_environment_plan(contract)

    env = os.environ.copy()

    env["JAVA_HOME"] = str(plan["java_home"])

    path_parts = [
        *plan["path_prefix"],
    ]

    existing_path = env.get("PATH", "")

    if existing_path:
        path_parts.append(existing_path)

    env["PATH"] = os.pathsep.join(path_parts)

    library_parts = [
        *plan["library_dirs"],
    ]

    existing_libraries = env.get("LD_LIBRARY_PATH", "")

    if existing_libraries:
        library_parts.append(existing_libraries)

    if library_parts:
        env["LD_LIBRARY_PATH"] = os.pathsep.join(
            library_parts
        )

    return env, plan


def prepare_kernel_build_providers() -> tuple[dict, dict]:
    cache = provider_script("kernel-provider-cache")
    materialize = provider_script("kernel-provider-materialize")
    treeforge_tools = provider_script("kernel-treeforge-tools")

    print()
    print("Preparing Google kernel providers")
    print("---------------------------------")

    run([
        cache,
        "--release",
        KERNEL_PROVIDER_RELEASE,
        "fetch",
        "all",
    ])

    run([
        cache,
        "--release",
        KERNEL_PROVIDER_RELEASE,
        "verify",
        "all",
    ])

    print()
    print("Preparing canonical workspace providers")
    print("---------------------------------------")

    run([
        materialize,
        "--release",
        KERNEL_PROVIDER_RELEASE,
        "--workspace",
        ROOT,
        "materialize",
    ])

    print()
    print("Preparing TreeForge host tools")
    print("------------------------------")

    run([
        treeforge_tools,
        "prepare",
    ])

    run([
        treeforge_tools,
        "verify",
    ])

    contract = load_treeforge_tools_contract()
    env, environment = build_child_environment(contract)

    return env, environment


def provider_workspace_states():
    manifest = provider_manifest()
    states = []

    for name, provider in manifest["providers"].items():
        state, target = verify_workspace_provider_plan(
            name=name,
            provider=provider,
        )

        states.append(
            (
                name,
                state,
                provider["workspace_path"],
                target,
            )
        )

    return states


