def resolve_build_profile(
    requested: str | None,
) -> str:
    """
    Resolve the user-facing kernel build profile.

    Explicit --profile is suitable for automation. Plain
    interactive `kernelctl build` presents the profile menu.

    Non-interactive callers that omit --profile retain the
    historical source/default behavior until profile recipes
    are wired into the build pipeline.
    """

    if requested is not None:
        if requested not in BUILD_PROFILES:
            raise KernelCtlError(
                f"unknown kernel build profile: {requested}"
            )

        return requested

    if not sys.stdin.isatty():
        return "source"

    print()
    print("TreeForge Kernel Build")
    print("======================")
    print()
    print("Build profile:")
    print()

    for number, name in enumerate(
        BUILD_PROFILE_ORDER,
        start=1,
    ):
        profile = BUILD_PROFILES[name]

        print(
            f"  {number}. {profile['label']}"
        )
        print(
            f"     {profile['description']}"
        )
        print()

    while True:
        value = input("Select [1]: ").strip()

        if not value:
            value = "1"

        try:
            index = int(value)
        except ValueError:
            print(
                "Select a profile by number."
            )
            continue

        if (
            index < 1
            or index > len(BUILD_PROFILE_ORDER)
        ):
            print(
                "Select a listed profile."
            )
            continue

        return BUILD_PROFILE_ORDER[
            index - 1
        ]


def print_build_profile(
