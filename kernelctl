def validate_profile_patch_records(
    profile_data: dict,
) -> list[dict]:
    patches = profile_data.get(
        "patches",
        [],
    )

    if not isinstance(
        patches,
        list,
    ):
        raise KernelCtlError(
            "kernel profile patches must be a list"
        )

    validated = []

    for record in patches:
        if not isinstance(
            record,
            dict,
        ):
            raise KernelCtlError(
                "kernel profile patch record "
                "must be an object"
            )

        repository = record.get(
            "repository"
        )

        base_revision = record.get(
            "base_revision"
        )

        patch_value = record.get(
            "patch"
        )

        expected_sha256 = record.get(
            "sha256"
        )

        if not all(
            isinstance(value, str)
            and value
            for value in (
                repository,
                base_revision,
                patch_value,
                expected_sha256,
            )
        ):
            raise KernelCtlError(
                "incomplete kernel profile "
                "patch record"
            )

        patch = (
            ROOT
            / patch_value
        )

        need_file(patch)

        actual_sha256 = file_sha256(
            patch
        )

        if actual_sha256 != expected_sha256:
            raise KernelCtlError(
                "kernel profile patch SHA256 "
                "mismatch:\n"
                f"  patch={patch}\n"
                f"  expected={expected_sha256}\n"
                f"  actual={actual_sha256}"
            )

        repository_root = (
            ROOT
            / repository
        )

        validated.append(
            {
                **record,
                "_patch_path":
                    patch,
                "_repository_root":
                    repository_root,
            }
        )

    return validated


def all_managed_profile_patches() -> list[dict]:
    profile_root = (
        ROOT
        / "profiles"
    )

    records = []
    seen = set()

    if not profile_root.is_dir():
        return records

    for path in sorted(
        profile_root.glob(
            "*/profile.json"
        )
    ):
        try:
            data = json.loads(
                path.read_text(
                    encoding="utf-8"
                )
            )
        except Exception as error:
            raise KernelCtlError(
                f"invalid profile JSON: "
                f"{path}: {error}"
            ) from error

        profile = data.get(
            "id"
        )

        if (
            not isinstance(profile, str)
            or not profile
        ):
            raise KernelCtlError(
                f"profile id missing: {path}"
            )

        canonical = load_build_profile(
            profile
        )

        for record in (
            validate_profile_patch_records(
                canonical
            )
        ):
            key = (
                record["repository"],
                record["patch"],
                record["sha256"],
            )

            if key in seen:
                continue

            seen.add(key)
            records.append(
                record
            )

    return records


def git_capture(
    repository: Path,
    *arguments: str,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        [
            "git",
            "-C",
            str(repository),
            *arguments,
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def repository_head(
    repository: Path,
) -> str | None:
    if not repository.is_dir():
        return None

    result = git_capture(
        repository,
        "rev-parse",
        "HEAD",
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip()


def patch_state(
    record: dict,
) -> str:
    repository = record[
        "_repository_root"
    ]

    patch = record[
        "_patch_path"
    ]

    if not repository.is_dir():
        return "repository-missing"

    head = repository_head(
        repository
    )

    if head != record[
        "base_revision"
    ]:
        return "base-revision-mismatch"

    reverse = git_capture(
        repository,
        "apply",
        "--reverse",
        "--check",
        str(patch),
    )

    forward = git_capture(
        repository,
        "apply",
        "--check",
        str(patch),
    )

    if (
        reverse.returncode == 0
        and forward.returncode != 0
    ):
        return "applied"

    if (
        forward.returncode == 0
        and reverse.returncode != 0
    ):
        return "pristine"

    if (
        reverse.returncode == 0
        and forward.returncode == 0
    ):
        raise KernelCtlError(
            "ambiguous kernel profile patch state: "
            f"{patch}"
        )

    return "diverged"


def normalize_managed_profile_patches() -> None:
    print()
    print("Normalizing profile-managed source")
    print("----------------------------------")

    for record in (
        all_managed_profile_patches()
    ):
        repository = record[
            "_repository_root"
        ]

        patch = record[
            "_patch_path"
        ]

        state = patch_state(
            record
        )

        print(
            f"{record['repository']}: "
            f"{patch.name}: {state}"
        )

        if state == "pristine":
            continue

        if state == "applied":
            result = git_capture(
                repository,
                "apply",
                "--reverse",
                str(patch),
            )

            if result.returncode != 0:
                raise KernelCtlError(
                    "unable to reverse managed "
                    "kernel patch:\n"
                    + result.stdout
                )

            if patch_state(record) != "pristine":
                raise KernelCtlError(
                    "kernel patch did not return "
                    "to pristine state"
                )

            continue

        if state == "repository-missing":
            continue

        if state == "base-revision-mismatch":
            continue

        raise KernelCtlError(
            "profile-managed kernel source "
            "contains an unexpected divergence:\n"
            f"  repository={repository}\n"
            f"  patch={patch}"
        )


def source_workspace_state(
    source_lock: dict,
) -> tuple[
    list[str],
    list[str],
]:
    missing = []
    mismatched = []

    for path_value, record in sorted(
        source_lock[
            "projects"
        ].items()
    ):
        expected = record.get(
            "revision"
        )

        if not isinstance(
            expected,
            str,
        ):
            raise KernelCtlError(
                "source-lock project revision "
                f"is missing: {path_value}"
            )

        repository = (
            ROOT
            / path_value
        )

        head = repository_head(
            repository
        )

        if head is None:
            missing.append(
                path_value
            )
            continue

        if head != expected:
            mismatched.append(
                f"{path_value}: "
                f"{head} != {expected}"
            )

    return (
        missing,
        mismatched,
    )


def initialize_source_workspace() -> None:
    need_command(
        "repo"
    )

    if not (
        ROOT
        / ".repo"
    ).is_dir():
        print()
        print("Initializing pinned Google source workspace")
        print("-----------------------------------------")

        run([
            "repo",
            "init",
            "-u",
            SETUP_MANIFEST_URL,
            "-b",
            SETUP_MANIFEST_BRANCH,
            "-m",
            SETUP_MANIFEST_NAME,
            "--depth=1",
        ])

    print()
    print("Syncing pinned Google source workspace")
    print("-------------------------------------")

    run([
        "repo",
        "sync",
        "-j4",
    ])


def ensure_profile_source_workspace(
    source_lock: dict,
) -> None:
    missing, mismatched = (
        source_workspace_state(
            source_lock
        )
    )

    if (
        not missing
        and not mismatched
    ):
        print()
        print("Pinned Google source workspace")
        print("------------------------------")
        print(
            f"Projects verified: "
            f"{len(source_lock['projects'])}/"
            f"{len(source_lock['projects'])}"
        )
        print("Source sync:       REUSE")
        return

    print()
    print("Pinned source workspace requires sync")
    print("-------------------------------------")

    for path in missing:
        print(
            f"MISSING: {path}"
        )

    for mismatch in mismatched:
        print(
            f"MISMATCH: {mismatch}"
        )

    initialize_source_workspace()

    missing, mismatched = (
        source_workspace_state(
            source_lock
        )
    )

    if missing or mismatched:
        detail = "\n".join(
            [
                *(
                    f"missing: {value}"
                    for value in missing
                ),
                *(
                    f"mismatch: {value}"
                    for value in mismatched
                ),
            ]
        )

        raise KernelCtlError(
            "pinned Google source workspace "
            "failed verification after sync:\n"
            + detail
        )

    print(
        f"Projects verified: "
        f"{len(source_lock['projects'])}/"
        f"{len(source_lock['projects'])}"
    )
    print("Source sync:       FRESH")


def verify_source_workspace_clean(
    source_lock: dict,
) -> None:
    dirty = []

    for path_value in sorted(
        source_lock[
            "projects"
        ]
    ):
        repository = (
            ROOT
            / path_value
        )

        result = git_capture(
            repository,
            "status",
            "--porcelain",
        )

        if result.returncode != 0:
            raise KernelCtlError(
                "unable to inspect source repository: "
                f"{repository}"
            )

        if result.stdout.strip():
            dirty.append(
                (
                    path_value,
                    result.stdout.strip(),
                )
            )

    if dirty:
        formatted = "\n".join(
            f"{path}:\n{status}"
            for path, status in dirty
        )

        raise KernelCtlError(
            "Google source workspace contains "
            "unmanaged modifications:\n"
            + formatted
        )


def apply_selected_profile_patches(
    profile_data: dict,
) -> None:
    patches = (
        validate_profile_patch_records(
            profile_data
        )
    )

    print()
    print("Applying selected kernel profile")
    print("--------------------------------")

    if not patches:
        print("Patches: none")
        return

    for record in patches:
        repository = record[
            "_repository_root"
        ]

        patch = record[
            "_patch_path"
        ]

        head = repository_head(
            repository
        )

        if head != record[
            "base_revision"
        ]:
            raise KernelCtlError(
                "kernel patch base revision "
                "does not match:\n"
                f"  repository={repository}\n"
                f"  expected="
                f"{record['base_revision']}\n"
                f"  actual={head}"
            )

        state = patch_state(
            record
        )

        if state == "applied":
            print(
                f"{record['repository']}: "
                f"{patch.name}: REUSE"
            )
            continue

        if state != "pristine":
            raise KernelCtlError(
                "kernel profile patch cannot "
                "be applied safely:\n"
                f"  repository={repository}\n"
                f"  patch={patch}\n"
                f"  state={state}"
            )

        result = git_capture(
            repository,
            "apply",
            str(patch),
        )

        if result.returncode != 0:
            raise KernelCtlError(
                "kernel profile patch apply "
                "failed:\n"
                + result.stdout
            )

        if patch_state(
            record
        ) != "applied":
            raise KernelCtlError(
                "kernel profile patch did not "
                "reach applied state"
            )

        print(
            f"{record['repository']}: "
            f"{patch.name}: APPLY"
        )


def prepare_build_profile_source(
    profile: str,
) -> dict:
    profile_data = load_build_profile(
        profile
    )

    source_lock = (
        load_profile_source_lock(
            profile_data
        )
    )

    #
    # First return every TreeForge-managed patch to its pristine
    # pinned Google base. Unexpected user/source modifications
    # are never discarded.
    #
    normalize_managed_profile_patches()

    ensure_profile_source_workspace(
        source_lock
    )

    #
    # At this point every source repository must be pristine.
    # This prevents profile switching from silently swallowing
    # unrelated kernel development work.
    #
    verify_source_workspace_clean(
        source_lock
    )

    apply_selected_profile_patches(
        profile_data
    )

    return profile_data


