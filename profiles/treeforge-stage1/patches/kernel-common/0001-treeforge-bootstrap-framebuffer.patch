--- /dev/null
+++ b/drivers/misc/treeforge_bootstrap_fb.c
@@ -0,0 +1,716 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * TreeForge Bootstrap early framebuffer bridge.
+ *
+ * Tangorpro / GS201 boot-only handover helper.
+ *
+ * This driver DOES NOT program DECON, DPP, RDMA, DSIM, or the panel.
+ * It only:
+ *
+ *   - discovers the existing exynos,fb_handover reserved-memory region;
+ *   - finds the DECON instance which owns that memory-region;
+ *   - inspects the RDMA shadow state of that DECON's DPP inputs;
+ *   - accepts exactly one conservative linear RGB scanout candidate;
+ *   - exposes the already-scanning framebuffer through a misc device.
+ *
+ * The normal Exynos DRM driver remains responsible for real display
+ * ownership after TreeForge Bootstrap hands off to the selected OS.
+ */
+
+#include <linux/capability.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/ioctl.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+
+/*
+ * GS201 uses the cal_9845 RDMA register contract for the normal
+ * DECON/DPP path.
+ *
+ * These constants intentionally mirror only the tiny read-only subset
+ * needed by TreeForge Bootstrap.
+ */
+#define TF_DMA_SHD_OFFSET            0x0400
+
+#define TF_RDMA_IN_CTRL_0            0x0008
+#define TF_RDMA_IN_CTRL_1            0x000c
+#define TF_RDMA_SRC_SIZE             0x0010
+#define TF_RDMA_SRC_OFFSET           0x0014
+#define TF_RDMA_IMG_SIZE             0x0018
+#define TF_RDMA_BASEADDR_Y8          0x0040
+#define TF_RDMA_SRC_STRIDE_0         0x0050
+#define TF_RDMA_SRC_STRIDE_1         0x0054
+
+#define TF_IDMA_IMG_FORMAT_MASK      (0x3fU << 8)
+#define TF_IDMA_ROT_MASK             (0x7U << 4)
+#define TF_IDMA_CSET_EN              (1U << 3)
+#define TF_IDMA_SBWC_EN              (1U << 2)
+#define TF_IDMA_AFBC_EN              (1U << 1)
+#define TF_IDMA_BLOCK_EN             (1U << 0)
+
+#define TF_IDMA_SPLIT_8K_MASK        0x3U
+#define TF_IDMA_STRIDE_SEL_MASK      (0xfU << 20)
+
+#define TF_FB_ABI_VERSION            1U
+
+#define TF_FB_FLAG_LINEAR            (1U << 0)
+#define TF_FB_FLAG_WRITE_COMBINE     (1U << 1)
+
+/*
+ * One-way userspace handoff guard.
+ *
+ * Before exec'ing Android, TreeForge Bootstrap can SEAL the bridge.
+ * New mmap/open attempts then fail for the remainder of this boot.
+ */
+#define TF_FB_IOCTL_MAGIC            'P'
+#define TF_FB_IOCTL_SEAL             _IO(TF_FB_IOCTL_MAGIC, 0x01)
+
+struct tf_fb_info {
+	__u32 abi_version;
+	__u32 hw_format;
+
+	__u32 width;
+	__u32 height;
+
+	__u32 source_width;
+	__u32 source_height;
+
+	__u32 source_x;
+	__u32 source_y;
+
+	__u32 stride;
+	__u32 bytes_per_pixel;
+
+	__u32 dpp_index;
+	__u32 flags;
+
+	__u64 framebuffer_bytes;
+	__u64 mmap_bytes;
+};
+
+struct tf_candidate {
+	struct tf_fb_info info;
+	phys_addr_t phys;
+};
+
+static struct tf_candidate tf_active;
+static bool tf_ready;
+static bool tf_sealed;
+
+/*
+ * We intentionally support only the simple uncompressed RGB formats
+ * required for the first boot-menu implementation.
+ *
+ * cal_9845:
+ *   0..7 = 32-bit RGB family
+ *   8..9 = RGB565 family
+ *
+ * Start conservatively with the 32-bit family because the existing
+ * TreeForge Bootstrap renderer is also 32-bit oriented.
+ */
+static int tf_bytes_per_pixel(u32 format)
+{
+	if (format <= 7)
+		return 4;
+
+	return -EINVAL;
+}
+
+static bool tf_range_inside(phys_addr_t base, u64 size,
+			    phys_addr_t outer_base, u64 outer_size)
+{
+	u64 end;
+	u64 outer_end;
+
+	if (!size || !outer_size)
+		return false;
+
+	if (check_add_overflow((u64)base, size, &end))
+		return false;
+
+	if (check_add_overflow((u64)outer_base, outer_size, &outer_end))
+		return false;
+
+	return (u64)base >= (u64)outer_base && end <= outer_end;
+}
+
+static struct device_node *
+tf_find_handover_decon(struct device_node *rmem_np)
+{
+	struct device_node *np;
+
+	for_each_compatible_node(np, NULL, "samsung,exynos-decon") {
+		struct device_node *memory_region;
+		bool match;
+
+		memory_region =
+			of_parse_phandle(np, "memory-region", 0);
+
+		if (!memory_region)
+			continue;
+
+		match = memory_region == rmem_np;
+		of_node_put(memory_region);
+
+		if (match)
+			return np;
+	}
+
+	return NULL;
+}
+
+static int
+tf_decode_dpp(struct device_node *dpp_np,
+	      unsigned int dpp_index,
+	      struct reserved_mem *rmem,
+	      struct tf_candidate *out)
+{
+	struct resource dma_res;
+	void __iomem *dma;
+	int dma_index;
+	u32 ctrl0;
+	u32 ctrl1;
+	u32 src_size;
+	u32 src_offset;
+	u32 img_size;
+	u32 stride0;
+	u32 stride1;
+	u32 base;
+	u32 format;
+	u32 rotation;
+	u32 stride_sel;
+	u32 source_width;
+	u32 source_height;
+	u32 source_x;
+	u32 source_y;
+	u32 width;
+	u32 height;
+	u32 stride;
+	u64 framebuffer_bytes;
+	u64 mmap_bytes;
+	int cpp;
+
+	dma_index =
+		of_property_match_string(
+			dpp_np,
+			"reg-names",
+			"dma"
+		);
+
+	if (dma_index < 0)
+		return -ENOENT;
+
+	if (of_address_to_resource(
+		    dpp_np,
+		    dma_index,
+		    &dma_res))
+		return -EINVAL;
+
+	dma = of_iomap(dpp_np, dma_index);
+	if (!dma)
+		return -ENOMEM;
+
+	/*
+	 * Read only the SHADOW state. This is the state corresponding to
+	 * the configuration currently being consumed by the display path.
+	 */
+	ctrl0 = readl(dma +
+		      TF_DMA_SHD_OFFSET +
+		      TF_RDMA_IN_CTRL_0);
+
+	ctrl1 = readl(dma +
+		      TF_DMA_SHD_OFFSET +
+		      TF_RDMA_IN_CTRL_1);
+
+	src_size = readl(dma +
+			 TF_DMA_SHD_OFFSET +
+			 TF_RDMA_SRC_SIZE);
+
+	src_offset = readl(dma +
+			   TF_DMA_SHD_OFFSET +
+			   TF_RDMA_SRC_OFFSET);
+
+	img_size = readl(dma +
+			 TF_DMA_SHD_OFFSET +
+			 TF_RDMA_IMG_SIZE);
+
+	base = readl(dma +
+		     TF_DMA_SHD_OFFSET +
+		     TF_RDMA_BASEADDR_Y8);
+
+	stride0 = readl(dma +
+			TF_DMA_SHD_OFFSET +
+			TF_RDMA_SRC_STRIDE_0);
+
+	stride1 = readl(dma +
+			TF_DMA_SHD_OFFSET +
+			TF_RDMA_SRC_STRIDE_1);
+
+	iounmap(dma);
+
+	format =
+		(ctrl0 & TF_IDMA_IMG_FORMAT_MASK) >> 8;
+
+	rotation =
+		(ctrl0 & TF_IDMA_ROT_MASK) >> 4;
+
+	source_width =
+		src_size & 0xffffU;
+
+	source_height =
+		(src_size >> 16) & 0xffffU;
+
+	source_x =
+		src_offset & 0x3fffU;
+
+	source_y =
+		(src_offset >> 16) & 0x3fffU;
+
+	width =
+		img_size & 0x3fffU;
+
+	height =
+		(img_size >> 16) & 0x3fffU;
+
+	stride_sel =
+		(stride0 & TF_IDMA_STRIDE_SEL_MASK) >> 20;
+
+	cpp = tf_bytes_per_pixel(format);
+	if (cpp < 0)
+		return -ENOTSUPP;
+
+	/*
+	 * Reject every mode that would require understanding or changing
+	 * a nonlinear/compressed/rotated bootloader surface.
+	 */
+	if (ctrl0 &
+	    (TF_IDMA_CSET_EN |
+	     TF_IDMA_SBWC_EN |
+	     TF_IDMA_AFBC_EN |
+	     TF_IDMA_BLOCK_EN))
+		return -ENOTSUPP;
+
+	if (rotation)
+		return -ENOTSUPP;
+
+	if (ctrl1 & TF_IDMA_SPLIT_8K_MASK)
+		return -ENOTSUPP;
+
+	if (!source_width || !source_height ||
+	    !width || !height)
+		return -EINVAL;
+
+	if (source_width > 8192 ||
+	    source_height > 8192 ||
+	    width > 8192 ||
+	    height > 8192)
+		return -EINVAL;
+
+	if (source_x + width > source_width ||
+	    source_y + height > source_height)
+		return -EINVAL;
+
+	/*
+	 * For a linear RGB plane, stride0 is the only relevant explicit
+	 * stride selector.
+	 *
+	 * If hardware does not select an explicit plane-0 stride, the
+	 * natural pitch is source_width * cpp.
+	 *
+	 * Reject any other selected stride plane for this first version.
+	 */
+	if (stride_sel & ~1U)
+		return -ENOTSUPP;
+
+	if (stride_sel & 1U)
+		stride = stride1 & 0xffffU;
+	else
+		stride = source_width * cpp;
+
+	if (!stride ||
+	    stride < source_width * cpp)
+		return -EINVAL;
+
+	framebuffer_bytes =
+		(u64)stride * source_height;
+
+	mmap_bytes =
+		PAGE_ALIGN(framebuffer_bytes);
+
+	if (!PAGE_ALIGNED((phys_addr_t)base))
+		return -EINVAL;
+
+	if (!tf_range_inside(
+		    (phys_addr_t)base,
+		    mmap_bytes,
+		    rmem->base,
+		    rmem->size))
+		return -ERANGE;
+
+	memset(out, 0, sizeof(*out));
+
+	out->phys = (phys_addr_t)base;
+
+	out->info.abi_version =
+		TF_FB_ABI_VERSION;
+
+	out->info.hw_format =
+		format;
+
+	out->info.width =
+		width;
+
+	out->info.height =
+		height;
+
+	out->info.source_width =
+		source_width;
+
+	out->info.source_height =
+		source_height;
+
+	out->info.source_x =
+		source_x;
+
+	out->info.source_y =
+		source_y;
+
+	out->info.stride =
+		stride;
+
+	out->info.bytes_per_pixel =
+		cpp;
+
+	out->info.dpp_index =
+		dpp_index;
+
+	out->info.flags =
+		TF_FB_FLAG_LINEAR |
+		TF_FB_FLAG_WRITE_COMBINE;
+
+	out->info.framebuffer_bytes =
+		framebuffer_bytes;
+
+	out->info.mmap_bytes =
+		mmap_bytes;
+
+	pr_info(
+		"treeforge_bootstrap_fb: candidate dpp=%u phys=%pa "
+		"fmt=%u src=%ux%u+%u+%u image=%ux%u "
+		"stride=%u bytes=%llu\n",
+		dpp_index,
+		&out->phys,
+		format,
+		source_width,
+		source_height,
+		source_x,
+		source_y,
+		width,
+		height,
+		stride,
+		framebuffer_bytes
+	);
+
+	return 0;
+}
+
+static int tf_fb_open(struct inode *inode, struct file *file)
+{
+	if (!tf_ready)
+		return -ENODEV;
+
+	if (READ_ONCE(tf_sealed))
+		return -EPERM;
+
+	return 0;
+}
+
+static ssize_t
+tf_fb_read(struct file *file,
+	   char __user *buffer,
+	   size_t count,
+	   loff_t *position)
+{
+	if (!tf_ready)
+		return -ENODEV;
+
+	return simple_read_from_buffer(
+		buffer,
+		count,
+		position,
+		&tf_active.info,
+		sizeof(tf_active.info)
+	);
+}
+
+static long
+tf_fb_ioctl(struct file *file,
+	    unsigned int command,
+	    unsigned long argument)
+{
+	if (command != TF_FB_IOCTL_SEAL)
+		return -ENOTTY;
+
+	WRITE_ONCE(tf_sealed, true);
+
+	pr_info(
+		"treeforge_bootstrap_fb: bridge sealed for OS handoff\n"
+	);
+
+	return 0;
+}
+
+static int
+tf_fb_mmap(struct file *file,
+	   struct vm_area_struct *vma)
+{
+	unsigned long length;
+	unsigned long pfn;
+
+	if (!tf_ready)
+		return -ENODEV;
+
+	if (READ_ONCE(tf_sealed))
+		return -EPERM;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+
+	if (vma->vm_pgoff != 0)
+		return -EINVAL;
+
+	length =
+		vma->vm_end - vma->vm_start;
+
+	if (!length ||
+	    length > tf_active.info.mmap_bytes)
+		return -EINVAL;
+
+	pfn =
+		(unsigned long)(
+			tf_active.phys >> PAGE_SHIFT
+		);
+
+	vm_flags_set(
+		vma,
+		VM_IO |
+		VM_DONTEXPAND |
+		VM_DONTDUMP
+	);
+
+	vma->vm_page_prot =
+		pgprot_writecombine(
+			vma->vm_page_prot
+		);
+
+	return remap_pfn_range(
+		vma,
+		vma->vm_start,
+		pfn,
+		length,
+		vma->vm_page_prot
+	);
+}
+
+static const struct file_operations tf_fb_fops = {
+	.owner          = THIS_MODULE,
+	.open           = tf_fb_open,
+	.read           = tf_fb_read,
+	.unlocked_ioctl = tf_fb_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl   = tf_fb_ioctl,
+#endif
+	.mmap           = tf_fb_mmap,
+	.llseek         = no_llseek,
+};
+
+static struct miscdevice tf_fb_misc = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name  = "treeforge_bootstrap_fb",
+	.fops  = &tf_fb_fops,
+	.mode  = 0600,
+};
+
+static int __init tf_fb_init(void)
+{
+	struct device_node *rmem_np;
+	struct device_node *decon_np;
+	struct reserved_mem *rmem;
+	unsigned int dpp_index;
+	unsigned int accepted = 0;
+	int ret;
+
+	/*
+	 * This helper is built into the generic TreeForge Bootstrap GKI, but
+	 * the cal_9845 RDMA register contract below is GS201-specific.
+	 *
+	 * Refuse all non-GS201 machines before discovering framebuffer
+	 * handover memory or mapping any display registers.
+	 */
+	if (!of_machine_is_compatible("google,gs201"))
+		return 0;
+
+	pr_info(
+		"treeforge_bootstrap_fb: GS201 runtime identity accepted\n"
+	);
+
+	rmem_np =
+		of_find_compatible_node(
+			NULL,
+			NULL,
+			"exynos,fb_handover"
+		);
+
+	if (!rmem_np)
+		return 0;
+
+	rmem =
+		of_reserved_mem_lookup(rmem_np);
+
+	if (!rmem) {
+		of_node_put(rmem_np);
+		return 0;
+	}
+
+	decon_np =
+		tf_find_handover_decon(
+			rmem_np
+		);
+
+	if (!decon_np) {
+		pr_info(
+			"treeforge_bootstrap_fb: "
+			"handover memory has no owning DECON\n"
+		);
+		of_node_put(rmem_np);
+		return 0;
+	}
+
+	pr_info(
+		"treeforge_bootstrap_fb: "
+		"handover=%pa+0x%llx decon=%pOF\n",
+		&rmem->base,
+		(unsigned long long)rmem->size,
+		decon_np
+	);
+
+	for (dpp_index = 0;
+	     dpp_index < 16;
+	     ++dpp_index) {
+		struct device_node *dpp_np;
+		struct tf_candidate candidate;
+
+		dpp_np =
+			of_parse_phandle(
+				decon_np,
+				"dpps",
+				dpp_index
+			);
+
+		if (!dpp_np)
+			break;
+
+		ret =
+			tf_decode_dpp(
+				dpp_np,
+				dpp_index,
+				rmem,
+				&candidate
+			);
+
+		pr_info(
+			"treeforge_bootstrap_fb: "
+			"dpp=%u node=%pOF decode=%d\n",
+			dpp_index,
+			dpp_np,
+			ret
+		);
+
+		of_node_put(dpp_np);
+
+		if (ret)
+			continue;
+
+		tf_active = candidate;
+		accepted++;
+	}
+
+	of_node_put(decon_np);
+	of_node_put(rmem_np);
+
+	/*
+	 * Ambiguity is a hard failure.
+	 *
+	 * We never guess which bootloader buffer is live.
+	 */
+	if (accepted != 1) {
+		pr_warn(
+			"treeforge_bootstrap_fb: "
+			"refusing ambiguous scanout candidates=%u\n",
+			accepted
+		);
+
+		memset(
+			&tf_active,
+			0,
+			sizeof(tf_active)
+		);
+
+		return 0;
+	}
+
+	ret = misc_register(&tf_fb_misc);
+	if (ret) {
+		pr_err(
+			"treeforge_bootstrap_fb: "
+			"misc_register failed=%d\n",
+			ret
+		);
+
+		memset(
+			&tf_active,
+			0,
+			sizeof(tf_active)
+		);
+
+		return ret;
+	}
+
+	tf_ready = true;
+
+	pr_info(
+		"TREEFORGE_BOOTSTRAP_FB_READY "
+		"dpp=%u format=%u "
+		"src=%ux%u offset=%u,%u "
+		"visible=%ux%u stride=%u "
+		"phys=%pa mmap=%llu\n",
+		tf_active.info.dpp_index,
+		tf_active.info.hw_format,
+		tf_active.info.source_width,
+		tf_active.info.source_height,
+		tf_active.info.source_x,
+		tf_active.info.source_y,
+		tf_active.info.width,
+		tf_active.info.height,
+		tf_active.info.stride,
+		&tf_active.phys,
+		tf_active.info.mmap_bytes
+	);
+
+	return 0;
+}
+
+device_initcall(tf_fb_init);
+
+MODULE_DESCRIPTION(
+	"TreeForge Bootstrap GS201 bootloader framebuffer bridge"
+);
+MODULE_LICENSE("GPL");
