def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def build_signing_key(signing: str) -> Path | None:
    if signing == "none":
        return None

    if signing == "aosp":
        materialize_aosp_keyset()
        key = AOSP_BUILD_BOOT_KEY
        need_file(key)

        actual = file_sha256(key)

        if actual != AOSP_BUILD_BOOT_KEY_SHA256:
            raise KernelCtlError(
                "AOSP boot test key identity mismatch:\n"
                f"  expected={AOSP_BUILD_BOOT_KEY_SHA256}\n"
                f"  actual={actual}\n"
                f"  path={key}"
            )

        public = public_key_sha1(key)

        if public != AOSP_BUILD_BOOT_PUBLIC_SHA1:
            raise KernelCtlError(
                "AOSP boot test public-key identity mismatch:\n"
                f"  expected={AOSP_BUILD_BOOT_PUBLIC_SHA1}\n"
                f"  actual={public}"
            )

        return key

    if signing == "treeforge":
        key = _treeforge_owner_keyset_dir() / "boot.pem"
        need_file(key)
        return key

    raise KernelCtlError(
        f"unsupported build signing provider: {signing}"
    )


