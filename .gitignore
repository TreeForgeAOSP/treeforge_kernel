# ----------------------------------------------------------------------
# TreeForge kernel wrapper repository
#
# The Google kernel checkout below this directory is managed by repo and
# its individual Git projects.  This wrapper repository owns only
# TreeForge orchestration and metadata.
# ----------------------------------------------------------------------

# Google repo metadata
/.repo/

# Google/AOSP kernel source projects
/aosp/
/build/
/common/
/external/
/kernel/
/prebuilts/
/private/

# Generated/output state
/out/
/.smoke/
/__pycache__/
*.pyc

# Bazel output links
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-treeforge_kernel

# Root links/files generated by Google's kernel workspace
/build_*.sh
/.[a-zA-Z0-9]*.bazelrc
/device.bazelrc
/update_symbol_list.sh
/WORKSPACE

# tools/ contains Google projects and TreeForge-owned tooling.
# Ignore everything there except TreeForge's namespace.
/tools/*
!/tools/treeforge/
!/tools/treeforge/**

# Editor / transient files
*~
*.swp
*.swo

# Python-generated files inside the re-included TreeForge namespace.
# Keep these after the /tools/treeforge/** exception so they remain ignored.
/tools/treeforge/**/__pycache__/
*.pyc
*.pyo
.providers/

# TreeForge Stage-1 host tooling
!/tools/stage1_vendor_kernel_boot.py
