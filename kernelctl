    #   Proceed with flash? [y/N]
    #
    # confirmation before touching the device.
    #
    flash(
        package,
        slot,
        active,
        reboot,
    )

    return 0



def detect_transport():
    adb = subprocess.run(
        ["adb", "get-state"],
        text=True,
        capture_output=True,
    )

    if adb.returncode == 0 and "device" in adb.stdout:
        return "adb"

    fb = subprocess.run(
        ["fastboot", "devices"],
        text=True,
        capture_output=True,
    )

    if fb.stdout.strip():
        userspace = subprocess.run(
            ["fastboot", "getvar", "is-userspace"],
            text=True,
            capture_output=True,
        )

        text = userspace.stdout + userspace.stderr

        if "yes" in text:
            return "fastbootd"

        return "bootloader"

    return "none"


def ensure_bootloader():
    transport = detect_transport()

    if transport == "adb":
        run(["adb", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "fastbootd":
        run(["fastboot", "reboot", "bootloader"])
        time.sleep(4)

    elif transport == "bootloader":
        pass

    else:
        raise KernelCtlError("no ADB/Fastboot device detected")

    product = output(["fastboot", "getvar", "product"])

    if DEVICE not in product:
        raise KernelCtlError(
            f"refusing to flash non-{DEVICE} device"
        )

    unlocked = output(["fastboot", "getvar", "unlocked"])

    if "yes" not in unlocked.lower():
        raise KernelCtlError("device bootloader is not unlocked")


def ensure_fastbootd():
    ensure_bootloader()

    run(["fastboot", "reboot", "fastboot"])
    time.sleep(5)

    state = output(["fastboot", "getvar", "is-userspace"])

    if "yes" not in state.lower():
        raise KernelCtlError("failed to enter fastbootd")


def flash(stage: Path, slot: str, active: str, reboot: bool):
    if slot not in ("a", "b", "both"):
        raise KernelCtlError("flash slot must be a, b, or both")

    slots = ("a", "b") if slot == "both" else (slot,)

    if active not in ("keep", "a", "b"):
        raise KernelCtlError("active slot must be keep, a, or b")

    print()
    print("FLASH PLAN")
    print("----------")
    print(f"Target slot:       {slot.upper() if slot != 'both' else 'A + B'}")
    print(f"Active after:      {active}")
    print(f"Reboot Android:    {'YES' if reboot else 'NO'}")
    print()
    print("Physical:")
    for target_slot in slots:
        print(f"  boot_{target_slot}")
        print(f"  init_boot_{target_slot}")
        print(f"  dtbo_{target_slot}")
        print(f"  vendor_boot_{target_slot}")
        print(f"  vendor_kernel_boot_{target_slot}")
        print(f"  vbmeta_{target_slot}")
        print(f"  vbmeta_system_{target_slot}")
        print(f"  vbmeta_vendor_{target_slot}")

    print()
    print("Logical:")
    for target_slot in slots:
        print(f"  vendor_dlkm_{target_slot}")
        print(f"  system_dlkm_{target_slot}")
    print()

    while True:
        answer = input("Proceed with flash? [y/N]: ").strip().lower()

        if answer in ("", "n", "no"):
            print("Flash cancelled.")
            return

        if answer in ("y", "yes"):
            break

        print("Please answer yes or no.")

    ensure_bootloader()

    physical = (
        ("boot", "boot.img"),
        ("init_boot", "init_boot.img"),
        ("dtbo", "dtbo.img"),
        ("vendor_boot", "vendor_boot.img"),
        ("vendor_kernel_boot", "vendor_kernel_boot.img"),
        ("vbmeta_system", "vbmeta_system.img"),
        ("vbmeta_vendor", "vbmeta_vendor.img"),
        ("vbmeta", "vbmeta.img"),
    )

    for target_slot in slots:
        for partition, filename in physical:
            run([
                "fastboot",
                "flash",
                f"{partition}_{target_slot}",
                stage / filename,
            ])

    ensure_fastbootd()

    for target_slot in slots:
        run([
            "fastboot",
            "flash",
            f"vendor_dlkm_{target_slot}",
            stage / "vendor_dlkm.img",
        ])

        run([
            "fastboot",
            "flash",
            f"system_dlkm_{target_slot}",
            stage / "system_dlkm.img",
        ])

    # Always return to bootloader before final slot/reboot choice.
    run(["fastboot", "reboot", "bootloader"])
    time.sleep(4)

    if active in ("a", "b"):
        run(["fastboot", f"--set-active={active}"])

    current = output(["fastboot", "getvar", "current-slot"])
    print(current.strip())

    if reboot:
        run(["fastboot", "reboot"])
    else:
        print("Device left in bootloader fastboot.")


def choose(prompt, choices):
    print()
    print(prompt)

    for index, (label, value) in enumerate(choices, 1):
        print(f"  {index}) {label}")

    while True:
        answer = input("> ").strip()

        try:
            index = int(answer)
        except ValueError:
            continue

        if 1 <= index <= len(choices):
            return choices[index - 1][1]


def interactive():
    provider = choose(
        "Signing provider:",
        [
            ("AOSP test keys", "aosp"),
            ("TreeForge development keys", "treeforge"),
        ],
    )

    stage = package(provider)

    do_flash = choose(
        "Flash this package?",
        [
            ("No - package only", False),
            ("Yes", True),
        ],
    )

    if not do_flash:
        return

    slot = choose(
        "Flash target slot:",
        [
            ("Slot A", "a"),
            ("Slot B", "b"),
            ("Both slots A + B", "both"),
        ],
    )

    active = choose(
        "Active slot after flashing:",
        [
            ("Keep current active slot", "keep"),
            ("Set slot A active", "a"),
            ("Set slot B active", "b"),
        ],
    )

    reboot = choose(
        "Reboot Android after flashing?",
        [
            ("No - leave in bootloader", False),
            ("Yes", True),
        ],
    )

    flash(stage, slot, active, reboot)



def setup_run(args, *, cwd: Path):
    print("+", " ".join(str(value) for value in args))

    result = subprocess.run(
        [str(value) for value in args],
        cwd=str(cwd),
        text=True,
        check=False,
    )

    if result.returncode != 0:
        raise KernelCtlError(
            f"command failed ({result.returncode}): "
            + " ".join(str(value) for value in args)
        )

    return result


def setup_definition(root: Path) -> tuple[dict, list[dict]]:
    lock_path = (
        root
        / "provenance"
        / "google"
        / KERNEL_PROVIDER_RELEASE
        / "SOURCE_LOCK.json"
    )

    manifest_path = root / SETUP_MANIFEST_NAME

    if not lock_path.is_file():
        raise KernelCtlError(
            f"source lock missing: {lock_path}"
        )

    if not manifest_path.is_file():
        raise KernelCtlError(
            f"source manifest missing: {manifest_path}"
        )

    lock = json.loads(
        lock_path.read_text(encoding="utf-8")
    )

    if lock.get("schema") != 1:
        raise KernelCtlError(
            "unsupported setup source-lock schema"
        )

    if lock.get("device") != DEVICE:
        raise KernelCtlError(
            "setup source-lock device mismatch"
        )

    if lock.get("kernel_release") != KERNEL_PROVIDER_RELEASE:
        raise KernelCtlError(
            "setup source-lock release mismatch"
        )

    locked = lock.get("projects")

    if not isinstance(locked, dict) or len(locked) != 73:
        raise KernelCtlError(
            "setup source lock must contain exactly 73 projects"
        )

    excluded = lock.get("excluded_google_prebuilts")

    if not isinstance(excluded, list) or len(excluded) != 7:
        raise KernelCtlError(
            "setup source lock must exclude exactly 7 Google "
            "prebuilt projects"
        )

    required_excluded = (
        "platform/prebuilts/gcc/linux-x86/host/"
        "x86_64-linux-glibc2.17-4.8"
    )

    if required_excluded not in excluded:
        raise KernelCtlError(
            "GCC/glibc project missing from excluded provider set"
        )

    xml_root = ET.parse(manifest_path).getroot()
    projects = []

    for project in xml_root.findall("project"):
        record = dict(project.attrib)

        path = record.get("path")
        name = record.get("name")
        revision = record.get("revision")

        if not path or not name:
            raise KernelCtlError(
                "source manifest contains project without path/name"
            )

        if re.fullmatch(r"[0-9a-f]{40}", revision or "") is None:
            raise KernelCtlError(
                f"source manifest is not SHA pinned: {path}"
            )

        expected = locked.get(path)

        if not isinstance(expected, dict):
            raise KernelCtlError(
                f"source manifest path absent from lock: {path}"
            )

        if expected.get("name") != name:
            raise KernelCtlError(
                f"source manifest name mismatch: {path}"
            )

        if expected.get("revision") != revision:
            raise KernelCtlError(
                f"source manifest revision mismatch: {path}"
            )

        if record.get("clone-depth") != "1":
            raise KernelCtlError(
                f"source manifest is not depth-1: {path}"
            )

        projects.append(record)

    if len(projects) != 73:
        raise KernelCtlError(
            f"source manifest must contain 73 projects, "
            f"found {len(projects)}"
        )

    return lock, projects


def setup_provider_definition(root: Path) -> dict:
    path = (
        root
        / "tools"
        / "treeforge"
        / "providers"
        / "manifests"
        / "kernel"
        / KERNEL_PROVIDER_RELEASE
        / "google-providers.json"
    )

    if not path.is_file():
        raise KernelCtlError(
            f"kernel provider manifest missing: {path}"
        )

    data = json.loads(path.read_text(encoding="utf-8"))
    providers = data.get("providers")

    if not isinstance(providers, dict):
        raise KernelCtlError(
            "kernel provider manifest is invalid"
        )

    if len(providers) != 7:
        raise KernelCtlError(
            f"expected 7 kernel build providers, "
            f"found {len(providers)}"
        )

    gcc = providers.get("gcc-glibc")

    expected_path = (
        "prebuilts/gcc/linux-x86/host/"
        "x86_64-linux-glibc2.17-4.8"
    )

    if (
        not isinstance(gcc, dict)
        or gcc.get("workspace_path") != expected_path
        or gcc.get("revision")
        != "f6d40532273c8bd628b960ecc0970c7294c8d891"
    ):
        raise KernelCtlError(
            "GCC/glibc provider contract is incomplete"
        )

    return data


def verify_setup_checkout(
    destination: Path,
    lock: dict,
) -> None:
    mismatches = []

    for path, record in sorted(lock["projects"].items()):
        project = destination / path

        result = subprocess.run(
            [
                "git",
                "-C",
                str(project),
                "rev-parse",
                "HEAD",
            ],
            text=True,
            capture_output=True,
            check=False,
        )

        actual = result.stdout.strip()

        if (
            result.returncode != 0
            or actual != record["revision"]
        ):
            mismatches.append(
                (
                    path,
                    record["revision"],
                    actual or "<unavailable>",
                )
            )

    if mismatches:
        sample = "\n".join(
            f"  {path}\n"
            f"    expected={expected}\n"
            f"    actual={actual}"
            for path, expected, actual in mismatches[:10]
        )

        raise KernelCtlError(
            "fresh source checkout does not match SOURCE_LOCK:\n"
            + sample
        )


def setup_command(argv) -> int:
    parser = argparse.ArgumentParser(
        prog="kernelctl setup",
        description=(
            "reconstruct the pinned TreeForge Tangorpro "
            "kernel workspace"
        ),
    )

    parser.add_argument(
        "--destination",
        type=Path,
        help=(
            "workspace destination; default is this "
            "treeforge_kernel checkout"
        ),
    )

    parser.add_argument(
        "--manifest-url",
        default=SETUP_MANIFEST_URL,
        help="TreeForge kernel manifest/superproject repository",
    )

    parser.add_argument(
        "--manifest-branch",
        default=SETUP_MANIFEST_BRANCH,
        help="TreeForge manifest branch",
    )

    parser.add_argument(
        "--jobs",
        type=int,
        default=4,
        help="repo sync parallelism",
    )

    parser.add_argument(
        "--plan-only",
        action="store_true",
        help="validate and print the setup plan without syncing",
    )

    args = parser.parse_args(argv)

    if args.jobs < 1:
        raise KernelCtlError("--jobs must be at least 1")

    destination = (
        args.destination.expanduser().resolve()
        if args.destination is not None
        else ROOT.resolve()
    )

    lock, projects = setup_definition(ROOT)
    provider_data = setup_provider_definition(ROOT)

    print("TreeForge Kernel Setup")
    print("======================")
    print()
    print(f"Source checkout:     {ROOT}")
    print(f"Destination:         {destination}")
    print(f"Manifest repository:{' '}{args.manifest_url}")
    print(f"Manifest branch:     {args.manifest_branch}")
    print(f"Manifest:            {SETUP_MANIFEST_NAME}")
    print(f"Kernel release:      {KERNEL_PROVIDER_RELEASE}")
    print(f"Source projects:     {len(projects)}")
    print(
        f"Build providers:     "
        f"{len(provider_data['providers'])}"
    )
    print("Clone depth:         1")
    print("Project revisions:   exact SHA")
    print("Google tags:         not synced")
    print()

    print("Excluded Google prebuilt projects")
    print("---------------------------------")
    for name in sorted(lock["excluded_google_prebuilts"]):
        print(f"  {name}")

    print()

    if args.plan_only:
        print("PLAN ONLY: YES")
        print("SYNC STARTED: NO")
        print("BUILD STARTED: NO")
        print("DEVICE MODIFIED: NO")
        return 0

    if destination == ROOT.resolve():
        if (destination / ".repo").exists():
            raise KernelCtlError(
                "this checkout already contains .repo; "
                "use --destination for fresh reconstruction "
                "acceptance"
            )
    else:
        if destination.exists():
            entries = list(destination.iterdir())

            if entries:
                raise KernelCtlError(
                    f"destination is not empty: {destination}"
                )
        else:
            destination.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

        setup_run(
            [
                "git",
                "clone",
                "--branch",
                args.manifest_branch,
                "--single-branch",
                args.manifest_url,
                destination,
            ],
            cwd=destination.parent,
        )

        destination_lock, _ = setup_definition(destination)

        if destination_lock["projects"] != lock["projects"]:
            raise KernelCtlError(
                "fresh TreeForge clone source lock differs "
                "from invoking checkout"
            )

        setup_provider_definition(destination)

    repo = need_command("repo")

    setup_run(
        [
            repo,
            "init",
            "-u",
            args.manifest_url,
            "-b",
            args.manifest_branch,
            "-m",
            SETUP_MANIFEST_NAME,
            "--depth=1",
        ],
        cwd=destination,
    )

    setup_run(
        [
            repo,
            "sync",
            "-c",
            "--no-tags",
            "--fail-fast",
            f"-j{args.jobs}",
        ],
        cwd=destination,
    )

    verify_setup_checkout(destination, lock)

    provider_root = (
        destination
        / "tools"
        / "treeforge"
        / "providers"
    )

    cache = (
        provider_root
        / "scripts"
        / "kernel-provider-cache"
    )

    materialize = (
        provider_root
        / "scripts"
        / "kernel-provider-materialize"
    )

    treeforge_tools = (
        provider_root
        / "scripts"
        / "kernel-treeforge-tools"
    )

    for required in (cache, materialize, treeforge_tools):
        if not required.is_file():
            raise KernelCtlError(
                f"provider helper missing: {required}"
            )

    print()
    print("Preparing kernel build providers")
    print("--------------------------------")

    setup_run(
        [
            cache,
            "--release",
            KERNEL_PROVIDER_RELEASE,
            "fetch",
            "all",
        ],
        cwd=destination,
    )

    setup_run(
        [
            cache,
            "--release",
            KERNEL_PROVIDER_RELEASE,
            "verify",
            "all",
        ],
        cwd=destination,
    )

    setup_run(
        [
            materialize,
            "--release",
            KERNEL_PROVIDER_RELEASE,
            "--workspace",
            destination,
            "materialize",
        ],
        cwd=destination,
    )

    setup_run(
        [
            materialize,
            "--release",
            KERNEL_PROVIDER_RELEASE,
            "--workspace",
            destination,
            "status",
        ],
        cwd=destination,
    )

    setup_run(
        [
            treeforge_tools,
            "prepare",
        ],
        cwd=destination,
    )

    setup_run(
        [
            treeforge_tools,
            "verify",
        ],
        cwd=destination,
    )

    gcc_path = (
        destination
        / "prebuilts"
        / "gcc"
        / "linux-x86"
        / "host"
        / "x86_64-linux-glibc2.17-4.8"
    )

    if not gcc_path.exists():
        raise KernelCtlError(
            f"GCC/glibc provider was not materialized: {gcc_path}"
        )

    print()
    print("Fresh source identity")
    print("---------------------")
    print("Projects verified: 73/73")
    print("Providers ready:   7/7")
    print()

    subprocess.run(
        ["du", "-sh", str(destination)],
        text=True,
        check=False,
    )

    subprocess.run(
        ["du", "-sh", str(destination / ".repo")],
        text=True,
        check=False,
    )

    print()
    print("TreeForge kernel setup complete.")
    print("BUILD STARTED: NO")
    print("DEVICE MODIFIED: NO")

    return 0



def normalize_command(argv) -> int:
    parser = argparse.ArgumentParser(
        prog="kernelctl normalize",
        description=(
            "Return TreeForge-managed kernel source "
            "patches to their pinned pristine source state"
        ),
    )

    parser.add_argument(
        "--profile",
        choices=BUILD_PROFILE_ORDER,
        required=True,
        help=(
            "profile whose pinned source workspace "
            "must be verified after normalization"
        ),
    )

    args = parser.parse_args(argv)

    profile = resolve_build_profile(
        args.profile
    )

    print_build_profile(
        profile
    )

    profile_data = load_build_profile(
        profile
    )

    source_lock = load_profile_source_lock(
        profile_data
    )

    #
    # Use the exact same managed-patch normalization authority
    # used by the normal build path.
    #
    # Applied managed patches are reversed.
    # Pristine patches remain pristine.
    # Unknown divergence remains a hard failure.
    #
    normalize_selected_profile_patches(profile_data)

    ensure_profile_source_workspace(
        source_lock
    )

    verify_source_workspace_clean(
        source_lock
    )

    print()
    print("Kernel profile source normalized")
    print("--------------------------------")
    print(f"Profile: {profile}")
    print("Managed source: PRISTINE")
    print("BUILD STARTED: NO")
    print("DEVICE MODIFIED: NO")
    print("ADB INVOKED: NO")
    print("FASTBOOT INVOKED: NO")

    return 0

