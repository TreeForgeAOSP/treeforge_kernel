# ---------------------------------------------------------------------------
# TREEFORGE_STAGE0_PROOF_V1
#
# Experimental packaging-only Stage-0 feasibility transform.
#
# This never alters kernel source or raw build output. It operates only on
# the package copy of boot.img after its old AVB footer has been removed.
# ---------------------------------------------------------------------------


def _stage0_align_up(
    value: int,
    alignment: int,
) -> int:
    return (
        value + alignment - 1
    ) & ~(alignment - 1)


def _stage0_decode_branch(
    instruction: int,
    pc: int,
) -> int:
    if (
        instruction & 0x7C000000
    ) != 0x14000000:
        raise KernelCtlError(
            "Stage-0 source Image code1 is not an "
            f"AArch64 B instruction: 0x{instruction:08x}"
        )

    immediate = (
        instruction & 0x03FFFFFF
    )

    if immediate & (1 << 25):
        immediate -= 1 << 26

    return pc + (immediate << 2)


def _stage0_encode_branch(
    pc: int,
    target: int,
) -> int:
    delta = target - pc

    if delta % 4:
        raise KernelCtlError(
            "Stage-0 branch target is not 4-byte aligned"
        )

    if (
        delta < -(1 << 27)
        or delta >= (1 << 27)
    ):
        raise KernelCtlError(
            "Stage-0 branch target exceeds AArch64 B range"
        )

    return (
        0x14000000
        | (
            (delta >> 2)
            & 0x03FFFFFF
        )
    )


def _stage0_movz_x(
    register: int,
    immediate: int,
    shift: int,
) -> int:
    if shift not in (0, 16):
        raise KernelCtlError(
            "unsupported Stage-0 MOVZ shift"
        )

    return (
        0xD2800000
        | ((shift // 16) << 21)
        | ((immediate & 0xFFFF) << 5)
        | (register & 31)
    )


def _stage0_movk_x(
    register: int,
    immediate: int,
    shift: int,
) -> int:
    if shift not in (0, 16):
        raise KernelCtlError(
            "unsupported Stage-0 MOVK shift"
        )

    return (
        0xF2800000
        | ((shift // 16) << 21)
        | ((immediate & 0xFFFF) << 5)
        | (register & 31)
    )


def _stage0_transform_arm64_image(
    source: bytes,
) -> tuple[bytes, dict]:
    if len(source) < 0x10000:
        raise KernelCtlError(
            "Stage-0 source Image is unexpectedly small"
        )

    def u16(offset: int) -> int:
        return struct.unpack_from(
            "<H",
            source,
            offset,
        )[0]

    def u32(offset: int) -> int:
        return struct.unpack_from(
            "<I",
            source,
            offset,
        )[0]

    if u32(0x38) != 0x644D5241:
        raise KernelCtlError(
            "Stage-0 source Image ARM64 magic mismatch"
        )

    source_code0 = u32(0x00)
    source_code1 = u32(0x04)

    primary_rva = _stage0_decode_branch(
        source_code1,
        0x04,
    )

    pe_offset = u32(0x3C)

    if (
        pe_offset + 24 > len(source)
        or source[
            pe_offset:
            pe_offset + 4
        ] != b"PE\x00\x00"
    ):
        raise KernelCtlError(
            "Stage-0 source Image PE signature mismatch"
        )

    coff = pe_offset + 4

    if u16(coff + 0) != 0xAA64:
        raise KernelCtlError(
            "Stage-0 source PE machine is not ARM64"
        )

    section_count = u16(coff + 2)
    optional_size = u16(coff + 16)
    optional = coff + 20

    if u16(optional + 0) != 0x020B:
        raise KernelCtlError(
            "Stage-0 source PE is not PE32+"
        )

    section_table = (
        optional + optional_size
    )

    data_section = None

    for index in range(section_count):
        offset = (
            section_table
            + index * 40
        )

        if offset + 40 > len(source):
            raise KernelCtlError(
                "Stage-0 PE section table exceeds Image"
            )

        name = (
            source[
                offset:
                offset + 8
            ]
            .split(b"\x00", 1)[0]
        )

        if name == b".data":
            data_section = {
                "index": index,
                "offset": offset,
                "virtual_size": u32(
                    offset + 8
                ),
                "virtual_address": u32(
                    offset + 12
                ),
                "raw_size": u32(
                    offset + 16
                ),
                "raw_offset": u32(
                    offset + 20
                ),
                "flags": u32(
                    offset + 36
                ),
            }

            break

    if data_section is None:
        raise KernelCtlError(
            "Stage-0 source Image has no .data section"
        )

    data_va = data_section[
        "virtual_address"
    ]

    data_vsize = data_section[
        "virtual_size"
    ]

    data_raw = data_section[
        "raw_offset"
    ]

    data_raw_size = data_section[
        "raw_size"
    ]

    data_end = (
        data_raw
        + data_raw_size
    )

    virtual_end = (
        data_va
        + data_vsize
    )

    if data_raw != data_va:
        raise KernelCtlError(
            "Stage-0 requires identity-mapped .data "
            "raw/virtual offsets"
        )

    if len(source) != data_end:
        raise KernelCtlError(
            "Stage-0 source Image does not end at "
            ".data raw end"
        )

    stage0_rva = data_end

    #
    # Exact 32-byte trampoline proven by the standalone R2 lab:
    #
    #   adr  x9, stage0_entry
    #   movz x10, stage0_rva low16
    #   movk x10, stage0_rva high16
    #   sub  x9, x9, x10
    #   movz x10, primary_rva low16
    #   movk x10, primary_rva high16
    #   add  x10, x9, x10
    #   br   x10
    #
    words = (
        0x10000009,
        _stage0_movz_x(
            10,
            stage0_rva & 0xFFFF,
            0,
        ),
        _stage0_movk_x(
            10,
            (
                stage0_rva >> 16
            ) & 0xFFFF,
            16,
        ),
        0xCB0A0129,
        _stage0_movz_x(
            10,
            primary_rva & 0xFFFF,
            0,
        ),
        _stage0_movk_x(
            10,
            (
                primary_rva >> 16
            ) & 0xFFFF,
            16,
        ),
        0x8B0A012A,
        0xD61F0140,
    )

    stage0 = struct.pack(
        "<8I",
        *words,
    )

    if len(stage0) != 32:
        raise KernelCtlError(
            "Stage-0 trampoline size contract failed"
        )

    size_of_initialized_data = struct.unpack_from(
        "<I",
        source,
        optional + 8,
    )[0]

    file_alignment = struct.unpack_from(
        "<I",
        source,
        optional + 36,
    )[0]

    if file_alignment == 0:
        raise KernelCtlError(
            "Stage-0 PE file alignment is zero"
        )

    new_raw_size = _stage0_align_up(
        data_raw_size
        + len(stage0),
        file_alignment,
    )

    if (
        data_va
        + new_raw_size
        > virtual_end
    ):
        raise KernelCtlError(
            "Stage-0 trampoline exceeds existing "
            ".data virtual tail"
        )

    candidate = bytearray(source)

    candidate.extend(stage0)

    candidate.extend(
        b"\x00"
        * (
            data_raw
            + new_raw_size
            - len(candidate)
        )
    )

    new_code1 = _stage0_encode_branch(
        0x04,
        stage0_rva,
    )

    struct.pack_into(
        "<I",
        candidate,
        0x04,
        new_code1,
    )

    struct.pack_into(
        "<I",
        candidate,
        data_section["offset"] + 16,
        new_raw_size,
    )

    #
    # Preserve read/write and add execute for the tiny Stage-0 tail.
    #
    new_flags = (
        data_section["flags"]
        | 0x20000000
    )

    struct.pack_into(
        "<I",
        candidate,
        data_section["offset"] + 36,
        new_flags,
    )

    initialized_delta = (
        new_raw_size
        - data_raw_size
    )

    struct.pack_into(
        "<I",
        candidate,
        optional + 8,
        size_of_initialized_data
        + initialized_delta,
    )

    if struct.unpack_from(
        "<I",
        candidate,
        0x00,
    )[0] != source_code0:
        raise KernelCtlError(
            "Stage-0 unexpectedly changed code0"
        )

    if _stage0_decode_branch(
        struct.unpack_from(
            "<I",
            candidate,
            0x04,
        )[0],
        0x04,
    ) != stage0_rva:
        raise KernelCtlError(
            "Stage-0 code1 redirect verification failed"
        )

    if (
        candidate[
            stage0_rva:
            stage0_rva + 32
        ]
        != stage0
    ):
        raise KernelCtlError(
            "Stage-0 trampoline payload identity failed"
        )

    return bytes(candidate), {
        "schema": 1,
        "mode": "treeforge-stage0-proof",
        "source_image_sha256": hashlib.sha256(
            source
        ).hexdigest(),
        "candidate_image_sha256": hashlib.sha256(
            candidate
        ).hexdigest(),
        "source_image_bytes": len(source),
        "candidate_image_bytes": len(candidate),
        "original_code1": (
            f"0x{source_code1:08x}"
        ),
        "original_primary_rva": (
            f"0x{primary_rva:x}"
        ),
        "stage0_code1": (
            f"0x{new_code1:08x}"
        ),
        "stage0_rva": (
            f"0x{stage0_rva:x}"
        ),
        "stage0_bytes": len(stage0),
        "data_raw_size_source": (
            f"0x{data_raw_size:x}"
        ),
        "data_raw_size_final": (
            f"0x{new_raw_size:x}"
        ),
        "data_virtual_size": (
            f"0x{data_vsize:x}"
        ),
        "data_flags_source": (
            f"0x{data_section['flags']:08x}"
        ),
        "data_flags_final": (
            f"0x{new_flags:08x}"
        ),
        "pe_initialized_data_source": (
            f"0x{size_of_initialized_data:x}"
        ),
        "pe_initialized_data_final": (
            f"0x{size_of_initialized_data + initialized_delta:x}"
        ),
    }


def _verify_stage0_generation(
    generation: Path,
) -> None:
    """
    Accept modern generations through build.json profile metadata.

    The hardware-accepted 20261005-234423-0400 generation predates
    that metadata field. Permit only that exact historical generation,
    and only while its accepted package identities remain exact.
    """
    metadata = (
        generation
        / "metadata"
        / "build.json"
    )

    if metadata.is_file():
        try:
            payload = json.loads(
                metadata.read_text(
                    encoding="utf-8"
                )
            )
        except Exception as error:
            raise KernelCtlError(
                "unable to read Stage-0 source generation "
                f"metadata: {metadata}: {error}"
            ) from error

        if (
            payload.get("build_profile")
            != "treeforge-bootstrap"
        ):
            raise KernelCtlError(
                "Stage-0 proof requires a completed "
                "treeforge-bootstrap generation; got "
                f"{payload.get('build_profile')!r}"
            )

        print(
            "Stage-0 generation gate: "
            "modern build-profile metadata PASS"
        )

        return

    historical = (
        ROOT
        / "out"
        / "source"
        / "20261005-234423-0400"
    ).resolve()

    actual_generation = generation.resolve()

    if actual_generation != historical:
        raise KernelCtlError(
            "Stage-0 generation lacks modern build-profile "
            "metadata and is not the one accepted historical "
            "treeforge-bootstrap generation:\n"
            f"  generation={actual_generation}\n"
            f"  accepted={historical}"
        )

    package_manifest = (
        generation
        / "metadata"
        / "package.json"
    )

    need_file(package_manifest)

    try:
        package_payload = json.loads(
            package_manifest.read_text(
                encoding="utf-8"
            )
        )
    except Exception as error:
        raise KernelCtlError(
            "unable to read historical package metadata: "
            f"{package_manifest}: {error}"
        ) from error

    if (
        package_payload.get("kernel_release")
        != "android-15.0.0_r0.94"
    ):
        raise KernelCtlError(
            "historical Stage-0 generation kernel release "
            "identity mismatch"
        )

    expected = {
        "boot.img":
            "e76754420d5b03918efc77b4d4a16bc"
            "3fed3d0888a9f323e1efb51aef1f4d2e2",
        "vendor_kernel_boot.img":
            "e966eb5212f5c2599c89edfbe231f724"
            "605a990cf472046752c5d29f27c2b885",
        "vendor_dlkm.img":
            "e3603cd6957ceb5b3beca297c794cd346"
            "b8512b7ec09d2e573800c8f6a688cc4",
        "system_dlkm.img":
            "07f497f7b22a566f865a647cc65c7b62"
            "c7514c69ca8e656c2e6e038af5a66269",
    }

    package = generation / "package"

    for name, expected_sha in expected.items():
        artifact = package / name

        need_file(artifact)

        actual_sha = file_sha256(
            artifact
        )

        if actual_sha != expected_sha:
            raise KernelCtlError(
                "historical Stage-0 generation identity "
                f"mismatch for {name}:\n"
                f"  expected={expected_sha}\n"
                f"  actual={actual_sha}"
            )

    print(
        "Stage-0 generation gate: "
        "accepted historical treeforge-bootstrap "
        "generation PASS"
    )

    print(
        "Historical generation: "
        "20261005-234423-0400"
    )

    print(
        "Historical package identities: PASS"
    )



def _stage0_build_ufs_hci_gate(
