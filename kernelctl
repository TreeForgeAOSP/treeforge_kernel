def main():
    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help"):
        print_top_level_help()
        return 0

    if len(sys.argv) >= 2 and sys.argv[1] == "normalize":
        try:
            return normalize_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(
                f"\nERROR: {error}",
                file=sys.stderr,
            )
            return 1

    if len(sys.argv) >= 2 and sys.argv[1] == "setup":
        try:
            return setup_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(f"\nERROR: {error}", file=sys.stderr)
            return 1

    if len(sys.argv) >= 2 and sys.argv[1] == "build":
        try:
            return build_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(f"\nERROR: {error}", file=sys.stderr)
            return 1

    if len(sys.argv) >= 2 and sys.argv[1] == "release":
        try:
            return release_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(f"\nERROR: {error}", file=sys.stderr)
            return 1

    if len(sys.argv) >= 2 and sys.argv[1] == "flash":
        try:
            return flash_command(sys.argv[2:])
        except KeyboardInterrupt:
            print("\nCancelled.")
            return 130
        except KernelCtlError as error:
            print(f"\nERROR: {error}", file=sys.stderr)
            return 1

    parser = argparse.ArgumentParser(
        prog="kernelctl",
        description=(
            "TreeForge tangorpro kernel packaging/signing/flashing CLI"
        ),
    )

    parser.add_argument(
        "--signing",
        choices=("aosp", "treeforge"),
        help="AVB signing provider",
    )

    parser.add_argument(
        "--package-only",
        action="store_true",
        help="package/sign but do not flash",
    )

    parser.add_argument(
        "--slot",
        choices=("a", "b", "both"),
        help="slot to flash",
    )

    parser.add_argument(
        "--active",
        choices=("keep", "a", "b"),
        default="keep",
        help="active slot after flashing",
    )

    parser.add_argument(
        "--reboot",
        action="store_true",
        help="reboot Android after flashing",
    )

    args = parser.parse_args()

    try:
        if not args.signing:
            interactive()
            return 0

        stage = package(args.signing)

        if args.package_only:
            return 0

        if not args.slot:
            raise KernelCtlError(
                "--slot a|b|both is required unless --package-only is used"
            )

        flash(stage, args.slot, args.active, args.reboot)
        return 0

    except KeyboardInterrupt:
        print("\nCancelled.")
        return 130

    except KernelCtlError as error:
        print(f"\nERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
