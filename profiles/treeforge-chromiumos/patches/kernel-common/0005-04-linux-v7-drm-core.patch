+/*
+ * KMI-safe storage for Linux-7 GPUVA immediate-mode mutexes.
+ *
+ * The key is the drm_gem_object address. The value is the driver-owned
+ * mutex registered at object construction time.
+ */
+static DEFINE_XARRAY(drm_gem_gpuva_locks);
+
+int drm_gem_gpuva_set_lock(struct drm_gem_object *obj,
+			   struct mutex *lock)
+{
+	int ret;
+
+	if (!lock) {
+		xa_erase(&drm_gem_gpuva_locks, (unsigned long)obj);
+
+#ifdef CONFIG_LOCKDEP
+		obj->gpuva.lock_dep_map = NULL;
+#endif
+		return 0;
+	}
+
+	ret = xa_insert(&drm_gem_gpuva_locks,
+			(unsigned long)obj,
+			lock,
+			GFP_KERNEL);
+	if (ret)
+		return ret;
+
+#ifdef CONFIG_LOCKDEP
+	obj->gpuva.lock_dep_map = &lock->dep_map;
+#endif
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(drm_gem_gpuva_set_lock);
+
+struct mutex *drm_gem_gpuva_get_lock(struct drm_gem_object *obj)
+{
+	struct mutex *lock;
+
+	lock = xa_load(&drm_gem_gpuva_locks,
+		       (unsigned long)obj);
+
+	WARN_ON_ONCE(!lock);
+
+	return lock;
+}
+EXPORT_SYMBOL_GPL(drm_gem_gpuva_get_lock);
