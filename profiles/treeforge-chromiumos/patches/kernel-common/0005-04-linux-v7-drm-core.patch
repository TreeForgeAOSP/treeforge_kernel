+	struct drm_printer *p,
+	const char *prefix,
+	const char *stat,
+	const char *region,
+	u64 sz);
+
+void drm_print_memory_stats(
+	struct drm_printer *p,
+	const struct drm_memory_stats *stats,
+	enum drm_gem_object_status supported_status,
+	const char *region);
