AOSP_BUILD_BOOT_KEY = AOSP_AVB_KEYS / "boot.pem"

AOSP_BUILD_BOOT_KEY_SHA256 = (
    "f1d5765a2bdfb92fb08aee021107c7ac"
    "1a7a3f590dafd853771c85375ef0fbd7"
)

AOSP_BUILD_BOOT_PUBLIC_SHA1 = (
    "cdbb77177f731920bbe0a0f94f84d9038ae0617d"
)

BOOT_PARTITION_SIZE = 67108864
BOOT_ROLLBACK_INDEX = 1746403200
BOOT_ROLLBACK_INDEX_LOCATION = 0
BOOT_OS_VERSION = "15"
BOOT_SECURITY_PATCH = "2025-05-05"


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()

    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)

    return digest.hexdigest()


def build_signing_key(signing: str) -> Path | None:
    if signing == "none":
        return None

    if signing == "aosp":
        materialize_aosp_keyset()
        key = AOSP_BUILD_BOOT_KEY
        need_file(key)

        actual = file_sha256(key)

        if actual != AOSP_BUILD_BOOT_KEY_SHA256:
            raise KernelCtlError(
                "AOSP boot test key identity mismatch:\n"
                f"  expected={AOSP_BUILD_BOOT_KEY_SHA256}\n"
                f"  actual={actual}\n"
                f"  path={key}"
            )

        public = public_key_sha1(key)

        if public != AOSP_BUILD_BOOT_PUBLIC_SHA1:
            raise KernelCtlError(
                "AOSP boot test public-key identity mismatch:\n"
                f"  expected={AOSP_BUILD_BOOT_PUBLIC_SHA1}\n"
                f"  actual={public}"
            )

        return key

    if signing == "treeforge":
        key = TREEFORGE_KEYS / "boot.pem"
        need_file(key)
        return key

    raise KernelCtlError(
        f"unsupported build signing provider: {signing}"
    )


def print_build_signing_plan(signing: str) -> None:
    key = build_signing_key(signing)

    print()
