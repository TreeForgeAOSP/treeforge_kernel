def prepare_flash_host_tools() -> dict:
    resolver = (
        ROOT
        / "tools"
        / "treeforge"
        / "providers"
        / "scripts"
        / "kernel-treeforge-tools"
    )

    need_file(resolver)

    run([resolver, "prepare"])
    run([resolver, "verify"])

    contract = load_treeforge_tools_contract()
    tools = contract.get("tools", {})

    resolved = {}

    for name in ("adb", "fastboot"):
        entry = tools.get(name)

        if not isinstance(entry, dict):
            raise KernelCtlError(
                f"TreeForge host-tool contract missing {name}"
            )

        path_value = entry.get("path")

        if not path_value:
            raise KernelCtlError(
                f"TreeForge host-tool contract missing {name} path"
            )

        path = Path(path_value)
        need_file(path)

        expected_sha256 = entry.get("sha256")

        if expected_sha256:
            actual_sha256 = file_sha256(path)

            if actual_sha256 != expected_sha256:
                raise KernelCtlError(
                    f"{name}: provider SHA256 mismatch:\n"
                    f"  expected={expected_sha256}\n"
                    f"  actual={actual_sha256}\n"
                    f"  path={path}"
                )

        resolved[name] = path

    prepend = []

    for name in ("adb", "fastboot"):
        directory = str(resolved[name].parent)

        if directory not in prepend:
            prepend.append(directory)

    old_path = os.environ.get("PATH", "")

    os.environ["PATH"] = os.pathsep.join(
        prepend + ([old_path] if old_path else [])
    )

    for name in ("adb", "fastboot"):
        selected = shutil.which(name)

        if selected is None:
            raise KernelCtlError(
                f"{name}: unavailable after provider resolution"
            )

        if Path(selected).resolve() != resolved[name].resolve():
            raise KernelCtlError(
                f"{name}: refusing non-TreeForge executable:\n"
                f"  expected={resolved[name]}\n"
                f"  selected={selected}"
            )

    print()
    print("TreeForge flash host tools")
    print("--------------------------")
    print(f"adb:      {resolved['adb']}")
    print(f"fastboot: {resolved['fastboot']}")

    return resolved


def resolve_flash_generation(
    requested: str | None = None,
) -> tuple[Path, Path, dict]:
    source_root = ROOT / "out" / "source"
    need_file(source_root) if source_root.is_file() else None

    if not source_root.is_dir():
        raise KernelCtlError(
            f"source output root missing: {source_root}"
        )

    if requested:
        candidate = Path(requested).expanduser()

        if not candidate.is_absolute():
            candidate = source_root / candidate

        generations = [candidate]
    else:
        generations = [
            path
            for path in source_root.iterdir()
            if (
                path.is_dir()
                and (
                    path
                    / "metadata"
                    / "package.json"
                ).is_file()
            )
        ]

        generations.sort(
            key=lambda path: path.stat().st_mtime,
            reverse=True,
        )

    if not generations:
        raise KernelCtlError(
            "no verified kernel package generation found"
        )

    source_resolved = source_root.resolve()

    last_error = None

    for generation in generations:
        try:
            generation_resolved = generation.resolve()

            if (
                generation_resolved != source_resolved
                and source_resolved
                not in generation_resolved.parents
            ):
                raise KernelCtlError(
                    "flash generation is outside canonical "
                    f"source output root: {generation}"
                )

            package = generation / "package"
            metadata_path = (
                generation
                / "metadata"
                / "package.json"
            )

            if not package.is_dir():
                raise KernelCtlError(
                    f"package directory missing: {package}"
                )

            need_file(metadata_path)

            metadata = json.loads(
                metadata_path.read_text(
                    encoding="utf-8"
                )
            )

            if metadata.get("stage") != "verified-boot-package":
                raise KernelCtlError(
                    "generation is not an accepted "
                    "verified-boot package"
                )

            if metadata.get("schema") != 3:
                raise KernelCtlError(
                    "unsupported package metadata schema: "
                    f"{metadata.get('schema')}"
                )

            if (
                metadata.get("raw_kernel_family_preserved")
                is not True
            ):
                raise KernelCtlError(
                    "package metadata does not confirm "
                    "raw kernel-family preservation"
                )

            provider = metadata.get("signing_provider")

            if provider not in ("aosp", "treeforge"):
                raise KernelCtlError(
                    "unsupported package signing provider: "
                    f"{provider}"
                )

            artifacts = metadata.get("artifacts")

            if not isinstance(artifacts, dict):
                raise KernelCtlError(
                    "package artifact metadata missing"
                )

            print()
            print("Verified package integrity")
            print("--------------------------")

            for name in FINAL_FLASH_PACKAGE_IMAGES:
                image = package / name
                need_file(image)

                if image.is_symlink():
                    raise KernelCtlError(
                        f"refusing symlinked flash image: {image}"
                    )

                entry = artifacts.get(name)

                if not isinstance(entry, dict):
                    raise KernelCtlError(
                        f"metadata missing artifact: {name}"
                    )

                expected_size = entry.get("size")
                expected_sha256 = entry.get("sha256")

                actual_size = image.stat().st_size
                actual_sha256 = file_sha256(image)

                if expected_size != actual_size:
                    raise KernelCtlError(
                        f"{name}: size mismatch:\n"
                        f"  metadata={expected_size}\n"
                        f"  actual={actual_size}"
                    )

                if expected_sha256 != actual_sha256:
                    raise KernelCtlError(
                        f"{name}: SHA256 mismatch:\n"
                        f"  metadata={expected_sha256}\n"
                        f"  actual={actual_sha256}"
                    )

                print(
                    f"PASS  {name:<24} "
                    f"{actual_size:>10} bytes  "
                    f"{actual_sha256}"
                )

            signed_nodes = metadata.get(
                "signing_nodes"
            )

            if not isinstance(signed_nodes, dict):
                raise KernelCtlError(
                    "signed-node metadata missing"
                )

            expected_algorithms = {
                "boot": "SHA256_RSA2048",
                "init_boot": "SHA256_RSA2048",
                "vbmeta_system": "SHA256_RSA2048",
                "vbmeta_vendor": "SHA256_RSA2048",
                "vbmeta": "SHA256_RSA4096",
            }

            for name, expected_algorithm in (
                expected_algorithms.items()
            ):
                entry = signed_nodes.get(name)

                if not isinstance(entry, dict):
                    raise KernelCtlError(
                        f"missing signed node: {name}"
                    )

                actual_algorithm = entry.get(
                    "algorithm"
                )

                if actual_algorithm != expected_algorithm:
                    raise KernelCtlError(
                        f"{name}: signing algorithm mismatch: "
                        f"{actual_algorithm}"
                    )

            if provider == "aosp":
                child_sha1 = (
                    "cdbb77177f731920bbe0a0f94f84d9038ae0617d"
                )

                root_sha1 = (
                    "2597c218aae470a130f61162feaae70afd97f011"
                )

                for name in (
                    "boot",
                    "init_boot",
                    "vbmeta_system",
                    "vbmeta_vendor",
                ):
                    actual = (
                        signed_nodes[name]
                        .get("public_key_sha1")
                    )

                    if actual != child_sha1:
                        raise KernelCtlError(
                            f"{name}: AOSP child-key identity "
                            f"mismatch: {actual}"
                        )

                actual_root = (
                    signed_nodes["vbmeta"]
                    .get("public_key_sha1")
                )

                if actual_root != root_sha1:
                    raise KernelCtlError(
                        "vbmeta: AOSP root-key identity "
                        f"mismatch: {actual_root}"
                    )

            return generation, package, metadata

        except (
            KernelCtlError,
            json.JSONDecodeError,
            OSError,
        ) as error:
            last_error = error

            if requested:
                raise

    raise KernelCtlError(
        "no valid verified-boot package found"
        + (
            f": {last_error}"
            if last_error is not None
            else ""
        )
    )


