    )

    expected_source_boot_sha = (
        "e76754420d5b03918efc77b4d4a16bc"
        "3fed3d0888a9f323e1efb51aef1f4d2e2"
    )

    expected_source_image_sha = (
        "ec847510babbf88f0352c500be06da38"
        "d80ebc5c6c94eaf74df1848850e87688"
    )

    expected_stage0_image_sha = (
        "17819ca7663101bbce54e639acff1d727"
        "6e2034227b6989d8ad77f225790495b"
    )

    need_file(source_boot)

    if source_boot.stat().st_size != 67108864:
        raise KernelCtlError(
            "Stage-0 provider boot partition size mismatch"
        )

    source_boot_sha = file_sha256(
        source_boot
    )

    if source_boot_sha != expected_source_boot_sha:
        raise KernelCtlError(
            "Stage-0 provider boot identity mismatch:\n"
            f"  expected={expected_source_boot_sha}\n"
            f"  actual={source_boot_sha}"
        )

    #
    # Resolve tools exactly through kernelctl's normal TreeForge
    # host-tool provider.
    #
    treeforge_tools = provider_script(
        "kernel-treeforge-tools"
    )

    run([
        treeforge_tools,
        "prepare",
    ])

    run([
        treeforge_tools,
        "verify",
    ])

    contract = load_treeforge_tools_contract()

    unpack_bootimg = Path(
        contract["tools"][
            "unpack_bootimg"
        ]["path"]
    )

    need_file(unpack_bootimg)

    avbtool = avbtool_path()
    lz4 = need_command("lz4")

    #
    # Owner AVB identity stays under the normal kernelctl path.
    #
    keys = provider_keys(
        signing
    )

    expected_public_sha1 = public_key_sha1(
        keys["boot"]
    )

    source_info = avb_info(
        source_boot
    )

    source_algorithm = field(
        source_info,
        "Algorithm",
    )

    if source_algorithm != "SHA256_RSA2048":
        raise KernelCtlError(
            "Stage-0 provider boot AVB algorithm mismatch: "
            f"{source_algorithm}"
        )

    stage = (
        ROOT
        / "out"
        / (
            "stage0-ufs-hci-gate"
            if ufs_gate
            else "stage0-proof"
        )
        / "bootstrap-v1.0b7-r0.94-5"
    )

    if stage.exists():
        shutil.rmtree(stage)

    stage.mkdir(
        parents=True,
        exist_ok=False,
    )

    boot = stage / "boot.img"

    copy_clean(
        source_boot,
        boot,
    )

    print()
    print("TreeForge Stage-0 Provider Proof")
    print("===============================")
    print("Bootstrap:       v1.0b7")
    print("Kernel provider: r0.94-5")
    print(f"Source boot:     {source_boot}")
    print(
        "Source SHA256:   "
        f"{source_boot_sha}"
    )
    print(f"Output:          {boot}")
    print("Signing:         TreeForge Owner AVB")
    print()

    #
    # Remove only the source boot's current AVB footer.
    #
    run([
        avbtool,
        "erase_footer",
        "--image",
        boot,
    ])

    #
    # The accepted r0.94-5 provider carries the standard trailing
    # 16 KiB GKI boot certificate after the Android boot payload.
    #
    # Once the kernel changes that certificate is stale. This follows
    # the same detection model used by Android certify_bootimg:
    # identify the trailing 16 KiB as AVB metadata and remove it before
    # reconstructing the modified kernel payload.
    #
    gki_signature_size = 16 * 1024

    erased_boot = boot.read_bytes()

    if len(erased_boot) <= gki_signature_size:
        raise KernelCtlError(
            "Stage-0 erased provider boot is too small "
            "to contain the expected GKI certificate"
        )

    gki_signature = (
        erased_boot[
            -gki_signature_size:
        ]
    )

    if not gki_signature.startswith(
        b"AVB0"
    ):
        raise KernelCtlError(
            "Stage-0 expected trailing GKI certificate "
            "does not begin with AVB0"
        )

    signature_probe = (
        stage
        / ".gki-boot-signature.bin"
    )

    signature_probe.write_bytes(
        gki_signature
    )

    probe = run(
        [
            avbtool,
            "info_image",
            "--image",
            signature_probe,
        ],
        capture=True,
        check=False,
    )

    if probe.returncode != 0:
        raise KernelCtlError(
            "Stage-0 trailing 16 KiB block is not a "
            "valid GKI AVB certificate"
        )

    second_avb = gki_signature.find(
        b"AVB0",
        4,
    )

    if second_avb < 0:
        raise KernelCtlError(
            "Stage-0 expected concatenated GKI "
            "boot/generic-kernel certificates"
        )

    boot.write_bytes(
        erased_boot[
            :-gki_signature_size
        ]
    )

    print()
    print("GKI boot certificate")
    print("--------------------")
    print(
        "Certificate bytes: "
        f"{gki_signature_size}"
    )
    print(
        "First AVB0:        0x0"
    )
    print(
        "Second AVB0:       "
        f"0x{second_avb:x}"
    )
    print(
        "Action:            removed before "
        "Stage-0 kernel reconstruction"
    )
    print(
        "GKI_BOOT_CERTIFICATE_STRIPPED=PASS"
    )

    #
    # Apply and internally verify the exact R2 Stage-0 transform.
    #
    manifest_path = realize_stage0_proof_boot(
        boot=boot,
        generation=None,
        stage=stage,
        ufs_gate=ufs_gate,
    )

    manifest = json.loads(
        manifest_path.read_text(
            encoding="utf-8"
        )
    )

    if (
        manifest.get("source_image_sha256")
        != expected_source_image_sha
    ):
        raise KernelCtlError(
            "Stage-0 provider decompressed source Image "
            "does not match accepted r0.94-5 Image"
        )

    if ufs_gate:
        if (
            manifest.get(
                "gate1_r2_candidate_image_sha256"
            )
            != expected_stage0_image_sha
        ):
            raise KernelCtlError(
                "Stage-0 UFS gate did not originate "
                "from the hardware-proven Gate-1 R2 Image"
            )
    else:
        if (
            manifest.get("candidate_image_sha256")
            != expected_stage0_image_sha
        ):
            raise KernelCtlError(
                "Stage-0 integrated candidate does not "
                "byte-match standalone R2"
            )

    print(
        "Standalone R2 Image identity: PASS"
    )

    #
    # Re-add the boot footer with the same Owner boot identity and
    # the AVB metadata inherited from the accepted provider image.
    #
    add_hash_footer(
        boot,
        partition_name="boot",
        partition_size=source_boot.stat().st_size,
        key=keys["boot"],
        algorithm=source_algorithm,
        rollback_index=integer_field(
            source_info,
            "Rollback Index",
        ),
        salt=field(
            source_info,
            "Salt",
        ),
        props=properties(
            source_info
        ),
    )

    if boot.stat().st_size != 67108864:
        raise KernelCtlError(
            "Stage-0 final boot partition size mismatch"
        )

    final_info = avb_info(
        boot
    )

    final_public_sha1 = field(
        final_info,
        "Public key (sha1)",
    )

    if final_public_sha1 != expected_public_sha1:
        raise KernelCtlError(
            "Stage-0 final Owner boot public-key "
            "identity mismatch"
        )

    run([
        avbtool,
        "verify_image",
        "--image",
        boot,
    ])

    #
    # Verify the final AVB-bearing image still contains the exact
    # already-audited Stage-0 Image.
    #
    final_verify = (
        stage
        / ".final-verify"
    )

    final_verify.mkdir(
        parents=True,
        exist_ok=False,
    )

    run([
        unpack_bootimg,
        "--boot_img",
        boot,
        "--out",
        final_verify,
    ])

    final_kernel = (
        final_verify
        / "kernel"
    )

    need_file(final_kernel)

    final_image = (
        final_verify
        / "Image"
    )

    run([
        lz4,
        "-d",
        "-f",
        final_kernel,
        final_image,
    ])

    final_image_sha = file_sha256(
        final_image
    )

    expected_final_image_sha = (
        manifest["candidate_image_sha256"]
        if ufs_gate
        else expected_stage0_image_sha
    )

    if final_image_sha != expected_final_image_sha:
        raise KernelCtlError(
            "Stage-0 final packaged Image identity mismatch:\n"
            f"  expected={expected_final_image_sha}\n"
            f"  actual={final_image_sha}"
        )

    final_boot_sha = file_sha256(
        boot
    )

    #
    # Source provider must still be immutable.
    #
    if file_sha256(
        source_boot
    ) != expected_source_boot_sha:
        raise KernelCtlError(
            "Stage-0 source provider boot was modified"
        )

    manifest.update({
        "bootstrap_version":
            "v1.0b7",
        "kernel_provider":
            "r0.94-5",
        "provider_boot_path":
            str(source_boot),
        "provider_boot_sha256":
            expected_source_boot_sha,
        "expected_stage0_image_sha256":
            expected_stage0_image_sha,
        "final_stage0_image_sha256":
            final_image_sha,
        "stage0_hardware_gate":
            (
                "ufs-hci-ready"
                if ufs_gate
                else "entry-handoff"
            ),
        "final_boot_sha256":
            final_boot_sha,
        "final_boot_bytes":
            boot.stat().st_size,
        "owner_boot_public_sha1":
            final_public_sha1,
        "final_avb_verify":
            "PASS",
        "source_provider_immutable":
            "PASS",
        "gki_boot_certificate_source_bytes":
            gki_signature_size,
        "gki_boot_certificate_second_avb_offset":
            f"0x{second_avb:x}",
        "gki_boot_certificate_action":
            "stripped-for-stage0-hardware-proof",
    })

    manifest_path.write_text(
        json.dumps(
            manifest,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    print()
    print("Stage-0 provider proof complete")
    print("-------------------------------")
    print(
        "Provider boot SHA256: "
        f"{expected_source_boot_sha}"
    )
    print(
        "Stage-0 Image SHA256: "
        f"{final_image_sha}"
    )
    print(
        "Final boot SHA256:    "
        f"{final_boot_sha}"
    )
    print(
        "Owner boot pub SHA1:  "
        f"{final_public_sha1}"
    )
    print(
        "Final boot bytes:     "
        f"{boot.stat().st_size}"
    )
    print(f"Manifest:             {manifest_path}")
    print(f"Candidate:            {boot}")
    print()
    print("STANDALONE_R2_IDENTITY=PASS")
    print("OWNER_BOOT_SIGNING=PASS")
    print("FINAL_BOOT_AVB_VERIFY=PASS")
    print("SOURCE_PROVIDER_IMMUTABILITY=PASS")
    print("TREEFORGE_STAGE0_PROVIDER_PROOF=PASS")

    return boot


def package_source_generation(
    *,
    generation: Path,
    raw: Path,
    signing: str,
    stage0_proof: bool = False,
) -> Path:
    if signing == "none":
        raise KernelCtlError(
            "a final verified-boot package requires "
            "aosp or treeforge signing"
        )

    keys = provider_keys(signing)
    avbtool = avbtool_path()

    raw_names = (
        "boot.img",
        "dtbo.img",
        "vendor_kernel_boot.img",
        "system_dlkm.img",
        "vendor_dlkm.img",
    )

    for name in raw_names:
        need_file(raw / name)

    reference_names = (
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "system.img",
        "system_ext.img",
        "product.img",
        "pvmfw.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    )

    for name in reference_names:
        need_file(AOSP_PRODUCT / name)

    stage = generation / (
        "package-stage0-proof"
        if stage0_proof
        else "package"
    )

    stage.mkdir(
        parents=True,
        exist_ok=True,
    )

    raw_before = {
        name: file_sha256(raw / name)
        for name in raw_names
    }

    print()
    print("Full verified-boot package")
    print("--------------------------")
    print(f"Raw:              {raw}")
    print(f"Package:          {stage}")
    print(f"Signing provider: {signing}")

    # ---------------------------------------------------------
    # boot — RSA2048 chain partition
    # ---------------------------------------------------------

    stock_boot = AOSP_PRODUCT / "boot.img"
    stock_boot_info = avb_info(stock_boot)

    boot = stage / "boot.img"
    copy_clean(
        raw / "boot.img",
        boot,
    )

    run([
        avbtool,
        "erase_footer",
        "--image",
        boot,
    ])

    if stage0_proof:
        realize_stage0_proof_boot(
            boot=boot,
            generation=generation,
            stage=stage,
        )

    add_hash_footer(
        boot,
        partition_name="boot",
        partition_size=stock_boot.stat().st_size,
        key=keys["boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_boot_info,
            "Rollback Index",
        ),
        salt=field(
            stock_boot_info,
            "Salt",
        ),
        props=properties(stock_boot_info),
    )

    # ---------------------------------------------------------
    # init_boot — preserved AOSP payload, RSA2048 resign
    # ---------------------------------------------------------

    stock_init_boot = AOSP_PRODUCT / "init_boot.img"
    stock_init_info = avb_info(stock_init_boot)

    init_boot = stage / "init_boot.img"
    copy_clean(
        stock_init_boot,
        init_boot,
    )

    run([
        avbtool,
        "erase_footer",
        "--image",
        init_boot,
    ])

    add_hash_footer(
        init_boot,
        partition_name="init_boot",
        partition_size=stock_init_boot.stat().st_size,
        key=keys["init_boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_init_info,
            "Rollback Index",
        ),
        salt=field(
            stock_init_info,
            "Salt",
        ),
        props=properties(stock_init_info),
    )

    # ---------------------------------------------------------
    # dtbo — unsigned hash footer, authenticated by root vbmeta
    # ---------------------------------------------------------

    stock_dtbo = AOSP_PRODUCT / "dtbo.img"
    stock_dtbo_info = avb_info(stock_dtbo)

    dtbo = stage / "dtbo.img"
    copy_clean(
        raw / "dtbo.img",
        dtbo,
    )

    probe = run(
        [
            avbtool,
            "info_image",
            "--image",
            dtbo,
        ],
        capture=True,
        check=False,
    )

    if probe.returncode == 0:
        run([
            avbtool,
            "erase_footer",
            "--image",
            dtbo,
        ])

    add_hash_footer(
        dtbo,
        partition_name="dtbo",
        partition_size=stock_dtbo.stat().st_size,
        salt=field(
            stock_dtbo_info,
            "Salt",
        ),
        props=properties(stock_dtbo_info),
    )

    # ---------------------------------------------------------
    # vendor_boot — unchanged AOSP payload
    # ---------------------------------------------------------

    vendor_boot = stage / "vendor_boot.img"

    copy_clean(
        AOSP_PRODUCT / "vendor_boot.img",
        vendor_boot,
    )

    # ---------------------------------------------------------
    # vendor_kernel_boot — unsigned hash footer,
    # authenticated by root vbmeta
    # ---------------------------------------------------------

    stock_vkb = (
        AOSP_PRODUCT
        / "vendor_kernel_boot.img"
    )

    stock_vkb_info = avb_info(stock_vkb)

    vendor_kernel_boot = (
        stage
        / "vendor_kernel_boot.img"
    )

    copy_clean(
        raw / "vendor_kernel_boot.img",
        vendor_kernel_boot,
    )

    probe = run(
        [
            avbtool,
            "info_image",
            "--image",
            vendor_kernel_boot,
        ],
        capture=True,
        check=False,
    )

    if probe.returncode == 0:
        run([
            avbtool,
            "erase_footer",
            "--image",
            vendor_kernel_boot,
        ])

    add_hash_footer(
        vendor_kernel_boot,
        partition_name="vendor_kernel_boot",
        partition_size=stock_vkb.stat().st_size,
        salt=field(
            stock_vkb_info,
            "Salt",
        ),
        props=properties(stock_vkb_info),
    )

    # ---------------------------------------------------------
    # DLKM — Kleaf already produced their AVB hashtrees.
    # Their descriptors are authenticated by vbmeta nodes.
    # ---------------------------------------------------------

    vendor_dlkm = stage / "vendor_dlkm.img"
    system_dlkm = stage / "system_dlkm.img"

    copy_clean(
        raw / "vendor_dlkm.img",
        vendor_dlkm,
    )

    copy_clean(
        raw / "system_dlkm.img",
        system_dlkm,
    )

    for name, image in (
        ("vendor_dlkm", vendor_dlkm),
        ("system_dlkm", system_dlkm),
    ):
        info = avb_info(image)

        if "Hashtree descriptor:" not in info:
            raise KernelCtlError(
                f"{name}: expected AVB hashtree missing"
            )

    # ---------------------------------------------------------
    # vbmeta_system — RSA2048
    # ---------------------------------------------------------

    stock_vbmeta_system = (
        AOSP_PRODUCT
        / "vbmeta_system.img"
    )

    stock_vbs_info = avb_info(
        stock_vbmeta_system
    )

    vbmeta_system = (
        stage
        / "vbmeta_system.img"
    )

    command = [
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta_system,
        "--key",
        keys["vbmeta_system"],
        "--algorithm",
        "SHA256_RSA2048",
        "--rollback_index",
        str(
            integer_field(
                stock_vbs_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(
            stock_vbmeta_system.stat().st_size
        ),

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system.img",

        "--include_descriptors_from_image",
        system_dlkm,

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system_ext.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "product.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "pvmfw.img",
    ]

    append_props(
        command,
        properties(
            stock_vbs_info,
            "com.android.build.system_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # vbmeta_vendor — RSA2048, preserve AOSP vendor descriptor
    # ---------------------------------------------------------

    stock_vbmeta_vendor = (
        AOSP_PRODUCT
        / "vbmeta_vendor.img"
    )

    stock_vbv_info = avb_info(
        stock_vbmeta_vendor
    )

    vbmeta_vendor = (
        stage
        / "vbmeta_vendor.img"
    )

    run([
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta_vendor,
        "--key",
        keys["vbmeta_vendor"],
        "--algorithm",
        "SHA256_RSA2048",
        "--rollback_index",
        str(
            integer_field(
                stock_vbv_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(
            stock_vbmeta_vendor.stat().st_size
        ),
        "--include_descriptors_from_image",
        stock_vbmeta_vendor,
    ])

    # ---------------------------------------------------------
    # Root vbmeta — RSA4096
    # ---------------------------------------------------------

    pubdir = stage / ".pubkeys"

    if pubdir.exists():
        shutil.rmtree(pubdir)

    pubdir.mkdir()

    pubs = {}

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
    ):
        pub = pubdir / f"{name}.avbpubkey"

        run([
            avbtool,
            "extract_public_key",
            "--key",
            keys[name],
            "--output",
            pub,
        ])

        pubs[name] = pub

    stock_vbmeta = (
        AOSP_PRODUCT
        / "vbmeta.img"
    )

    stock_vbmeta_info = avb_info(
        stock_vbmeta
    )

    vbmeta = stage / "vbmeta.img"

    command = [
        avbtool,
        "make_vbmeta_image",
        "--output",
        vbmeta,
        "--key",
        keys["vbmeta"],
        "--algorithm",
        "SHA256_RSA4096",
        "--rollback_index",
        str(
            integer_field(
                stock_vbmeta_info,
                "Rollback Index",
            )
        ),
        "--padding_size",
        str(stock_vbmeta.stat().st_size),

        "--chain_partition",
        f"boot:2:{pubs['boot']}",

        "--chain_partition",
        f"init_boot:4:{pubs['init_boot']}",

        "--chain_partition",
        (
            "vbmeta_system:1:"
            f"{pubs['vbmeta_system']}"
        ),

        "--chain_partition",
        (
            "vbmeta_vendor:3:"
            f"{pubs['vbmeta_vendor']}"
        ),

        "--include_descriptors_from_image",
        dtbo,

        "--include_descriptors_from_image",
        vendor_boot,

        "--include_descriptors_from_image",
        vendor_kernel_boot,

        "--include_descriptors_from_image",
        vendor_dlkm,
    ]

    append_props(
        command,
        properties(
            stock_vbmeta_info,
            "com.android.build.vendor_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # Signed-node verification
    # ---------------------------------------------------------

    expected_hashes = {
        "boot": public_key_sha1(
            keys["boot"]
        ),
        "init_boot": public_key_sha1(
            keys["init_boot"]
        ),
        "vbmeta": public_key_sha1(
            keys["vbmeta"]
        ),
        "vbmeta_system": public_key_sha1(
            keys["vbmeta_system"]
        ),
        "vbmeta_vendor": public_key_sha1(
            keys["vbmeta_vendor"]
        ),
    }

    verify_images = {
        "boot": boot,
        "init_boot": init_boot,
        "vbmeta": vbmeta,
        "vbmeta_system": vbmeta_system,
        "vbmeta_vendor": vbmeta_vendor,
    }

    print()
    print("Signing verification")
    print("--------------------")

    signing_results = {}

    for name, image in verify_images.items():
        info = avb_info(image)
        actual = field(
            info,
            "Public key (sha1)",
        )

        expected = expected_hashes[name]

        if actual != expected:
            raise KernelCtlError(
                f"{name}: signing key mismatch: "
                f"expected {expected}, got {actual}"
            )

        algorithm = field(
            info,
            "Algorithm",
        )

        expected_algorithm = (
            "SHA256_RSA4096"
            if name == "vbmeta"
            else "SHA256_RSA2048"
        )

        if algorithm != expected_algorithm:
            raise KernelCtlError(
                f"{name}: algorithm mismatch: "
                f"expected {expected_algorithm}, "
                f"got {algorithm}"
            )

        signing_results[name] = {
            "algorithm": algorithm,
            "public_key_sha1": actual,
        }

        print(
            f"PASS  {name:<15} "
            f"{algorithm:<16} {actual}"
        )

    # Verify boot and init_boot cryptographically.
    for name, image in (
        ("boot", boot),
        ("init_boot", init_boot),
    ):
        run([
            avbtool,
            "verify_image",
            "--image",
            image,
            "--key",
            keys[name],
        ])

    # ---------------------------------------------------------
    # AVB graph sanity
    # ---------------------------------------------------------

    root_info = avb_info(vbmeta)
    system_info = avb_info(vbmeta_system)
    vendor_info = avb_info(vbmeta_vendor)

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
        "dtbo",
        "vendor_boot",
        "vendor_kernel_boot",
        "vendor_dlkm",
    ):
        if name not in root_info:
            raise KernelCtlError(
                f"root vbmeta missing expected target: {name}"
            )

    for name in (
        "system",
        "system_dlkm",
        "system_ext",
        "product",
        "pvmfw",
    ):
        if name not in system_info:
            raise KernelCtlError(
                f"vbmeta_system missing target: {name}"
            )

    if "vendor" not in vendor_info:
        raise KernelCtlError(
            "vbmeta_vendor missing vendor descriptor"
        )

    # ---------------------------------------------------------
    # Final package completeness
    # ---------------------------------------------------------

    expected = (
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    )

    for name in expected:
        need_file(stage / name)

    # ---------------------------------------------------------
    # Raw-build immutability
    # ---------------------------------------------------------

    raw_after = {
        name: file_sha256(raw / name)
        for name in raw_names
    }

    changed = [
        name
        for name in raw_names
        if raw_before[name]
        != raw_after[name]
    ]

    if changed:
        raise KernelCtlError(
            "raw output changed during packaging: "
            + ", ".join(changed)
        )

    # ---------------------------------------------------------
    # Metadata
    # ---------------------------------------------------------

    artifacts = {}

    for name in expected:
        image = stage / name

        artifacts[name] = {
            "path": str(image),
            "size": image.stat().st_size,
            "sha256": file_sha256(image),
        }

    metadata = {
        "schema": 3,
        "stage": "verified-boot-package",
        "device": DEVICE,
        "kernel_release": KERNEL_PROVIDER_RELEASE,
        "signing_provider": signing,
        "signing_nodes": signing_results,
        "artifacts": artifacts,
        "raw_kernel_family_preserved": True,
        "reference_product": str(AOSP_PRODUCT),
        "reference_release": "android-15-r36",
    }

    metadata_dir = generation / "metadata"
    metadata_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    metadata_path = (
        metadata_dir
        / "package.json"
    )

    metadata_path.write_text(
        json.dumps(
            metadata,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )

    print()
    print("Final verified-boot package")
    print("---------------------------")

    for name in expected:
        image = stage / name

        print(
            f"{name:<24} "
            f"{image.stat().st_size:>10} bytes  "
            f"{file_sha256(image)}"
        )

    print()
    print(
        "Signed nodes: "
        "boot init_boot vbmeta "
        "vbmeta_system vbmeta_vendor"
    )
    print(
        "Descriptor-authenticated nodes: "
        "dtbo vendor_boot vendor_kernel_boot "
        "vendor_dlkm system_dlkm"
    )
    print(f"Metadata: {metadata_path}")
    print("RAW KERNEL FAMILY MODIFIED: NO")

    return boot


def execute_kernel_build(
    signing: str,
    profile: str,
) -> int:
    profile_data = prepare_build_profile_source(
        profile
    )

    print("TreeForge Kernel Build")
    print("======================")
    print()
    print(f"Workspace:        {ROOT}")
    print(f"Provider release: {KERNEL_PROVIDER_RELEASE}")

    env, environment_plan = prepare_kernel_build_providers()
    contract = load_treeforge_tools_contract()

    generation, raw = new_build_generation()

    command = kernel_bazel_command(raw)

    metadata = write_build_metadata(
        generation=generation,
        raw=raw,
        command=command,
        environment=env,
        contract=contract,
    )

    annotate_build_metadata_profile(
        metadata,
        profile,
    )

    print()
    print("Build generation")
    print("----------------")
    print(f"Generation: {generation}")
    print(f"Raw dist:   {raw}")
