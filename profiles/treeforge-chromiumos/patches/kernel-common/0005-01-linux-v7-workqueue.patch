+/*
+ * Linux-7 work-disable semantics on Android 6.1.
+ *
+ * Preserve Google's work->data encoding. Disable depth is kept in
+ * an Android KABI reserve instead of transplanting Linux 7's newer
+ * off-queue encoding into Google's older workqueue engine.
+ *
+ * Existing vendor modules were compiled while this field was a KABI
+ * reserve and therefore do not initialize it through INIT_WORK().
+ * A tagged state provides safe lazy initialization on first access.
+ */
+#define WORK_DISABLE_DEPTH_BITS		16
+#define WORK_DISABLE_DEPTH_MASK		0x000000000000ffffULL
+#define WORK_DISABLE_STATE_TAG_MASK	0xffffffffffff0000ULL
+#define WORK_DISABLE_STATE_MAGIC	0x5446575100000000ULL
+
+static int get_work_pool_id(struct work_struct *work);
+
+static u64 work_disable_state(struct work_struct *work)
+{
+	u64 state;
+
+	for (;;) {
+		state = (u64)atomic64_read(&work->disable_state);
+
+		if (likely((state & WORK_DISABLE_STATE_TAG_MASK) ==
+			   WORK_DISABLE_STATE_MAGIC))
+			return state;
+
+		if ((u64)atomic64_cmpxchg(&work->disable_state,
+					 (s64)state,
+					 (s64)WORK_DISABLE_STATE_MAGIC) ==
+		    state)
+			return WORK_DISABLE_STATE_MAGIC;
+	}
+}
+
+static unsigned int work_disable_depth(struct work_struct *work)
+{
+	return (unsigned int)(
+		work_disable_state(work) &
+		WORK_DISABLE_DEPTH_MASK);
+}
+
+static void work_set_disable_depth(struct work_struct *work,
+				   unsigned int depth)
+{
+	u64 old;
+	u64 new;
+
+	do {
+		old = work_disable_state(work);
+		new = WORK_DISABLE_STATE_MAGIC |
+		      ((u64)depth & WORK_DISABLE_DEPTH_MASK);
+	} while ((u64)atomic64_cmpxchg(&work->disable_state,
+					(s64)old,
+					(s64)new) != old);
+}
+
+static bool clear_pending_if_disabled(struct work_struct *work)
+{
+	unsigned long data = *work_data_bits(work);
+
+	if (likely((data & WORK_STRUCT_PWQ) ||
+		   !work_disable_depth(work)))
+		return false;
+
+	set_work_pool_and_clear_pending(
+		work,
+		get_work_pool_id(work));
+
+	return true;
+}
+
