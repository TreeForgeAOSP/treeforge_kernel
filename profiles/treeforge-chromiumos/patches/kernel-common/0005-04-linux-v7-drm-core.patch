+/*
+ * Linux-7 scheduler state which has no KMI-safe storage inside the
+ * frozen Google 6.1 drm_sched_job / drm_gpu_scheduler layouts.
+ *
+ * Legacy jobs have no side-state entry and therefore consume exactly
+ * one credit, which preserves Google 6.1's original job-count model.
+ */
+struct drm_sched_v7_job_state {
+	u32 credits;
+	u64 drm_client_id;
+};
+
+struct drm_sched_v7_sched_state {
+	struct drm_gpu_scheduler *sched;
+	struct workqueue_struct *submit_wq;
+	struct work_struct work_run_job;
+	struct work_struct work_free_job;
+	u32 num_rqs;
+	bool own_submit_wq;
+	bool pause_submit;
+};
+
+static DEFINE_XARRAY(drm_sched_v7_jobs);
+static DEFINE_XARRAY(drm_sched_v7_schedulers);
+
+static void drm_sched_v7_run_job_work(struct work_struct *work);
+static void drm_sched_v7_free_job_work(struct work_struct *work);
+
+
+static int
+drm_sched_v7_job_state_add(struct drm_sched_job *job,
+			   u32 credits,
+			   u64 drm_client_id)
+{
+	struct drm_sched_v7_job_state *state;
+	int ret;
+
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+
+	state->credits = credits;
+	state->drm_client_id = drm_client_id;
+
+	ret = xa_insert(
+		&drm_sched_v7_jobs,
+		(unsigned long)job,
+		state,
+		GFP_KERNEL
+	);
+
+	if (ret)
+		kfree(state);
+
+	return ret;
+}
+
+static void
+drm_sched_v7_job_state_drop(struct drm_sched_job *job)
+{
+	struct drm_sched_v7_job_state *state;
+
+	state = xa_erase(
+		&drm_sched_v7_jobs,
+		(unsigned long)job
+	);
+
+	if (!state)
+		return;
+
+	synchronize_rcu();
+	kfree(state);
+}
+
+static u32
+drm_sched_v7_job_credits(struct drm_sched_job *job)
+{
+	struct drm_sched_v7_job_state *state;
+	u32 credits = 1;
+
+	rcu_read_lock();
+
+	state = xa_load(
+		&drm_sched_v7_jobs,
+		(unsigned long)job
+	);
+
+	if (state)
+		credits = READ_ONCE(state->credits);
+
+	rcu_read_unlock();
+
+	return credits;
+}
+
+static void
+drm_sched_v7_job_set_credits(struct drm_sched_job *job,
+			     u32 credits)
+{
+	struct drm_sched_v7_job_state *state;
+
+	rcu_read_lock();
+
+	state = xa_load(
+		&drm_sched_v7_jobs,
+		(unsigned long)job
+	);
+
+	if (state)
+		WRITE_ONCE(state->credits, credits);
+
+	rcu_read_unlock();
+}
+
+static int
+drm_sched_v7_sched_state_add(
+	struct drm_gpu_scheduler *sched,
+	const struct drm_sched_init_args *args)
+{
+
+	struct drm_sched_v7_sched_state *state;
+	int ret;
+
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+
+	state->sched = sched;
+	state->num_rqs = args->num_rqs;
+	state->pause_submit = true;
+
+	if (args->submit_wq) {
+		state->submit_wq = args->submit_wq;
+	} else {
+		state->submit_wq =
+			alloc_ordered_workqueue("%s", WQ_MEM_RECLAIM,
+						args->name ?
+						args->name :
+						"drm_sched_v7");
+		if (!state->submit_wq) {
+			kfree(state);
+			return -ENOMEM;
+		}
+
+		state->own_submit_wq = true;
+	}
+
+	INIT_WORK(&state->work_run_job,
+		  drm_sched_v7_run_job_work);
+	INIT_WORK(&state->work_free_job,
+		  drm_sched_v7_free_job_work);
+
+	ret = xa_insert(&drm_sched_v7_schedulers,
+			(unsigned long)sched,
+			state,
+			GFP_KERNEL);
+	if (ret) {
+		if (state->own_submit_wq)
+			destroy_workqueue(state->submit_wq);
+
+		kfree(state);
+	}
+
+	return ret;
+}
+
+static void
+drm_sched_v7_sched_state_drop(
+	struct drm_gpu_scheduler *sched)
+{
+
+	struct drm_sched_v7_sched_state *state;
+
+	rcu_read_lock();
+
+	state = xa_load(&drm_sched_v7_schedulers,
+			(unsigned long)sched);
+	if (state)
+		WRITE_ONCE(state->pause_submit, true);
+
+	rcu_read_unlock();
+
+	if (!state)
+		return;
+
+	cancel_work_sync(&state->work_run_job);
+	cancel_work_sync(&state->work_free_job);
+
+	state = xa_erase(&drm_sched_v7_schedulers,
+			 (unsigned long)sched);
+	if (!state)
+		return;
+
+	synchronize_rcu();
+
+	if (state->own_submit_wq)
+		destroy_workqueue(state->submit_wq);
+
+	kfree(state);
+}
+
+
+static bool
+drm_sched_v7_run_job_queue(struct drm_gpu_scheduler *sched)
+{
+	struct drm_sched_v7_sched_state *state;
+	bool found = false;
+
+	rcu_read_lock();
+
+	state = xa_load(&drm_sched_v7_schedulers,
+			(unsigned long)sched);
+	if (state) {
+		found = true;
+
+		if (!READ_ONCE(state->pause_submit))
+			queue_work(state->submit_wq,
+				   &state->work_run_job);
+	}
+
+	rcu_read_unlock();
+
+	return found;
+}
+
+static bool
+drm_sched_v7_run_free_queue(struct drm_gpu_scheduler *sched)
+{
+	struct drm_sched_v7_sched_state *state;
+	bool found = false;
+
+	rcu_read_lock();
+
+	state = xa_load(&drm_sched_v7_schedulers,
+			(unsigned long)sched);
+	if (state) {
+		found = true;
+
+		if (!READ_ONCE(state->pause_submit))
+			queue_work(state->submit_wq,
+				   &state->work_free_job);
+	}
+
+	rcu_read_unlock();
+
+	return found;
+}
+
+static bool
+drm_sched_v7_wqueue_stop(struct drm_gpu_scheduler *sched)
+{
+	struct drm_sched_v7_sched_state *state;
+
+	rcu_read_lock();
+
+	state = xa_load(&drm_sched_v7_schedulers,
+			(unsigned long)sched);
+	if (state)
+		WRITE_ONCE(state->pause_submit, true);
+
+	rcu_read_unlock();
+
+	if (!state)
+		return false;
+
+	cancel_work_sync(&state->work_run_job);
+	cancel_work_sync(&state->work_free_job);
+
+	return true;
+}
+
+static bool
+drm_sched_v7_wqueue_start(struct drm_gpu_scheduler *sched)
+{
+	struct drm_sched_v7_sched_state *state;
+	bool found = false;
+
+	rcu_read_lock();
+
+	state = xa_load(&drm_sched_v7_schedulers,
+			(unsigned long)sched);
+	if (state) {
+		found = true;
+
+		WRITE_ONCE(state->pause_submit, false);
+
+		queue_work(state->submit_wq,
+			   &state->work_run_job);
+		queue_work(state->submit_wq,
+			   &state->work_free_job);
+	}
+
+	rcu_read_unlock();
+
+	return found;
+}
+
+static u32
+drm_sched_job_credits_compat(
+	struct drm_gpu_scheduler *sched,
+	struct drm_sched_job *job)
+{
+	u32 credits;
+	u32 limit;
+
+	credits = drm_sched_v7_job_credits(job);
+	limit = READ_ONCE(sched->hw_submission_limit);
+
+	if (WARN_ON_ONCE(!limit))
+		return credits;
+
+	/*
+	 * Linux 7 truncates an oversized job to the scheduler's total
+	 * credit limit so it can still make forward progress.
+	 */
+	if (credits > limit) {
+		dev_warn(
+			sched->dev,
+			"DRM scheduler job credits %u exceed limit %u; truncating\n",
+			credits,
+			limit
+		);
+
+		credits = limit;
+
+		drm_sched_v7_job_set_credits(
+			job,
+			credits
+		);
+	}
+
+	return credits;
+}
+
+static bool
+drm_sched_entity_credits_fit(
+	struct drm_sched_rq *rq,
+	struct drm_sched_entity *entity)
+{
+	struct spsc_node *node;
+	struct drm_sched_job *job;
+	struct drm_gpu_scheduler *sched = rq->sched;
+	u32 credits;
+	u32 used;
+	u32 limit;
+
+	node = spsc_queue_peek(
+		&entity->job_queue
+	);
+
+	if (!node)
+		return false;
+
+	job = to_drm_sched_job(node);
+
+	credits = drm_sched_job_credits_compat(
+		sched,
+		job
+	);
+
+	used = atomic_read(
+		&sched->hw_rq_count
+	);
+
+	limit = READ_ONCE(
+		sched->hw_submission_limit
+	);
+
+	if (WARN_ON_ONCE(used > limit))
+		return false;
+
+	return credits <= limit - used;
+}
