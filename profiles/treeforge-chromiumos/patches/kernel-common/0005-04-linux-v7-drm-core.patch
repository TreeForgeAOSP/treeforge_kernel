+/**
+ * drm_gem_huge_mnt_create - create and use a huge tmpfs mount
+ * @dev: DRM device
+ * @value: tmpfs huge= option
+ *
+ * KMI-preserving Linux-7 API backport. Upstream stores the mount
+ * directly in struct drm_device. Google's frozen Android drm_device
+ * has no KABI reserve, so DRM core keeps equivalent per-device state
+ * in an XArray without changing struct drm_device.
+ */
+int drm_gem_huge_mnt_create(struct drm_device *dev,
+			    const char *value)
+{
+	struct file_system_type *type;
+	struct fs_context *fc;
+	struct vfsmount *mnt;
+	int ret;
+
+	if (unlikely(drm_gem_get_huge_mnt(dev)))
+		return 0;
+
+	type = get_fs_type("tmpfs");
+	if (unlikely(!type))
+		return -EOPNOTSUPP;
+
+	fc = fs_context_for_mount(
+		type,
+		SB_KERNMOUNT);
+	if (IS_ERR(fc))
+		return PTR_ERR(fc);
+
+	ret = vfs_parse_fs_string(
+		fc,
+		"source",
+		"tmpfs",
+		sizeof("tmpfs") - 1);
+	if (unlikely(ret))
+		goto err_fc;
+
+	ret = vfs_parse_fs_string(
+		fc,
+		"huge",
+		value,
+		strlen(value));
+	if (unlikely(ret))
+		goto err_fc;
+
+	mnt = fc_mount_longterm(fc);
+	put_fs_context(fc);
+
+	if (IS_ERR(mnt))
+		return PTR_ERR(mnt);
+
+	ret = xa_insert(
+		&drm_gem_huge_mnts,
+		(unsigned long)dev,
+		mnt,
+		GFP_KERNEL);
+
+	if (ret == -EBUSY) {
+		kern_unmount(mnt);
+		return 0;
+	}
+
+	if (ret) {
+		kern_unmount(mnt);
+		return ret;
+	}
+
+	return drmm_add_action_or_reset(
+		dev,
+		drm_gem_huge_mnt_free,
+		NULL);
+
+err_fc:
+	put_fs_context(fc);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(drm_gem_huge_mnt_create);
+#endif
