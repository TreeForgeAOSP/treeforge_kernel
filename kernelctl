def copy_clean(source: Path, target: Path):
    if target.exists():
        target.unlink()

    shutil.copy2(source, target)


def add_hash_footer(
    image: Path,
    *,
    partition_name: str,
    partition_size: int,
    key: Path | None = None,
    algorithm: str | None = None,
    rollback_index: int | None = None,
    salt: str | None = None,
    props=(),
):
    command = [
        avbtool_path(),
        "add_hash_footer",
        "--image",
        image,
        "--partition_name",
        partition_name,
        "--partition_size",
        str(partition_size),
    ]

    if key is not None:
        command.extend([
            "--key",
            key,
        ])

    if algorithm is not None:
        command.extend([
            "--algorithm",
            algorithm,
        ])

    if rollback_index is not None:
        command.extend([
            "--rollback_index",
            str(rollback_index),
        ])

    if salt is not None:
        if not re.fullmatch(
            r"[0-9a-fA-F]+",
            salt,
        ):
            raise KernelCtlError(
                f"{partition_name}: invalid AVB salt"
            )

        command.extend([
            "--salt",
            salt,
        ])

    append_props(
        command,
        props,
    )

    run(command)




def package(provider: str):
    preflight()
    keys = provider_keys(provider)

    stage = ROOT / f"out/tangorpro/deploy/{provider}"
    stage.mkdir(parents=True, exist_ok=True)

    print()
    print(f"Signing provider: {provider}")
    print(f"Output:           {stage}")
    print()

    # ---------------------------------------------------------
    # boot
    # ---------------------------------------------------------
    stock_boot = AOSP_PRODUCT / "boot.img"
    stock_boot_info = avb_info(stock_boot)

    boot = stage / "boot.img"
    copy_clean(DIST / "boot.img", boot)

    # Standalone kernel build already adds an unsigned footer.
    run([
        avbtool_path(),
        "erase_footer",
        "--image", boot,
    ])

    add_hash_footer(
        boot,
        partition_name="boot",
        partition_size=stock_boot.stat().st_size,
        key=keys["boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_boot_info,
            "Rollback Index",
        ),
        props=properties(stock_boot_info),
    )

    # ---------------------------------------------------------
    # init_boot: preserve AOSP payload, change selected signer.
    # ---------------------------------------------------------
    stock_init_boot = AOSP_PRODUCT / "init_boot.img"
    stock_init_info = avb_info(stock_init_boot)

    init_boot = stage / "init_boot.img"
    copy_clean(stock_init_boot, init_boot)

    run([
        avbtool_path(),
        "erase_footer",
        "--image", init_boot,
    ])

    add_hash_footer(
        init_boot,
        partition_name="init_boot",
        partition_size=stock_init_boot.stat().st_size,
        key=keys["init_boot"],
        algorithm="SHA256_RSA2048",
        rollback_index=integer_field(
            stock_init_info,
            "Rollback Index",
        ),
        props=properties(stock_init_info),
    )

    # ---------------------------------------------------------
    # dtbo
    # ---------------------------------------------------------
    stock_dtbo = AOSP_PRODUCT / "dtbo.img"
    stock_dtbo_info = avb_info(stock_dtbo)

    dtbo = stage / "dtbo.img"
    copy_clean(DIST / "dtbo.img", dtbo)

    add_hash_footer(
        dtbo,
        partition_name="dtbo",
        partition_size=stock_dtbo.stat().st_size,
        props=properties(stock_dtbo_info),
    )

    # ---------------------------------------------------------
    # vendor_boot is unchanged AOSP payload, but carry it in the
    # deployment set because root vbmeta authenticates it.
    # ---------------------------------------------------------
    vendor_boot = stage / "vendor_boot.img"
    copy_clean(AOSP_PRODUCT / "vendor_boot.img", vendor_boot)

    # ---------------------------------------------------------
    # vendor_kernel_boot
    # ---------------------------------------------------------
    stock_vkb = AOSP_PRODUCT / "vendor_kernel_boot.img"
    stock_vkb_info = avb_info(stock_vkb)

    vendor_kernel_boot = stage / "vendor_kernel_boot.img"
    copy_clean(
        DIST / "vendor_kernel_boot.img",
        vendor_kernel_boot,
    )

    add_hash_footer(
        vendor_kernel_boot,
        partition_name="vendor_kernel_boot",
        partition_size=stock_vkb.stat().st_size,
        props=properties(stock_vkb_info),
    )

    # ---------------------------------------------------------
    # DLKM images are already produced with valid hashtrees.
    # ---------------------------------------------------------
    vendor_dlkm = stage / "vendor_dlkm.img"
    system_dlkm = stage / "system_dlkm.img"

    copy_clean(DIST / "vendor_dlkm.img", vendor_dlkm)
    copy_clean(DIST / "system_dlkm.img", system_dlkm)

    # ---------------------------------------------------------
    # vbmeta_system
    # ---------------------------------------------------------
    stock_vbmeta_system = AOSP_PRODUCT / "vbmeta_system.img"
    stock_vbs_info = avb_info(stock_vbmeta_system)

    vbmeta_system = stage / "vbmeta_system.img"

    command = [
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta_system,
        "--key", keys["vbmeta_system"],
        "--algorithm", "SHA256_RSA2048",
        "--rollback_index",
        str(integer_field(stock_vbs_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta_system.stat().st_size),

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system.img",

        "--include_descriptors_from_image",
        system_dlkm,

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "system_ext.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "product.img",

        "--include_descriptors_from_image",
        AOSP_PRODUCT / "pvmfw.img",
    ]

    append_props(
        command,
        properties(
            stock_vbs_info,
            "com.android.build.system_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # vbmeta_vendor: preserve all AOSP descriptors but sign the
    # node with the chosen provider's vbmeta_vendor key.
    # ---------------------------------------------------------
    stock_vbmeta_vendor = AOSP_PRODUCT / "vbmeta_vendor.img"
    stock_vbv_info = avb_info(stock_vbmeta_vendor)

    vbmeta_vendor = stage / "vbmeta_vendor.img"

    run([
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta_vendor,
        "--key", keys["vbmeta_vendor"],
        "--algorithm", "SHA256_RSA2048",
        "--rollback_index",
        str(integer_field(stock_vbv_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta_vendor.stat().st_size),
        "--include_descriptors_from_image",
        stock_vbmeta_vendor,
    ])

    # ---------------------------------------------------------
    # root vbmeta
    # ---------------------------------------------------------
    pubdir = stage / ".pubkeys"
    pubdir.mkdir(exist_ok=True)

    pubs = {}

    for name in (
        "boot",
        "init_boot",
        "vbmeta_system",
        "vbmeta_vendor",
    ):
        pub = pubdir / f"{name}.avbpubkey"

        run([
            avbtool_path(),
            "extract_public_key",
            "--key", keys[name],
            "--output", pub,
        ])

        pubs[name] = pub

    stock_vbmeta = AOSP_PRODUCT / "vbmeta.img"
    stock_vbmeta_info = avb_info(stock_vbmeta)

    vbmeta = stage / "vbmeta.img"

    command = [
        avbtool_path(),
        "make_vbmeta_image",
        "--output", vbmeta,
        "--key", keys["vbmeta"],
        "--algorithm", "SHA256_RSA4096",
        "--rollback_index",
        str(integer_field(stock_vbmeta_info, "Rollback Index")),
        "--padding_size",
        str(stock_vbmeta.stat().st_size),

        "--chain_partition",
        f"boot:2:{pubs['boot']}",

        "--chain_partition",
        f"init_boot:4:{pubs['init_boot']}",

        "--chain_partition",
        f"vbmeta_system:1:{pubs['vbmeta_system']}",

        "--chain_partition",
        f"vbmeta_vendor:3:{pubs['vbmeta_vendor']}",

        "--include_descriptors_from_image",
        dtbo,

        "--include_descriptors_from_image",
        vendor_boot,

        "--include_descriptors_from_image",
        vendor_kernel_boot,

        "--include_descriptors_from_image",
        vendor_dlkm,
    ]

    append_props(
        command,
        properties(
            stock_vbmeta_info,
            "com.android.build.vendor_dlkm.",
        ),
    )

    run(command)

    # ---------------------------------------------------------
    # Verification
    # ---------------------------------------------------------
    expected_hashes = {
        "boot": public_key_sha1(keys["boot"]),
        "init_boot": public_key_sha1(keys["init_boot"]),
        "vbmeta": public_key_sha1(keys["vbmeta"]),
        "vbmeta_system": public_key_sha1(keys["vbmeta_system"]),
        "vbmeta_vendor": public_key_sha1(keys["vbmeta_vendor"]),
    }

    verify_images = {
        "boot": boot,
        "init_boot": init_boot,
        "vbmeta": vbmeta,
        "vbmeta_system": vbmeta_system,
        "vbmeta_vendor": vbmeta_vendor,
    }

    print()
    print("Signing verification")
    print("--------------------")

    for name, image in verify_images.items():
        info = avb_info(image)
        actual = field(info, "Public key (sha1)")
        expected = expected_hashes[name]

        if actual != expected:
            raise KernelCtlError(
                f"{name}: signing key mismatch: "
                f"expected {expected}, got {actual}"
            )

        print(f"PASS  {name:<15} {actual}")

    expected = [
        "boot.img",
        "init_boot.img",
        "dtbo.img",
        "vendor_boot.img",
        "vendor_kernel_boot.img",
        "vendor_dlkm.img",
        "system_dlkm.img",
        "vbmeta.img",
        "vbmeta_system.img",
        "vbmeta_vendor.img",
    ]

    for name in expected:
        need_file(stage / name)

    print()
    print("Package complete:")
    print(stage)

    return stage


