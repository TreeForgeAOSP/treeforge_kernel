_OWNER_KEYSET_STACK = None
_OWNER_KEYSET_DIR = None


def _pixel_partitioner_owner_keys():
    """
    Resolve Pixel Partitioner as the current owner-key authority.

    Device Manager will replace this adapter later.  No private key is
    persisted by kernelctl.
    """
    import importlib
    import os
    import sys
    from pathlib import Path

    override = os.environ.get(
        "TREEFORGE_PIXEL_PARTITIONER_SOURCE"
    )

    candidates = []

    if override:
        candidate = Path(override).expanduser().resolve()

        if (
            candidate.name != "src"
            and (
                candidate
                / "src"
                / "pixel_partitioner"
                / "owner_keys.py"
            ).is_file()
        ):
            candidate = candidate / "src"

        candidates.append(candidate)

    candidates.extend(
        (
            Path(__file__).resolve().parent.parent
            / "pixel_partitioner"
            / "src",

            Path.home()
            / "development"
            / "pixel_partitioner"
            / "src",
        )
    )

    source = None

    for candidate in candidates:
        candidate = candidate.expanduser().resolve()

        if (
            candidate
            / "pixel_partitioner"
            / "owner_keys.py"
        ).is_file():
            source = candidate
            break

    if source is None:
        raise KernelCtlError(
            "Pixel Partitioner owner-key provider was not found. "
            "Set TREEFORGE_PIXEL_PARTITIONER_SOURCE to its "
            "repository or src directory."
        )

    source_text = str(source)

    if source_text not in sys.path:
        sys.path.insert(0, source_text)

    return importlib.import_module(
        "pixel_partitioner.owner_keys"
    )


def _close_owner_keyset():
    global _OWNER_KEYSET_STACK
    global _OWNER_KEYSET_DIR

    if _OWNER_KEYSET_STACK is not None:
        _OWNER_KEYSET_STACK.close()

    _OWNER_KEYSET_STACK = None
    _OWNER_KEYSET_DIR = None


def _treeforge_owner_keyset_dir() -> Path:
    """
    Materialize the Pixel Partitioner owner pair into a process-local
    temporary keyset.

      vbmeta.pem         <- RSA-4096 owner root
      everything else   <- RSA-2048 owner companion

    The temporary plaintext keys disappear when kernelctl exits.
    """
    global _OWNER_KEYSET_STACK
    global _OWNER_KEYSET_DIR

    if (
        _OWNER_KEYSET_DIR is not None
        and _OWNER_KEYSET_DIR.is_dir()
    ):
        return _OWNER_KEYSET_DIR

    import atexit
    from contextlib import ExitStack
    import getpass
    import shutil
    import tempfile

    owner_keys = _pixel_partitioner_owner_keys()

    root = owner_keys.default_root().expanduser().resolve()
    child = owner_keys.companion_root(root).expanduser().resolve()

    try:
        root_record = owner_keys.inspect(root)
        child_record = owner_keys.inspect(child)
    except Exception as error:
        raise KernelCtlError(
            f"TreeForge owner identity is unavailable: {error}"
        ) from error

    if root_record.get("algorithm") != "SHA256_RSA4096":
        raise KernelCtlError(
            "TreeForge owner root must be SHA256_RSA4096"
        )

    if child_record.get("algorithm") != "SHA256_RSA2048":
        raise KernelCtlError(
            "TreeForge owner companion must be SHA256_RSA2048"
        )

    stack = ExitStack()

    try:
        password = getpass.getpass(
            "Owner AVB signing passphrase: "
        )

        root_private, _ = stack.enter_context(
            owner_keys.unlocked(
                root,
                password,
            )
        )

        try:
            child_private, _ = stack.enter_context(
                owner_keys.unlocked(
                    child,
                    password,
                )
            )
        except owner_keys.OwnerKeyError:
            child_password = getpass.getpass(
                "Owner AVB child signing passphrase: "
            )

            child_private, _ = stack.enter_context(
                owner_keys.unlocked(
                    child,
                    child_password,
                )
            )

        directory = Path(
            stack.enter_context(
                tempfile.TemporaryDirectory(
                    prefix="treeforge-kernel-owner-avb-"
                )
            )
        )

        root_target = directory / "vbmeta.pem"

        shutil.copyfile(
            root_private,
            root_target,
        )
        root_target.chmod(0o600)

        child_names = (
            "boot.pem",
            "init_boot.pem",
            "vbmeta_system.pem",
            "vbmeta_vendor.pem",
        )

        for name in child_names:
            target = directory / name

            shutil.copyfile(
                child_private,
                target,
            )
            target.chmod(0o600)

        # Compatibility aliases for any existing packaging path which
        # refers to algorithm-oriented names.
        rsa2048 = directory / "testkey_rsa2048.pem"
        rsa4096 = directory / "testkey_rsa4096.pem"

        shutil.copyfile(child_private, rsa2048)
        shutil.copyfile(root_private, rsa4096)

        rsa2048.chmod(0o600)
        rsa4096.chmod(0o600)

        if (
            public_key_sha1(directory / "boot.pem")
            != child_record["public_key_sha1"]
        ):
            raise KernelCtlError(
                "materialized owner child public-key identity mismatch"
            )

        if (
            public_key_sha1(directory / "vbmeta.pem")
            != root_record["public_key_sha1"]
        ):
            raise KernelCtlError(
                "materialized owner root public-key identity mismatch"
            )

    except Exception:
        stack.close()
        raise

    _OWNER_KEYSET_STACK = stack
    _OWNER_KEYSET_DIR = directory

    atexit.register(_close_owner_keyset)

    print()
    print("TreeForge owner AVB")
    print("-------------------")
    print(f"Root key ID:       {root_record['key_id']}")
    print(f"Child key ID:      {child_record['key_id']}")
    print(
        "Child public SHA1: "
        + child_record["public_key_sha1"]
    )
    print("Persistent plaintext key: NO")
    print()

    return directory



def provider_keys(provider: str):
    if provider == "aosp":
        materialize_aosp_keyset()
        keys = {
            "boot": AOSP_AVB_KEYS / "boot.pem",
            "init_boot": AOSP_AVB_KEYS / "init_boot.pem",
            "vbmeta_system": AOSP_AVB_KEYS / "vbmeta_system.pem",
            "vbmeta_vendor": AOSP_AVB_KEYS / "vbmeta_vendor.pem",
            "vbmeta": AOSP_AVB_KEYS / "vbmeta.pem",
        }

    elif provider == "treeforge":
        owner_keys = _treeforge_owner_keyset_dir()

        keys = {
            "boot": owner_keys / "boot.pem",
            "init_boot": owner_keys / "init_boot.pem",
            "vbmeta": owner_keys / "vbmeta.pem",
            "vbmeta_system": owner_keys / "vbmeta_system.pem",
            "vbmeta_vendor": owner_keys / "vbmeta_vendor.pem",
        }

    else:
        raise KernelCtlError(f"unknown signing provider: {provider}")

    for path in keys.values():
        need_file(path)

    return keys


