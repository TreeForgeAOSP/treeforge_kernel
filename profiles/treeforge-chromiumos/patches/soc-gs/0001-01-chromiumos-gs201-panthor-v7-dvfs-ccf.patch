+/*
+ * TreeForge ChromiumOS:
+ * expose the existing ACPM GPU DVFS domains through CCF so
+ * generic Panthor can use clk_get_rate()/clk_set_rate().
+ */
+static struct init_vclk gs201_g3d_dvfs_vclks[] = {
+	VCLK(CLK_G3D_DVFS,
+	     ACPM_DVFS_G3D,
+	     "CLK_G3D_DVFS",
+	     0,
+	     VCLK_DFS,
+	     NULL),
+	VCLK(CLK_G3DL2_DVFS,
+	     ACPM_DVFS_G3DL2,
+	     "CLK_G3DL2_DVFS",
+	     0,
+	     VCLK_DFS,
+	     NULL),
+};
+
+
 static struct init_vclk gs201_dpu_hwacg_vclks[] = {
 	HWACG_VCLK(UMUX_CLKCMU_DPU_NOC,
 		MUX_CLKCMU_DPU_NOC_USER,
@@ -1722,6 +1743,10 @@ static int gs201_clock_probe(struct platform_device *pdev)
 	samsung_register_vclk(gs201_clk_provider,
 				gs201_g3d_hwacg_vclks,
 				ARRAY_SIZE(gs201_g3d_hwacg_vclks));
+
+	samsung_register_vclk(gs201_clk_provider,
+			      gs201_g3d_dvfs_vclks,
+			      ARRAY_SIZE(gs201_g3d_dvfs_vclks));
 	samsung_register_vclk(gs201_clk_provider,
 				gs201_dpu_hwacg_vclks,
 				ARRAY_SIZE(gs201_dpu_hwacg_vclks));
